/*
    instant_rdv_common.ush
    RDV: Raster Derived Voxel.
    BBV: Bitmask Brick Voxel.
    VSP: Visible Surface Probe.
*/

#if !defined(INSTANT_RDV_COMMON_USH)
#define INSTANT_RDV_COMMON_USH

// BbvのBrickの解像度. 8固定の8bit bitmask Voxel Brickとして扱う.
#define k_irdv_bbv_brick_reso 8u

// BbvのBrickの1辺のセル数. 4固定.
#define k_irdv_bbv_brick_data_u32_count 4u

// Bbv Brickあたりの追加属性データのU32数. 4固定.
#define k_irdv_bbv_brick_optional_data_u32_count 4u

// Bbv BrickのBitmask表現で必要なu32数.
#define k_irdv_bbv_bitmask_u32_count_per_brick ((k_irdv_bbv_brick_reso * k_irdv_bbv_brick_reso * k_irdv_bbv_brick_reso) / 32u)

#define k_irdv_bbv_radiance_accum_component_count 4u


// VSP無効probe index.
#define k_irdv_vsp_invalid_probe_index 0xffffffffu

// VSP probeあたりのOctahedralMap Atlas解像度.
#define k_irdv_vsp_probe_octmap_width 6u
// Material評価を含むVSP Cascade走査の上限。現行実装は5 Cascadeまでを対象とする。
#define k_irdv_vsp_max_cascade_count 5u
// VSP レイトレース結果格納バッファのエレメント単位のu32数.
#define k_irdv_vsp_ray_result_data_stride 2u

// VSP IrradianceVolumeはSkyVisibilityとIrradiance RGBを4つの3Dサブボリュームへ格納する。
// 各RGBAはL1 SHの4係数(Y00, Y1-1, Y10, Y1+1)に対応する。
#define k_irdv_vsp_irradiance_volume_sh_texture_count 4u
#define k_irdv_vsp_irradiance_volume_sky_visibility_texture_index 0u
#define k_irdv_vsp_irradiance_volume_irradiance_r_texture_index 1u
#define k_irdv_vsp_irradiance_volume_irradiance_g_texture_index 2u
#define k_irdv_vsp_irradiance_volume_irradiance_b_texture_index 3u
// Toroidal境界のハードウェアTrilinear補間用に、各サブボリュームの正側へTexelを1層追加する。
#define k_irdv_vsp_irradiance_volume_guard_texel_count 1u

// MainView ReducedSurfaceBufferの空間縮小率。4x4のJitter sampleを巡回する。
#define k_irdv_reduced_surface_buffer_downscale 4u

// VSP CellのVisibleMark用一時バッファの1Cellあたりのu32数.


// Vspのレイリクエスト, レイトレースのCSのスレッドグループサイズ.
#define k_irdv_vsp_ray_linear_thread_group_size 128u
// VspのProbe更新のCSのスレッドグループサイズ.
#define k_irdv_vsp_probe_update_thread_group_size 64u


// ProbePool Elementのu32換算個数 == (sizeof(FInstantRdvVspProbePoolData)/sizeof(uint)).
#define k_irdv_vsp_probe_pool_data_u32_count 8u
#if !defined(__cplusplus)
// VSP ActiveProbe lifecycle用のprobe poolエントリ.
// C++側のStructuredBufferはByteAddressBufferとしてk_irdv_vsp_probe_pool_data_u32_countエントリで確保されるため,
// k_irdv_vsp_probe_pool_data_u32_countとメンバ数==構造体サイズが一致するようにします.
// 
struct FInstantRdvVspProbePoolData
{
    uint OwnerCellIndex;
    uint ProbeOffsetV3;
    uint LastSeenFrame;
    uint Reserved0;
    uint LastUpdateFrame;
    uint Reserved1;
    uint Reserved2;
    uint Reserved3;
};
#endif

#endif // INSTANT_RDV_COMMON_USH
