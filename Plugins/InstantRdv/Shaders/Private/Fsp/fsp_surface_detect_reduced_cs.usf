// ファイル名: fsp_surface_detect_reduced_cs.usf
// ReducedSurfaceBufferからFSPの可視セルと、対応する元テクセルを抽出する。

#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Fsp/fsp_state.ush"

Texture2D<float4> ReducedSurfaceBuffer;
RWStructuredBuffer<uint> RWFspSurfaceCellMask;
RWStructuredBuffer<uint> RWFspVisibleSurfaceList;
RWStructuredBuffer<uint> RWFspVisibleSurfaceSourceTexelList;

uint SourceDepthSizeX;
uint SourceDepthSizeY;
uint FrameCount;
uint VisibleSurfaceListCapacity;
float4x4 ViewMatrix;
float4x4 InvViewMatrix;
float4x4 InvProjectionMatrix;
float4x4 ProjectionMatrix;

void AppendSurfaceCell(uint GlobalCellIndex, uint ReducedSurfaceTexelIndex)
{
    if (GlobalCellIndex >= FspTotalCellCount())
    {
        return;
    }

    const uint MaskWordIndex = GlobalCellIndex >> 5u;
    const uint MaskBit = 1u << (GlobalCellIndex & 31u);
    uint PreviousMask = 0u;
    InterlockedOr(
        RWFspSurfaceCellMask[MaskWordIndex],
        MaskBit,
        PreviousMask);
    if ((PreviousMask & MaskBit) != 0u)
    {
        return;
    }

    uint ListIndex = 0u;
    InterlockedAdd(RWFspVisibleSurfaceList[0], 1u, ListIndex);
    if (ListIndex < VisibleSurfaceListCapacity)
    {
        RWFspVisibleSurfaceList[ListIndex + 1u] = GlobalCellIndex;
        RWFspVisibleSurfaceSourceTexelList[ListIndex + 1u] =
            ReducedSurfaceTexelIndex;
    }
    // 超過予約は書かず、消費側で容量に制限する。
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint Width = 0u;
    uint Height = 0u;
    ReducedSurfaceBuffer.GetDimensions(Width, Height);
    if (any(DispatchThreadId.xy >= uint2(Width, Height)))
    {
        return;
    }

    const float4 SurfaceSample =
        ReducedSurfaceBuffer.Load(int3(DispatchThreadId.xy, 0));
    if (SurfaceSample.x <= 0.0)
    {
        return;
    }

    const uint2 SourceTexel = ReducedSurfaceBufferSourceTexel(
        DispatchThreadId.xy,
        uint2(SourceDepthSizeX, SourceDepthSizeY),
        FrameCount);
    const float2 SourceUv =
        (float2(SourceTexel) + 0.5.xx) /
        float2(max(SourceDepthSizeX, 1u), max(SourceDepthSizeY, 1u));
    const float3 SurfacePosVs = ReducedSurfaceReconstructViewPosition(
        SourceUv,
        SurfaceSample.x,
        InvProjectionMatrix);
    const float3 SurfacePosWs = mul(
        float4(SurfacePosVs, 1.0),
        InvViewMatrix).xyz;

    uint2 OwnerCellIndices = k_irdv_fsp_invalid_probe_index.xx;
    const uint OwnerCellCount =
        FspGetSurfaceOwnerCells(SurfacePosWs, OwnerCellIndices);
    const uint ReducedSurfaceTexelIndex =
        DispatchThreadId.x + DispatchThreadId.y * Width;
    [unroll]
    for (uint OwnerIndex = 0u; OwnerIndex < 2u; ++OwnerIndex)
    {
        if (OwnerIndex < OwnerCellCount)
        {
            AppendSurfaceCell(
                OwnerCellIndices[OwnerIndex],
                ReducedSurfaceTexelIndex);
        }
    }
}
