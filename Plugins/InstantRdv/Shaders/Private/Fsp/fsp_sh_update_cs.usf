// ファイル名: fsp_sh_update_cs.usf
// FSP: ActiveProbeのOctMapからIrradianceVolumeのSHを更新する。
// 参照InstantRDVと同じく、ActiveProbeの6x6 oct atlasをL1 SHへ積分し、owner cellのdense SHへ格納する。
// SHの各係数は float4(sky visibility, radiance.r, radiance.g, radiance.b) を保持する。

#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/Fsp/fsp_state.ush"

StructuredBuffer<uint> FspActiveProbeListCurr;
StructuredBuffer<uint> FspProbePool;
Texture2D<float4> FspProbeAtlas;
RWTexture3D<float4> RWFspIrradianceVolumeSHTexture;

uint FspProbePoolElementCount;
uint FrameCount;

[numthreads(64,1,1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ActiveIndex = DispatchThreadId.x;
    const uint ActiveProbeCount = min(
        FspActiveProbeListCurr[
            FspActiveProbeCurrentCounterSlot(FrameCount)],
        FspProbePoolElementCount);
    if (ActiveIndex >= ActiveProbeCount)
    {
        return;
    }

    const uint ProbeIndex = FspActiveProbeListCurr[FspActiveProbeListAddress(ActiveIndex)];
    if (ProbeIndex >= FspProbePoolElementCount)
    {
        return;
    }

    const FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(FspProbePool, ProbeIndex);
    if (Data.OwnerCellIndex == k_irdv_fsp_invalid_probe_index || Data.OwnerCellIndex >= FspTotalCellCount())
    {
        return;
    }

    float4 Coeff0 = 0.0.xxxx;
    float4 Coeff1 = 0.0.xxxx;
    float4 Coeff2 = 0.0.xxxx;
    float4 Coeff3 = 0.0.xxxx;

    [unroll]
    for (uint Oy = 0u; Oy < k_irdv_fsp_probe_octmap_width; ++Oy)
    {
        [unroll]
        for (uint Ox = 0u; Ox < k_irdv_fsp_probe_octmap_width; ++Ox)
        {
            const float4 ProbeValue = FspProbeAtlas.Load(int3(FspProbeAtlasAddress(ProbeIndex, uint2(Ox, Oy)), 0));
            // Atlasは resolve passで float4(radiance.rgb, sky visibility) として保存しているため、
            // SH側では参照実装のpayload順に合わせて sky を先頭componentへ移す。
            const float4 PackedSample = float4(ProbeValue.a, ProbeValue.rgb);
            const float2 OctUv = (float2(Ox, Oy) + 0.5.xx) / float(k_irdv_fsp_probe_octmap_width);
            const float4 Basis = FspEvaluateL1ShBasis(FspOctDecode(OctUv));
            Coeff0 += PackedSample * Basis.x;
            Coeff1 += PackedSample * Basis.y;
            Coeff2 += PackedSample * Basis.z;
            Coeff3 += PackedSample * Basis.w;
        }
    }

    const float SolidAngle = (4.0 * 3.14159265359) / float(kFspRayCountPerProbe);
    Coeff0 *= SolidAngle;
    Coeff1 *= SolidAngle;
    Coeff2 *= SolidAngle;
    Coeff3 *= SolidAngle;
    // RGBは書き込み時にLambertのclamped-cosineを畳み込み、マテリアル評価を軽くする。
    const float4 SkyVisibility = float4(Coeff0.r, Coeff1.r, Coeff2.r, Coeff3.r);
    const float4 IrradianceR = FspUtilConvolveL1SHByClampedCosine(float4(Coeff0.g, Coeff1.g, Coeff2.g, Coeff3.g));
    const float4 IrradianceG = FspUtilConvolveL1SHByClampedCosine(float4(Coeff0.b, Coeff1.b, Coeff2.b, Coeff3.b));
    const float4 IrradianceB = FspUtilConvolveL1SHByClampedCosine(float4(Coeff0.a, Coeff1.a, Coeff2.a, Coeff3.a));
    FspStoreIrradianceVolumeSignals(
        RWFspIrradianceVolumeSHTexture,
        Data.OwnerCellIndex,
        SkyVisibility,
        IrradianceR,
        IrradianceG,
        IrradianceB);
}
