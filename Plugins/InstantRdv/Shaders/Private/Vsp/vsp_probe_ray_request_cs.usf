// ファイル名: vsp_probe_ray_request_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Vsp/vsp_state.ush"

// ActiveProbeごとにOctMap 6x6方向のray requestを生成する。
// Requestは probe index と oct cell index を1wordへpackし、後続のtrace/resolveをcounter-drivenにする。

StructuredBuffer<uint> VspActiveProbeListCurr;
RWStructuredBuffer<uint> RWVspProbeRayRequestBuffer;

uint VspProbePoolElementCount;
uint FrameCount;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ActiveIndex = DispatchThreadId.x;
    const uint ActiveProbeCount = min(
        VspActiveProbeListCurr[
            VspActiveProbeCurrentCounterSlot(FrameCount)],
        VspProbePoolElementCount);
    if (ActiveIndex >= ActiveProbeCount)
    {
        return;
    }

    const uint ProbeIndex = VspActiveProbeListCurr[VspActiveProbeListAddress(ActiveIndex)];
    if (ProbeIndex >= VspProbePoolElementCount)
    {
        return;
    }

    [unroll]
    for (uint OctCellIndex = 0u; OctCellIndex < kVspRayCountPerProbe; ++OctCellIndex)
    {
        // Wave内の出力対象をprefix sumで詰め、共有appendカウンタへのAtomicを
        // laneごとの実行から1 Waveあたり1回へ集約する。将来、probe単位または
        // oct cell単位で方向を間引く場合も、ここではemit条件だけを変更すればよい。
        const bool bEmitRequest = ProbeIndex < VspProbePoolElementCount;
        const uint WaveEmitCount = WaveActiveCountBits(bEmitRequest);
        if (WaveEmitCount == 0u)
        {
            continue;
        }

        const uint WaveEmitPrefix = WavePrefixCountBits(bEmitRequest);
        uint WaveBaseIndex = 0u;
        if (WaveIsFirstLane())
        {
            InterlockedAdd(RWVspProbeRayRequestBuffer[0], WaveEmitCount, WaveBaseIndex);
        }
        WaveBaseIndex = WaveReadLaneFirst(WaveBaseIndex);

        if (bEmitRequest)
        {
            const uint RequestIndex = WaveBaseIndex + WaveEmitPrefix;
            RWVspProbeRayRequestBuffer[RequestIndex + 1u] =
                VspPackRayRequestKey(ProbeIndex, OctCellIndex);
        }
    }
}
