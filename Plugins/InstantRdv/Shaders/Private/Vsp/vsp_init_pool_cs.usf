// ファイル名: vsp_init_pool_cs.usf
// VSP probe pool / free stack 初期化シェーダ。
// Probe容量とDenseセル数を分離し、有限poolからfree stack経由で割り当てる。
// CellProbeIndexはcell -> probe ownership、ProbePoolはprobe -> owner/offset/frame情報を保持する。
#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/Vsp/vsp_state.ush"

RWStructuredBuffer<uint> RWVspProbeFreeStack; // [0] = count, [1..N] = free indices
RWStructuredBuffer<uint> RWVspCellProbeIndex;
RWStructuredBuffer<uint> RWVspProbePool;
RWTexture3D<float4> RWVspIrradianceVolumeSHTexture;
uint ProbePoolElementCount;
uint TotalCellCount;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint idx = DispatchThreadId.x;
    if (idx < TotalCellCount)
    {
        RWVspCellProbeIndex[idx] = k_irdv_vsp_invalid_probe_index;
        VspStoreIrradianceVolumePackedCoefficients(
            RWVspIrradianceVolumeSHTexture,
            idx,
            0.0.xxxx,
            0.0.xxxx,
            0.0.xxxx,
            0.0.xxxx);
    }
    if (idx >= ProbePoolElementCount)
    {
        return;
    }

    // LIFO になるように逆順で格納する。初回popが0番probeになり、debug時の対応を追いやすい。
    RWVspProbeFreeStack[1 + idx] = ProbePoolElementCount - 1u - idx;
    FInstantRdvVspProbePoolData Data;
    Data.OwnerCellIndex = k_irdv_vsp_invalid_probe_index;
    Data.ProbeOffsetV3 = 0u;
    Data.LastSeenFrame = 0u;
    Data.Reserved0 = 0u;
    Data.LastUpdateFrame = 0u;
    Data.Reserved1 = 0u;
    Data.Reserved2 = 0u;
    Data.Reserved3 = 0u;
    VspStoreProbePoolData(RWVspProbePool, idx, Data);

    // thread 0がcountを設定する。次passからの参照はRDGの依存で保証する。
    if (idx == 0u)
    {
        RWVspProbeFreeStack[0] = ProbePoolElementCount;
    }
}
