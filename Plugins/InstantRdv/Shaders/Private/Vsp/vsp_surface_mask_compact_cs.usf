// 1bit/cellのSurface maskを、[0]=count, [1..]=global cell indexのlistへcompactする。
// Native InstantRDVと同じく、append reservationは非ゼロmask wordごとに1回だけ行う。

#include "/Engine/Public/Platform.ush"

StructuredBuffer<uint> VspSurfaceCellMask;
RWStructuredBuffer<uint> RWVspVisibleSurfaceList;

uint VspTotalCellCount;
uint VspVisibleSurfaceListCapacity;

[numthreads(128, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint MaskWordCount = (VspTotalCellCount + 31u) / 32u;
    const uint MaskWordIndex = DispatchThreadId.x;
    if (MaskWordIndex >= MaskWordCount)
    {
        return;
    }

    const uint MaskBits = VspSurfaceCellMask[MaskWordIndex];
    if (MaskBits == 0u)
    {
        return;
    }

    const uint BitCount = countbits(MaskBits);
    uint AppendBaseIndex = 0u;
    InterlockedAdd(RWVspVisibleSurfaceList[0], BitCount, AppendBaseIndex);

    uint WritableCount = 0u;
    if (AppendBaseIndex < VspVisibleSurfaceListCapacity)
    {
        WritableCount = min(BitCount, VspVisibleSurfaceListCapacity - AppendBaseIndex);
    }
    // 予約countは単調増加。消費側は容量で制限し、予約領域を再利用しない。

    uint RemainingBits = MaskBits;
    uint LocalRank = 0u;
    while (RemainingBits != 0u)
    {
        const uint BitIndex = firstbitlow(RemainingBits);
        RemainingBits &= RemainingBits - 1u;
        const uint GlobalCellIndex = MaskWordIndex * 32u + BitIndex;
        if (GlobalCellIndex < VspTotalCellCount && LocalRank < WritableCount)
        {
            RWVspVisibleSurfaceList[AppendBaseIndex + LocalRank + 1u] = GlobalCellIndex;
        }
        ++LocalRank;
    }
}
