// ファイル名: vsp_irradiance_volume_propagate_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Vsp/vsp_state.ush"

// ActiveProbeが直接更新しないIrradianceVolume cellへ、近傍cellのSHを伝播する。
// Checkerboard更新にして、毎フレームの全cell書き換えと隣接cell同時更新のフィードバックを抑える。

StructuredBuffer<uint> VspCellProbeIndex;
StructuredBuffer<uint> VspProbePool;
RWTexture3D<float4> RWVspIrradianceVolumeSHTexture;

uint VspProbePoolElementCount;
uint FrameCount;

bool VspIsActiveProbeOwnedCell(uint CellIndex)
{
    if (CellIndex >= VspTotalCellCount())
    {
        return false;
    }

    const uint ProbeIndex = VspCellProbeIndex[CellIndex];
    if (ProbeIndex == k_irdv_vsp_invalid_probe_index || ProbeIndex >= VspProbePoolElementCount)
    {
        return false;
    }

    const FInstantRdvVspProbePoolData Data = VspLoadProbePoolData(VspProbePool, ProbeIndex);
    return Data.OwnerCellIndex == CellIndex;
}

bool VspTryLoadNeighborSH(
    out float4 C0,
    out float4 C1,
    out float4 C2,
    out float4 C3,
    int3 Coord,
    int3 ToroidalOffset,
    uint3 GridResolution,
    uint CascadeCellBase)
{
    C0 = 0.0.xxxx;
    C1 = 0.0.xxxx;
    C2 = 0.0.xxxx;
    C3 = 0.0.xxxx;
    if (any(Coord < 0) ||
        Coord.x >= int(GridResolution.x) ||
        Coord.y >= int(GridResolution.y) ||
        Coord.z >= int(GridResolution.z))
    {
        return false;
    }

    // Coordは論理座標なので、dense bufferのglobal cell indexへ戻す前にtoroidal物理座標へ変換する。
    const uint3 PhysicalCoord = LogicalToPhysicalGridCoord(
        Coord,
        ToroidalOffset,
        GridResolution);
    const uint LocalCellIndex = FlattenGridCoord(PhysicalCoord, GridResolution);
    const uint CellIndex = CascadeCellBase + LocalCellIndex;
    VspLoadIrradianceVolumePackedCoefficientsRw(
        RWVspIrradianceVolumeSHTexture,
        CellIndex,
        C0,
        C1,
        C2,
        C3);
    return any(abs(C0) > 0.0.xxxx) || any(abs(C1) > 0.0.xxxx) || any(abs(C2) > 0.0.xxxx) || any(abs(C3) > 0.0.xxxx);
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint CellIndex = DispatchThreadId.x;
    if (CellIndex >= VspTotalCellCount() || VspIsActiveProbeOwnedCell(CellIndex))
    {
        return;
    }

    uint CascadeIndex = 0u;
    uint LocalCellIndex = 0u;
    if (!VspDecodeGlobalCellIndex(CellIndex, CascadeIndex, LocalCellIndex))
    {
        return;
    }

    const int3 Coord = VspPhysicalToLinearCoord(VspLocalCellIndexToCoord(LocalCellIndex), CascadeIndex);
    const uint Parity = uint((Coord.x + Coord.y + Coord.z) & 1);
    // 偶奇cellを交互に更新することで、同一frame内に伝播結果をさらに伝播する連鎖を弱める。
    if (Parity != (FrameCount & 1u))
    {
        return;
    }

    const int3 Offsets[6] =
    {
        int3( 1,  0,  0),
        int3(-1,  0,  0),
        int3( 0,  1,  0),
        int3( 0, -1,  0),
        int3( 0,  0,  1),
        int3( 0,  0, -1)
    };

    float4 Accum0 = 0.0.xxxx;
    float4 Accum1 = 0.0.xxxx;
    float4 Accum2 = 0.0.xxxx;
    float4 Accum3 = 0.0.xxxx;
    uint Count = 0u;
    const uint3 GridResolution = uint3(
        VspGridResolutionX,
        VspGridResolutionY,
        VspGridResolutionZ);
    const int3 ToroidalOffset = VspCascadeToroidalOffset(CascadeIndex);
    const uint CascadeCellBase = CascadeIndex * VspCellCountPerCascade();
    [unroll]
    for (uint I = 0u; I < 6u; ++I)
    {
        float4 C0, C1, C2, C3;
        if (VspTryLoadNeighborSH(
            C0,
            C1,
            C2,
            C3,
            Coord + Offsets[I],
            ToroidalOffset,
            GridResolution,
            CascadeCellBase))
        {
            Accum0 += C0;
            Accum1 += C1;
            Accum2 += C2;
            Accum3 += C3;
            ++Count;
        }
    }

    if (Count == 0u)
    {
        return;
    }

    const float InvCount = rcp(float(Count));
    VspStoreIrradianceVolumePackedCoefficients(
        RWVspIrradianceVolumeSHTexture,
        CellIndex,
        Accum0 * InvCount,
        Accum1 * InvCount,
        Accum2 * InvCount,
        Accum3 * InvCount);
}
