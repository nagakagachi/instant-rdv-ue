// ファイル名: vsp_probe_billboard.usf
// VSP ActiveProbe / IrradianceVolumeのプローブ球デバッグ描画。
// 各VSP cellを1インスタンス相当のcamera-facing quadとして描き、pixel shaderで球面に見せる。
// ActiveProbe debugではCVarに応じて cell center / offset probe sample position を切り替え、
// IrradianceVolume debugでは常にcell centerを描画する。

#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Vsp/vsp_state.ush"
#include "/InstantRdvShaders/Private/bbv_trace_util.ush"

float4x4 ViewMatrix;
float4x4 ViewProjectionMatrix;
float3 CameraRightWs;
float3 CameraUpWs;
float3 CameraPositionWs;
float DebugProbeRadiusCm;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
uint VspProbePoolElementCount;
uint FrameCount;
uint DebugMode;
uint bUseProbeVisualizationOffset;
uint bUseProbeTraceOffset;
uint BbvGridResolutionX;
uint BbvGridResolutionY;
uint BbvGridResolutionZ;
float3 BbvToroidalOffsetCells;
float BbvCellSizeCm;
float3 BbvGridMinPositionWs;

StructuredBuffer<uint> VspCellProbeIndex;
StructuredBuffer<uint> VspProbePool;
Texture2D<float4> VspProbeAtlas;
Texture3D<float4> VspIrradianceVolumeSHTexture;
StructuredBuffer<uint> BbvBuffer;
uint BrickDataBaseOffset;

struct VS_OUTPUT
{
    float4 Pos : SV_Position;
    float2 UV : TEXCOORD0;
    float3 ProbePosWs : TEXCOORD1;
    nointerpolation uint GlobalCellIndex : TEXCOORD2;
    nointerpolation uint ProbeIndex : TEXCOORD3;
    nointerpolation uint ProbeFlags : TEXCOORD4;
    float3 ProbeSamplePosWs : TEXCOORD5;
    float3 RelocatedProbeSamplePosWs : TEXCOORD6;
};

bool VspTryGetActiveProbeForCell(out uint OutProbeIndex, out FInstantRdvVspProbePoolData OutData, uint GlobalCellIndex)
{
    OutProbeIndex = k_irdv_vsp_invalid_probe_index;
    OutData = (FInstantRdvVspProbePoolData)0;
    if (GlobalCellIndex >= VspTotalCellCount())
    {
        return false;
    }

    const uint ProbeIndex = VspCellProbeIndex[GlobalCellIndex];
    if (ProbeIndex == k_irdv_vsp_invalid_probe_index || ProbeIndex >= VspProbePoolElementCount)
    {
        return false;
    }

    // CellProbeIndexだけでは古いownershipが残る可能性があるため、ProbePool側のOwnerCellIndexでも検証する。
    const FInstantRdvVspProbePoolData Data = VspLoadProbePoolData(VspProbePool, ProbeIndex);
    if (Data.OwnerCellIndex != GlobalCellIndex)
    {
        return false;
    }

    OutProbeIndex = ProbeIndex;
    OutData = Data;
    return true;
}

VS_OUTPUT MainVS(uint VertexId : SV_VertexID)
{
    const float2 QuadPos[6] =
    {
        float2(-1.0, -1.0),
        float2(-1.0,  1.0),
        float2( 1.0,  1.0),
        float2(-1.0, -1.0),
        float2( 1.0,  1.0),
        float2( 1.0, -1.0)
    };
    const float2 QuadUv[6] =
    {
        float2(0.0, 1.0),
        float2(0.0, 0.0),
        float2(1.0, 0.0),
        float2(0.0, 1.0),
        float2(1.0, 0.0),
        float2(1.0, 1.0)
    };

    VS_OUTPUT Out = (VS_OUTPUT)0;
    const uint GlobalCellIndex = VertexId / 6u;
    const uint LocalVertexIndex = VertexId % 6u;

    uint CascadeIndex = 0u;
    uint LocalCellIndex = 0u;
    if (!VspDecodeGlobalCellIndex(GlobalCellIndex, CascadeIndex, LocalCellIndex))
    {
        Out.Pos = 0.0.xxxx;
        Out.ProbeIndex = k_irdv_vsp_invalid_probe_index;
        return Out;
    }

    uint ProbeIndex = k_irdv_vsp_invalid_probe_index;
    FInstantRdvVspProbePoolData ProbeData = (FInstantRdvVspProbePoolData)0;
    const bool bActiveProbe = VspTryGetActiveProbeForCell(ProbeIndex, ProbeData, GlobalCellIndex);
    const bool bIrradianceVolumeDebug = DebugMode == 9u || DebugMode == 10u;
    const bool bHasVolumeSH = VspIrradianceVolumeHasValidSH(VspIrradianceVolumeSHTexture, GlobalCellIndex);
    // VspCalcCellCenterWsはtoroidal物理indexから現在のworld-aligned cell centerへ戻す。
    // ここがずれるとprobe球がカメラ追従に見えるため、更新パスと同じhelperを使う。
    const float3 CellCenterWs = VspCalcCellCenterWs(CascadeIndex, LocalCellIndex);
    // ProbeOffset は VSP の本質的な relocation 結果。
    // Debug球も trace も同じ encoded offset を読むことで、
    // 「どこにprobeが置かれ、どこからrayが飛ぶか」を同じ基準で観察できる。
    const float3 ProbeOffset = bActiveProbe ? VspDecodeProbeOffset(ProbeData.ProbeOffsetV3) * VspProbeMaxOffsetDistanceCm(CascadeIndex) : 0.0.xxx;
    const float3 ProbeSamplePosWs = CellCenterWs + ProbeOffset;
    const float3 ProbePosWs = bIrradianceVolumeDebug
        ? CellCenterWs
        : (CellCenterWs + ((bUseProbeVisualizationOffset != 0u) ? ProbeOffset : 0.0.xxx));
    const float DrawScale = ((bIrradianceVolumeDebug && bHasVolumeSH) || ((!bIrradianceVolumeDebug) && bActiveProbe)) ? DebugProbeRadiusCm : 0.0;
    const float2 Corner = QuadPos[LocalVertexIndex];
    const float3 VertexPosWs = ProbePosWs + (CameraRightWs * Corner.x + CameraUpWs * Corner.y) * DrawScale;

    Out.Pos = mul(float4(VertexPosWs, 1.0), ViewProjectionMatrix);
    Out.UV = QuadUv[LocalVertexIndex];
    Out.ProbePosWs = ProbePosWs;
    Out.GlobalCellIndex = GlobalCellIndex;
    Out.ProbeIndex = ProbeIndex;
    Out.ProbeFlags = bActiveProbe ? 1u : 0u;
    // DebugMode 9 は現在のtrace origin設定そのものを診断する用途なので、
    // TraceUseProbeOffset=0 の場合はcell center、1 の場合はoffset sample positionを判定対象にする。
    Out.ProbeSamplePosWs = (bUseProbeTraceOffset != 0u) ? ProbeSamplePosWs : CellCenterWs;
    Out.RelocatedProbeSamplePosWs = ProbeSamplePosWs;
    return Out;
}

float4 MainPS(VS_OUTPUT Input) : SV_Target0
{
    const float2 UnitDist = (Input.UV - 0.5.xx) * float2(2.0, -2.0);
    const float UnitDistLenSq = dot(UnitDist, UnitDist);
    if (UnitDistLenSq > 1.0)
    {
        discard;
    }

    const bool bIrradianceVolumeDebug = DebugMode == 9u || DebugMode == 10u;
    if ((!bIrradianceVolumeDebug) && Input.ProbeIndex == k_irdv_vsp_invalid_probe_index)
    {
        discard;
    }

    const float3 DirToCamera = normalize(CameraPositionWs - Input.ProbePosWs);
    const float3 QuadSide = normalize(cross(CameraUpWs, -DirToCamera));
    const float3 QuadUp = normalize(cross(-DirToCamera, QuadSide));
    float3 NormalWs = float3(UnitDist.x, UnitDist.y, sqrt(saturate(1.0 - UnitDistLenSq)));
    NormalWs = normalize(NormalWs.x * QuadSide + NormalWs.y * QuadUp + NormalWs.z * DirToCamera);

    const uint CellIndex = Input.GlobalCellIndex;

    float4 Color = float4(NormalWs * 0.5 + 0.5, 1.0);
    if (DebugMode == 0u)
    {
        const FInstantRdvVspProbePoolData Data = VspLoadProbePoolData(VspProbePool, Input.ProbeIndex);
        Color = (Data.LastSeenFrame == FrameCount) ? float4(0.2, 1.0, 0.3, 1.0) : float4(1.0, 0.85, 0.2, 1.0);
    }
    else if (DebugMode == 1u)
    {
        const float H = frac(float(Input.ProbeIndex) * 0.61803398875);
        Color = float4(H, frac(H * 1.37), frac(H * 2.11), 1.0);
    }
    else if (DebugMode == 2u)
    {
        const FInstantRdvVspProbePoolData Data = VspLoadProbePoolData(VspProbePool, Input.ProbeIndex);
        const float AgeNorm = saturate(float(FrameCount - Data.LastSeenFrame) / 30.0);
        Color = lerp(float4(0.2, 1.0, 0.3, 1.0), float4(1.0, 0.2, 0.1, 1.0), AgeNorm);
    }
    else if (DebugMode == 3u)
    {
        uint CascadeIndex = 0u;
        uint LocalCellIndex = 0u;
        VspDecodeGlobalCellIndex(CellIndex, CascadeIndex, LocalCellIndex);
        const float H = frac(float(CascadeIndex) * 0.38196601125);
        Color = float4(H, frac(H * 1.71), frac(H * 2.37), 1.0);
    }
    else if (DebugMode == 4u || DebugMode == 5u)
    {
        // OctMap表示は球面normalをoct encodeしてatlas texelを参照する。
        // DebugModeは4がRadiance、5がSkyVisibility。
        const uint2 OctCellId = min(uint2(VspOctEncode(NormalWs) * float(k_irdv_vsp_probe_octmap_width)), uint2(k_irdv_vsp_probe_octmap_width - 1u, k_irdv_vsp_probe_octmap_width - 1u));
        const float4 Atlas = VspProbeAtlas.Load(int3(VspProbeAtlasAddress(Input.ProbeIndex, OctCellId), 0));
        if (DebugMode == 4u)
        {
            const float3 Mapped = Atlas.rgb / (1.0.xxx + Atlas.rgb);
            Color = float4(pow(max(Mapped, 0.0.xxx), 1.0 / 2.2), 1.0);
        }
        else
        {
            const float SkyVis = Atlas.a;
            Color = float4(max(float3(SkyVis, SkyVis, SkyVis), float3(0.04, 0.04, 0.04)), 1.0);
        }
    }
    else if (DebugMode == 6u || DebugMode == 9u)
    {
        // デバッグ表示では、格納された入射Radiance SHの指定方向評価をそのまま表示する。
        // ライティング用のDiffuse Irradiance評価（Cos畳み込み済み）とは意図的に分けている。
        const float3 Radiance = VspUtilEvaluateIrradianceVolumeRadianceAtCell(
            VspIrradianceVolumeSHTexture,
            VspGetGridParams(),
            CellIndex,
            NormalWs);
        const float3 Mapped = Radiance / (1.0.xxx + Radiance);
        Color = float4(pow(Mapped, 1.0 / 2.2), 1.0);
    }
    else if (DebugMode == 8u)
    {
        // Probe ray traceの始点そのものがBBV occupied voxelに埋まっているかを可視化する。
        // 自己ヒット調査では「free / embedded / BBV範囲外」を切り分けることが重要なので、3値で色分けする。
        bool bEmbeddedInBbv = false;
        const bool bInsideBbv = BbvTryGetProbeOccupancyAtWorldPos(
            BbvBuffer,
            BrickDataBaseOffset,
            Input.ProbeSamplePosWs,
            BbvGridMinPositionWs,
            BbvCellSizeCm,
            uint3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ),
            int3(BbvToroidalOffsetCells),
            bEmbeddedInBbv);
        Color = !bInsideBbv
            ? float4(0.2, 0.5, 1.0, 1.0)
            : (bEmbeddedInBbv ? float4(1.0, 0.15, 0.1, 1.0) : float4(0.2, 1.0, 0.3, 1.0));
    }
    else if (DebugMode == 11u)
    {
        // Relocation済みProbeまでの有限線分を追跡し、BBV遮蔽の有無を表示する。
        const float3 Segment = Input.RelocatedProbeSamplePosWs - CameraPositionWs;
        const float SegmentLength = length(Segment);
        const float3 SegmentDirection = (SegmentLength > 1e-4) ? Segment / SegmentLength : float3(0.0, 0.0, 1.0);
        const bool bTargetInsideBbv = all(Input.RelocatedProbeSamplePosWs >= BbvGridMinPositionWs) &&
            all(Input.RelocatedProbeSamplePosWs < (BbvGridMinPositionWs + float3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ) * BbvCellSizeCm));
        float HitDistanceCm = -1.0;
        int3 HitBrickCoord = int3(-1, -1, -1);
        int3 HitFineCoord = int3(-1, -1, -1);
        uint HitBrickIndex = 0u;
        uint HitBitIndex = 0u;
        const bool bBlocked = bTargetInsideBbv && TraceBbvRayReference(
            BbvBuffer,
            BrickDataBaseOffset,
            CameraPositionWs,
            SegmentDirection,
            SegmentLength,
            false,
            uint3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ),
            BbvCellSizeCm,
            BbvGridMinPositionWs,
            int3(BbvToroidalOffsetCells),
            HitDistanceCm,
            HitBrickCoord,
            HitFineCoord,
            HitBrickIndex,
            HitBitIndex);
        Color = !bTargetInsideBbv
            ? float4(0.2, 0.5, 1.0, 1.0)
            : (bBlocked ? float4(1.0, 0.15, 0.1, 1.0) : float4(0.2, 1.0, 0.3, 1.0));
    }
    else if (DebugMode == 7u || DebugMode == 10u)
    {
        // デバッグ表示では、SkyVisibility SHの指定方向評価を表示する。
        // IBL可視性として使う場合は、正規化Cos畳み込み版のAPIを利用する。
        Color = VspUtilEvaluateIrradianceVolumeSkyVisibilityAtCell(
            VspIrradianceVolumeSHTexture,
            VspGetGridParams(),
            CellIndex,
            NormalWs).xxxx;
    }

    return Color;
}
