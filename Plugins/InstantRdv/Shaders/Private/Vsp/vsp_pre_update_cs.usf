// ファイル名: vsp_pre_update_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Vsp/vsp_state.ush"
#include "/InstantRdvShaders/Private/bbv_trace_util.ush"

// 参照InstantRDVのvsp_pre_update_cs相当。
// SurfaceMask Compactで得たvisible surface cellを処理し、未所有cellにはprobe poolからActiveProbeを割り当てる。
// 新規・既存を問わず、可視cellのprobe位置は選択中の入力方式で毎フレーム再評価する。
// そのためLegacy/ReducedSurfaceBufferを実行時に切り替えても、既存probeを破棄せず次の可視更新から再配置できる。

StructuredBuffer<uint> VspVisibleSurfaceList;
StructuredBuffer<uint> VspVisibleSurfaceSourceTexelList;
Texture2D<float4> ReducedSurfaceBuffer;
RWStructuredBuffer<uint> RWVspActiveProbeListCurr;
RWStructuredBuffer<uint> RWVspProbeFreeStack;
RWStructuredBuffer<uint> RWVspCellProbeIndex;
RWStructuredBuffer<uint> RWVspProbePool;
RWTexture2D<float4> RWVspProbeAtlas;
StructuredBuffer<uint> BbvBuffer;

uint VspProbePoolElementCount;
uint FrameCount;
uint bEnableWarmStart;
uint VisibleSurfaceListCapacity;
uint bUseReducedSurfaceBuffer;
uint SourceViewRectSizeX;
uint SourceViewRectSizeY;
float4x4 ViewMatrix;
float4x4 InvViewMatrix;
float4x4 InvProjectionMatrix;
float4x4 ProjectionMatrix;
float3 CameraPositionWs;
uint BbvGridResolutionX;
uint BbvGridResolutionY;
uint BbvGridResolutionZ;
float3 BbvGridMinPositionWs;
float BbvCellSizeCm;
float BbvOccupancyInjectionWorldOffsetCm;
float3 BbvToroidalOffsetCells;

bool VspTryGetReducedSurfaceAnchor(
    uint UpdateElementIndex,
    uint GlobalCellIndex,
    uint CascadeIndex,
    out float3 SurfacePositionWs,
    out float3 SurfaceNormalWs)
{
    SurfacePositionWs = 0.0.xxx;
    SurfaceNormalWs = 0.0.xxx;

    uint ReducedWidth = 0u;
    uint ReducedHeight = 0u;
    ReducedSurfaceBuffer.GetDimensions(ReducedWidth, ReducedHeight);
    if (ReducedWidth == 0u || ReducedHeight == 0u)
    {
        return false;
    }

    const uint ReducedSurfaceTexelIndex =
        VspVisibleSurfaceSourceTexelList[UpdateElementIndex + 1u];
    if (ReducedSurfaceTexelIndex >= ReducedWidth * ReducedHeight)
    {
        return false;
    }

    const uint2 ReducedTexel = uint2(
        ReducedSurfaceTexelIndex % ReducedWidth,
        ReducedSurfaceTexelIndex / ReducedWidth);
    const float4 SurfaceSample =
        ReducedSurfaceBuffer.Load(int3(ReducedTexel, 0));
    if (SurfaceSample.x <= 0.0)
    {
        return false;
    }

    const float2 SurfaceUv =
        (float2(ReducedSurfaceBufferSourceTexel(
            ReducedTexel,
            uint2(SourceViewRectSizeX, SourceViewRectSizeY),
            FrameCount)) + 0.5.xx) /
        float2(max(SourceViewRectSizeX, 1u), max(SourceViewRectSizeY, 1u));
    const float3 SurfacePositionVs =
        ReducedSurfaceReconstructViewPosition(
            SurfaceUv,
            SurfaceSample.x,
            InvProjectionMatrix);
    SurfacePositionWs = mul(
        float4(SurfacePositionVs, 1.0),
        InvViewMatrix).xyz;

    uint SampleGlobalCellIndex = k_irdv_vsp_invalid_probe_index;
    if (!VspTryGetGlobalCellIndexFromWorldPos(
            SurfacePositionWs,
            CascadeIndex,
            SampleGlobalCellIndex) ||
        SampleGlobalCellIndex != GlobalCellIndex)
    {
        return false;
    }

    SurfaceNormalWs = ReducedSurfaceOctDecode(SurfaceSample.yz);
    return true;
}

uint VspPopFreeProbeIndex()
{
    [loop]
    for (;;)
    {
        const uint ObservedCount = RWVspProbeFreeStack[0];
        if (ObservedCount == 0u)
        {
            return k_irdv_vsp_invalid_probe_index;
        }

        uint OldValue = 0u;
        InterlockedCompareExchange(RWVspProbeFreeStack[0], ObservedCount, ObservedCount - 1u, OldValue);
        if (OldValue == ObservedCount)
        {
            // CompareExchangeでcount更新に勝ったthreadだけが、このstack slotのprobeを取得できる。
            return RWVspProbeFreeStack[ObservedCount];
        }
    }
}

void VspPushCurrActiveProbeIndex(uint ProbeIndex)
{
    uint ActiveListIndex = 0u;
    InterlockedAdd(
        RWVspActiveProbeListCurr[
            VspActiveProbeCurrentCounterSlot(FrameCount)],
        1u,
        ActiveListIndex);
    if (ActiveListIndex < VspProbePoolElementCount)
    {
        RWVspActiveProbeListCurr[VspActiveProbeListAddress(ActiveListIndex)] = ProbeIndex;
    }
}

void VspCopyProbeAtlas(uint DstProbeIndex, uint SrcProbeIndex)
{
    [unroll]
    for (uint OctIndex = 0u; OctIndex < kVspRayCountPerProbe; ++OctIndex)
    {
        RWVspProbeAtlas[VspProbeAtlasAddress(DstProbeIndex, uint2(OctIndex % 6u, OctIndex / 6u))] =
            RWVspProbeAtlas[VspProbeAtlasAddress(SrcProbeIndex, uint2(OctIndex % 6u, OctIndex / 6u))];
    }
}

bool VspTryFindNearestWarmStartProbe(
    float3 SamplePositionWs,
    uint DstCascadeIndex,
    uint DstProbeIndex,
    out uint OutProbeIndex)
{
    OutProbeIndex = k_irdv_vsp_invalid_probe_index;
    const uint CascadeCount = VspEffectiveCascadeCount();
    float BestDistanceSq = 3.402823466e+38;
    [loop]
    for (uint CascadeOffset = 0u; CascadeOffset < CascadeCount - DstCascadeIndex; ++CascadeOffset)
    {
        const uint SrcCascadeIndex = DstCascadeIndex + CascadeOffset;
        const float CellSize = VspCascadeCellSizeCm(SrcCascadeIndex);
        const float3 GridMin = VspCascadeGridMinPositionWs(SrcCascadeIndex);
        const float3 ContinuousCoord = (SamplePositionWs - GridMin) / max(CellSize, 0.001) - 0.5.xxx;
        const int3 CenterCoord = int3(floor(ContinuousCoord));
        const int3 Resolution = int3(VspGridResolutionX, VspGridResolutionY, VspGridResolutionZ);

        [loop]
        for (int Z = -1; Z <= 1; ++Z)
        {
            for (int Y = -1; Y <= 1; ++Y)
            {
                for (int X = -1; X <= 1; ++X)
                {
                    const int3 LogicalCoord = CenterCoord + int3(X, Y, Z);
                    if (any(LogicalCoord < 0) || any(LogicalCoord >= Resolution))
                    {
                        continue;
                    }

                    const uint LocalCellIndex = VspPhysicalCellCoordToLocalIndex(
                        VspLinearToPhysicalCoord(LogicalCoord, SrcCascadeIndex));
                    const uint SrcGlobalCellIndex = VspEncodeGlobalCellIndex(
                        SrcCascadeIndex,
                        LocalCellIndex);
                    const uint SrcProbeIndex = RWVspCellProbeIndex[SrcGlobalCellIndex];
                    if (SrcProbeIndex == k_irdv_vsp_invalid_probe_index ||
                        SrcProbeIndex >= VspProbePoolElementCount ||
                        SrcProbeIndex == DstProbeIndex)
                    {
                        continue;
                    }

                    const FInstantRdvVspProbePoolData SrcData =
                        VspLoadProbePoolData(RWVspProbePool, SrcProbeIndex);
                    if (SrcData.OwnerCellIndex != SrcGlobalCellIndex ||
                        SrcData.LastUpdateFrame == 0u)
                    {
                        continue;
                    }

                    const float3 SourcePositionWs =
                        VspCalcCellCenterWs(SrcCascadeIndex, LocalCellIndex) +
                        VspDecodeProbeOffset(SrcData.ProbeOffsetV3) *
                        VspProbeMaxOffsetDistanceCm(SrcCascadeIndex);
                    const float3 Delta = SourcePositionWs - SamplePositionWs;
                    const float DistanceSq = dot(Delta, Delta);
                    if (DistanceSq < BestDistanceSq)
                    {
                        BestDistanceSq = DistanceSq;
                        OutProbeIndex = SrcProbeIndex;
                    }
                }
            }
        }

        if (OutProbeIndex != k_irdv_vsp_invalid_probe_index)
        {
            return true;
        }
    }
    return false;
}

bool VspTrySeedProbeFromNearestActiveProbe(
    float3 SamplePositionWs,
    uint DstCascadeIndex,
    uint DstProbeIndex)
{
    uint SrcProbeIndex = k_irdv_vsp_invalid_probe_index;
    if (VspTryFindNearestWarmStartProbe(
        SamplePositionWs,
        DstCascadeIndex,
        DstProbeIndex,
        SrcProbeIndex))
    {
        VspCopyProbeAtlas(DstProbeIndex, SrcProbeIndex);
        return true;
    }
    return false;
}

void VspClearProbeAtlas(uint ProbeIndex)
{
    [unroll]
    for (uint OctIndex = 0u; OctIndex < kVspRayCountPerProbe; ++OctIndex)
    {
        RWVspProbeAtlas[VspProbeAtlasAddress(ProbeIndex, uint2(OctIndex % 6u, OctIndex / 6u))] = 0.0.xxxx;
    }
}

uint VspNativeHashUint32Iq(uint2 Value)
{
    Value *= uint2(73333u, 7777u);
    Value ^= uint2(3333777777u, 3333777777u) >> (Value >> 28u);
    const uint Product = Value.x * Value.y;
    return Product ^ (Product >> 15u);
}

float VspNativeNoiseFloat2(float2 Value)
{
    return float(VspNativeHashUint32Iq(asuint(Value))) * 2.3283064365386962890625e-10;
}

bool VspIsProbePositionOccupied(float3 PositionWs)
{
    return BbvReadFineVoxelOccupancyAtWorldPos(
        BbvBuffer,
        PositionWs,
        BbvGridMinPositionWs,
        BbvCellSizeCm,
        uint3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ),
        int3(BbvToroidalOffsetCells));
}

float3 VspRelocateProbeNative(
    float3 CellCenterWs,
    float3 PreviousProbeOffset,
    float MaxProbeOffsetDistanceCm,
    uint CascadeIndex,
    uint GlobalCellIndex)
{
    const float3 ToCamera = CameraPositionWs - CellCenterWs;
    const float ToCameraLenSq = dot(ToCamera, ToCamera);
    const bool bHasSurfaceAnchor = ToCameraLenSq > 1.0e-6;
    float3 ProbeSamplePosWs = CellCenterWs + PreviousProbeOffset;
    bool bAcceptedVisibleFirst = false;
    if (bHasSurfaceAnchor)
    {
        const float3 DirectionToCamera = ToCamera * rsqrt(ToCameraLenSq);
        const float FrontSamples[6] = {0.95, 0.80, 0.65, 0.50, 0.35, 0.20};
        [unroll]
        for (uint SampleIndex = 0u; SampleIndex < 6u; ++SampleIndex)
        {
            const float3 CandidateWs =
                CellCenterWs +
                DirectionToCamera *
                (MaxProbeOffsetDistanceCm * FrontSamples[SampleIndex]);
            if (!VspIsProbePositionOccupied(CandidateWs))
            {
                ProbeSamplePosWs = CandidateWs;
                bAcceptedVisibleFirst = true;
                break;
            }
        }

        if (!bAcceptedVisibleFirst)
        {
            const float3 SeedCandidateWs =
                CellCenterWs +
                clamp(
                    PreviousProbeOffset,
                    -MaxProbeOffsetDistanceCm.xxx,
                    MaxProbeOffsetDistanceCm.xxx);
            if (!VspIsProbePositionOccupied(SeedCandidateWs))
            {
                ProbeSamplePosWs = SeedCandidateWs;
                bAcceptedVisibleFirst = true;
            }
        }
    }

    if (!bHasSurfaceAnchor || !bAcceptedVisibleFirst)
    {
        bool bFoundNonSolid = false;
        if (VspIsProbePositionOccupied(ProbeSamplePosWs))
        {
            const float SeedLengthSq = dot(PreviousProbeOffset, PreviousProbeOffset);
            const float3 PreferredDirection =
                SeedLengthSq > 1.0e-6
                ? PreviousProbeOffset * rsqrt(SeedLengthSq)
                : 0.0.xxx;
            if (any(PreferredDirection != 0.0.xxx))
            {
                const float FrontBiasSamples[4] = {0.95, 0.75, 0.55, 0.35};
                [unroll]
                for (uint SampleIndex = 0u; SampleIndex < 4u; ++SampleIndex)
                {
                    ProbeSamplePosWs =
                        CellCenterWs +
                        PreferredDirection *
                        (MaxProbeOffsetDistanceCm * FrontBiasSamples[SampleIndex]);
                    if (!VspIsProbePositionOccupied(ProbeSamplePosWs))
                    {
                        bFoundNonSolid = true;
                        break;
                    }
                }
            }

            if (!bFoundNonSolid)
            {
                [unroll]
                for (uint RandomIndex = 0u; RandomIndex < 4u; ++RandomIndex)
                {
                    const uint Seed0 =
                        GlobalCellIndex * 1664525u +
                        (RandomIndex + 1u) * 1013904223u;
                    const uint Seed1 =
                        Seed0 ^
                        (GlobalCellIndex * 2246822519u + 3266489917u);
                    const uint Seed2 =
                        Seed0 ^
                        ((GlobalCellIndex + 1u) * 668265263u + 374761393u);
                    const float3 RandomOffset = float3(
                        VspNativeNoiseFloat2(float2(GlobalCellIndex, Seed0)),
                        VspNativeNoiseFloat2(float2(Seed1, GlobalCellIndex)),
                        VspNativeNoiseFloat2(float2(Seed2, Seed0))) - 0.5.xxx;
                    ProbeSamplePosWs =
                        CellCenterWs +
                        RandomOffset *
                        (VspCascadeCellSizeCm(CascadeIndex) * 0.4);
                    if (!VspIsProbePositionOccupied(ProbeSamplePosWs))
                    {
                        break;
                    }
                }
            }
        }
    }

    const float3 NormalizedOffset = clamp(
        (ProbeSamplePosWs - CellCenterWs) / MaxProbeOffsetDistanceCm,
        -1.0.xxx,
        1.0.xxx);
    return CellCenterWs + NormalizedOffset * MaxProbeOffsetDistanceCm;
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ListIndex = DispatchThreadId.x;
    const uint VisibleCellCount = min(VspVisibleSurfaceList[0], VisibleSurfaceListCapacity);
    if (ListIndex >= VisibleCellCount)
    {
        return;
    }

    const uint GlobalCellIndex = VspVisibleSurfaceList[ListIndex + 1u];
    if (GlobalCellIndex >= VspTotalCellCount())
    {
        return;
    }

    uint CascadeIndex = 0u;
    uint LocalCellIndex = 0u;
    if (!VspDecodeGlobalCellIndex(GlobalCellIndex, CascadeIndex, LocalCellIndex))
    {
        return;
    }

    const float3 CellCenterWs = VspCalcCellCenterWs(CascadeIndex, LocalCellIndex);
    const float MaxProbeOffsetDistanceCm = VspProbeMaxOffsetDistanceCm(CascadeIndex);
    float3 ProbeSamplePosWs = CellCenterWs;
    if (bUseReducedSurfaceBuffer != 0u)
    {
        // Reduced detectionがVisibleSurfaceListと同じindexへ保存したsource texelを使う。
        // cell indexとsource texelの対応を崩すと別surfaceの法線で再配置されるため、必ずpaired listとして読む。
        float3 SurfacePositionWs = 0.0.xxx;
        float3 SurfaceNormalWs = 0.0.xxx;
        if (!VspTryGetReducedSurfaceAnchor(
            ListIndex,
            GlobalCellIndex,
            CascadeIndex,
            SurfacePositionWs,
            SurfaceNormalWs))
        {
            return;
        }

        const float SurfaceClearance = max(
            BbvOccupancyInjectionWorldOffsetCm,
            BbvCellSizeCm / float(k_irdv_bbv_brick_reso));
        const float ClearanceScale[4] = {1.0, 2.0, 3.0, 4.0};
        bool bFoundRelocation = false;
        [unroll]
        for (uint CandidateIndex = 0u;
             CandidateIndex < 4u;
             ++CandidateIndex)
        {
            const float3 CandidateWs =
                SurfacePositionWs +
                SurfaceNormalWs *
                (SurfaceClearance * ClearanceScale[CandidateIndex]);
            const float3 CandidateOffset = CandidateWs - CellCenterWs;
            if (any(abs(CandidateOffset) > MaxProbeOffsetDistanceCm.xxx) ||
                VspIsProbePositionOccupied(CandidateWs))
            {
                continue;
            }

            ProbeSamplePosWs = CandidateWs;
            bFoundRelocation = true;
            break;
        }
        if (!bFoundRelocation)
        {
            return;
        }
    }

    // ReducedSurfaceのprovenanceと法線側候補を検証してからpoolを消費する。
    uint ProbeIndex = RWVspCellProbeIndex[GlobalCellIndex];
    bool bNewProbe = false;
    if (ProbeIndex == k_irdv_vsp_invalid_probe_index)
    {
        ProbeIndex = VspPopFreeProbeIndex();
        if (ProbeIndex == k_irdv_vsp_invalid_probe_index || ProbeIndex >= VspProbePoolElementCount)
        {
            return;
        }

        RWVspCellProbeIndex[GlobalCellIndex] = ProbeIndex;
        VspPushCurrActiveProbeIndex(ProbeIndex);
        bNewProbe = true;
    }
    else if (ProbeIndex >= VspProbePoolElementCount)
    {
        return;
    }

    FInstantRdvVspProbePoolData Data = VspLoadProbePoolData(RWVspProbePool, ProbeIndex);
    if (bNewProbe)
    {
        Data.ProbeOffsetV3 = 0u;
        Data.LastUpdateFrame = 0u;
    }

    if (bUseReducedSurfaceBuffer == 0u)
    {
        const float3 PrevProbeOffset =
            VspDecodeProbeOffset(Data.ProbeOffsetV3) * MaxProbeOffsetDistanceCm;
        ProbeSamplePosWs = VspRelocateProbeNative(
            CellCenterWs,
            PrevProbeOffset,
            MaxProbeOffsetDistanceCm,
            CascadeIndex,
            GlobalCellIndex);
    }

    if (bNewProbe)
    {
        // 同じCascadeを優先し、無ければ上位Cascadeの近傍ActiveProbeからAtlasを引き継ぐ。
        if (bEnableWarmStart != 0u &&
            !VspTrySeedProbeFromNearestActiveProbe(
            ProbeSamplePosWs,
            CascadeIndex,
            ProbeIndex))
        {
            VspClearProbeAtlas(ProbeIndex);
        }
    }

    // 保存するのは world 距離そのものではなく、最大移動距離で正規化した offset。
    // これにより cascade cell size が変わっても同じ意味で decode できる。
    const float3 NormalizedProbeOffset = clamp((ProbeSamplePosWs - CellCenterWs) / MaxProbeOffsetDistanceCm, -1.0.xxx, 1.0.xxx);
    Data.ProbeOffsetV3 = VspEncodeProbeOffset(NormalizedProbeOffset);
    Data.OwnerCellIndex = GlobalCellIndex;
    Data.LastSeenFrame = FrameCount;
    Data.Reserved0 = 0u;
    Data.Reserved1 = 0u;
    Data.Reserved2 = 0u;
    Data.Reserved3 = 0u;
    VspStoreProbePoolData(RWVspProbePool, ProbeIndex, Data);
}
