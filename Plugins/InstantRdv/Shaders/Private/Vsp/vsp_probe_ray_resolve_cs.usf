// ファイル名: vsp_probe_ray_resolve_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Vsp/vsp_state.ush"

// VSPプローブレイの結果解決パス。
// Trace結果をprobe atlas(OctMap)へtemporal blendし、hit時はBBV optional radiance、miss時はsky visibility=1を格納する。

StructuredBuffer<uint> VspProbeRayResultBuffer;
StructuredBuffer<uint> BbvOptionalData;
RWStructuredBuffer<uint> RWVspProbePool;
RWTexture2D<float4> RWVspProbeAtlas;

uint VspProbePoolElementCount;
uint FrameCount;

static const float kVspOctaUpdateTemporalRate = 0.95;

[numthreads(k_irdv_vsp_ray_linear_thread_group_size, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ResultIndex = DispatchThreadId.x;
    const uint ResultCount = min(VspProbeRayResultBuffer[0], VspProbePoolElementCount * kVspRayCountPerProbe);
    if (ResultIndex >= ResultCount)
    {
        return;
    }

	const uint ResultWordOffset = 1u + ResultIndex * k_irdv_vsp_ray_result_data_stride;
    const uint PackedKey = VspProbeRayResultBuffer[ResultWordOffset + 0u];
    const uint HitInfo = VspProbeRayResultBuffer[ResultWordOffset + 1u];
    const uint ProbeIndex = VspUnpackRayRequestProbeIndex(PackedKey);
    const uint OctCellIndex = VspUnpackRayRequestOctCellIndex(PackedKey);
    if (ProbeIndex >= VspProbePoolElementCount || OctCellIndex >= kVspRayCountPerProbe)
    {
        return;
    }

    FInstantRdvVspProbePoolData Data = VspLoadProbePoolData(RWVspProbePool, ProbeIndex);
    if (Data.OwnerCellIndex == k_irdv_vsp_invalid_probe_index)
    {
        return;
    }

    float3 HitRadiance = 0.0.xxx;
    const float SkyVisibility = (HitInfo == 0u) ? 1.0 : 0.0;
    if (HitInfo != 0u)
    {
        // HitInfoはtrace passでbrick index + 1として保存している。0はmiss/sky。
        const uint BrickIndex = HitInfo - 1u;
        const uint OptionalStart = BrickIndex * k_irdv_bbv_brick_optional_data_u32_count;
        HitRadiance = max(float3(
            asfloat(BbvOptionalData[OptionalStart + 1u]),
            asfloat(BbvOptionalData[OptionalStart + 2u]),
            asfloat(BbvOptionalData[OptionalStart + 3u])), 0.0.xxx);
    }

    const uint2 OctCellId = uint2(OctCellIndex % k_irdv_vsp_probe_octmap_width, OctCellIndex / k_irdv_vsp_probe_octmap_width);
    const uint2 AtlasAddress = VspProbeAtlasAddress(ProbeIndex, OctCellId);
    const float4 Prev = RWVspProbeAtlas[AtlasAddress];
    const float4 Curr = float4(HitRadiance, SkyVisibility);
    // 参照実装のOctaMap履歴更新に合わせ、急なradiance変化を抑える。
    RWVspProbeAtlas[AtlasAddress] = lerp(Curr, Prev, kVspOctaUpdateTemporalRate);

    if (OctCellIndex == 0u)
    {
        Data.LastUpdateFrame = FrameCount;
        VspStoreProbePoolData(RWVspProbePool, ProbeIndex, Data);
    }
}
