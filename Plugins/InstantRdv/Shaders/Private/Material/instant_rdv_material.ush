// ファイル名: instant_rdv_material.ush
// 役割: Unreal Engine Material Custom NodeからInstantRDVの統合間接光評価を行う公開関数を提供する。
// InstantRdvMaterialTryEvaluateIndirectLightingだけをMaterial Custom Nodeから使用する。
#ifndef INSTANT_RDV_MATERIAL_USH
#define INSTANT_RDV_MATERIAL_USH

#include "/InstantRdvShaders/Private/vsp_util.ush"

// Material Scene UniformからIrradianceVolume評価に必要なグリッド状態を構築する。
FInstantRdvVspGridParams InstantRdvMaterialGetVspGridParams()
{
    FInstantRdvVspGridParams GridParams = (FInstantRdvVspGridParams)0;
    GridParams.GridResolutionX = Scene.InstantRdvParam.VspGridResolutionX;
    GridParams.GridResolutionY = Scene.InstantRdvParam.VspGridResolutionY;
    GridParams.GridResolutionZ = Scene.InstantRdvParam.VspGridResolutionZ;
    GridParams.CascadeCount = Scene.InstantRdvParam.VspCascadeCount;
    GridParams.CellSizeCm = Scene.InstantRdvParam.VspCellSizeCm;
    GridParams.GridCenterPositionWs = Scene.InstantRdvParam.VspGridCenterPositionWs;
    return GridParams;
}

// WorldPositionWsにおける入射Diffuse Irradiance EとSkyLight/IBL向けSky Visibilityを同時に評価する。
// EmissiveへLambert反射の輝度として出力する場合は、BaseColor * OutDiffuseIrradiance / PIを使用する。
// InstantRDV無効時はfalseを返し、Irradianceはゼロ、SkyVisibilityは遮蔽なしの1を返す。
// Volume外ではfalseを返し、IrradianceとSkyVisibilityはゼロとなる。
bool InstantRdvMaterialTryEvaluateIndirectLighting(
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutDiffuseIrradiance,
    out float OutSkyVisibilityIbl)
{
    OutDiffuseIrradiance = 0.0.xxx;
    OutSkyVisibilityIbl = Scene.InstantRdvParam.VspEnabled == 0u ? 1.0 : 0.0;
    if (Scene.InstantRdvParam.VspEnabled == 0u)
    {
        return false;
    }

    return VspUtilTryEvaluateIrradianceVolumeIndirectLightingTrilinear(
        Scene.InstantRdvParam.VspIrradianceVolumeSH,
        InstantRdvMaterialGetVspGridParams(),
        WorldPositionWs,
        NormalWs,
        OutDiffuseIrradiance,
        OutSkyVisibilityIbl);
}

#endif // INSTANT_RDV_MATERIAL_USH
