// ワールド位置周辺8セルを補間し、Radianceを評価する。
bool FspUtilTryEvaluateIrradianceVolumeRadianceTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutRadiance)
{
    OutRadiance = 0.0.xxx;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        false,
        true,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    const float4 ShBasis = FspUtilEvaluateL1ShBasis(normalize(NormalWs));
    RadianceR = FspUtilDeconvolveL1SHByClampedCosine(RadianceR);
    RadianceG = FspUtilDeconvolveL1SHByClampedCosine(RadianceG);
    RadianceB = FspUtilDeconvolveL1SHByClampedCosine(RadianceB);
    OutRadiance = max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
    return true;
}

// Material用: Finest Cascade内でSH係数をトリリニア補間し、Diffuse Irradianceを評価する。
// 8セルの格納済みDiffuse Irradiance SHを先に補間してから法線評価を1回だけ行う。
// OutDiffuseIrradianceは入射Diffuse Irradiance Eであり、Lambert反射の出力Radianceは
//    BaseColor * OutDiffuseIrradiance / PI として使用する。
// 戻り値は位置に使用可能なCascadeと補間座標があるかを表す。false時の出力はゼロ。
// 未更新セルのゼロSHは座標が有効ならtrueとなるため、GI値の有効性は表さない。
bool FspUtilTryEvaluateIrradianceVolumeDiffuseIrradianceTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutDiffuseIrradiance)
{
    OutDiffuseIrradiance = 0.0.xxx;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        false,
        true,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    const float4 ShBasis = FspUtilEvaluateL1ShBasis(normalize(NormalWs));
    OutDiffuseIrradiance = max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
    return true;
}

// ワールド位置周辺8セルを補間し、指定方向のSkyVisibilityを評価する。Cos畳み込み無し.
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibilityTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        true,
        false,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    OutSkyVisibility = saturate(
        dot(SkyVisibility, FspUtilEvaluateL1ShBasis(normalize(NormalWs))));
    return true;
}

// Material用: Finest Cascade内でSkyVisibility SHをトリリニア補間し、Diffuse/IBL可視性を評価する。
// 8セルのSH係数を先に補間してから正規化Cos畳み込みと法線評価を1回だけ行う。
// OutSkyVisibilityは無次元のIBL可視性係数で、SkyLightやIBLの間接光成分へ乗算する。
// 正規化Cos畳み込み済みのためPI除算は不要。
// 戻り値は位置に使用可能なCascadeと補間座標があるかを表す。false時の出力はゼロ。
// 未更新セルのゼロSHは座標が有効ならtrueとなるため、可視性値の有効性は表さない。
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibilityIblTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        true,
        false,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    OutSkyVisibility = saturate(
        dot(
            SkyVisibility,
            FspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(normalize(NormalWs)))); // Cos畳み込み
    return true;
}

#endif // INSTANT_RDV_FSP_UTIL_USH
