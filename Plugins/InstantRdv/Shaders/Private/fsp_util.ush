        IrradianceVolumeSH,
        GridParams,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutDiffuseIrradiance = FspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
    return true;
}

// Finest Cascadeの単一セルを参照し、Diffuse/IBL用のSkyVisibilityを評価する。
// 戻り値は正規化Cos畳み込み済みの無次元可視性係数で、PI除算は不要。
// ワールド位置からセルを検索し、最近傍セルのIBL可視性を評価する。
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibilityIbl(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_fsp_invalid_probe_index;
    if (!FspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!FspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        GridParams,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
