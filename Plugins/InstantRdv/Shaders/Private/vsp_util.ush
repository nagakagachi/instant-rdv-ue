// ファイル名: vsp_util.ush
// 役割: InstantRDV VSPの内部シェーダで使用するグリッド、Probe、IrradianceVolume操作および評価のユーティリティを定義する。
#ifndef INSTANT_RDV_VSP_UTIL_USH
#define INSTANT_RDV_VSP_UTIL_USH

#include "/InstantRdvShaders/Private/instant_rdv_util.ush"

#if IS_MATERIAL_SHADER
    #define IRDV_VSP_IRRADIANCE_VOLUME_SAMPLER Scene.InstantRdvParam.VspIrradianceVolumeSampler
#else
    SamplerState VspIrradianceVolumeSampler;
    #define IRDV_VSP_IRRADIANCE_VOLUME_SAMPLER VspIrradianceVolumeSampler
#endif

// 再利用可能なユーティリティへ明示的に渡すVSPグリッド状態。
// シェーダのエントリポイントはUniformParamsから値を設定し、Material CustomNodeは
// VSPシェーダのグローバル変数に依存せず同等の値を渡せる。
struct FInstantRdvVspGridParams
{
    uint GridResolutionX;
    uint GridResolutionY;
    uint GridResolutionZ;
    uint CascadeCount;
    float CellSizeCm;
    float3 GridCenterPositionWs;
    float3 PrevGridCenterPositionWs;
};

// CascadeごとのIVセル数を返す。
uint VspUtilCellCountPerCascade(FInstantRdvVspGridParams Params)
{
    return Params.GridResolutionX * Params.GridResolutionY * Params.GridResolutionZ;
}

// 実際に参照可能なCascade数を上限値内へ正規化する。
uint VspUtilEffectiveCascadeCount(FInstantRdvVspGridParams Params)
{
    return min(Params.CascadeCount, k_irdv_vsp_max_cascade_count);
}

// 全Cascadeを含むIVの総セル数を返す。
uint VspUtilTotalCellCount(FInstantRdvVspGridParams Params)
{
    return VspUtilCellCountPerCascade(Params) *
        max(VspUtilEffectiveCascadeCount(Params), 1u);
}

// Cascade番号と物理セル番号を連続バッファのglobal indexへ変換する。
uint VspUtilEncodeGlobalCellIndex(FInstantRdvVspGridParams Params, uint CascadeIndex, uint LocalCellIndex)
{
    return CascadeIndex * VspUtilCellCountPerCascade(Params) + LocalCellIndex;
}

// global indexをCascade番号とCascade内セル番号へ分解する。
bool VspUtilDecodeGlobalCellIndex(
    FInstantRdvVspGridParams Params,
    uint GlobalCellIndex,
    out uint OutCascadeIndex,
    out uint OutLocalCellIndex)
{
    const uint CellCountPerCascade = VspUtilCellCountPerCascade(Params);
    OutCascadeIndex = 0u;
    OutLocalCellIndex = 0u;
    if (CellCountPerCascade == 0u || GlobalCellIndex >= VspUtilTotalCellCount(Params))
    {
        return false;
    }

    OutCascadeIndex = GlobalCellIndex / CellCountPerCascade;
    OutLocalCellIndex = GlobalCellIndex - OutCascadeIndex * CellCountPerCascade;
    return OutCascadeIndex < VspUtilEffectiveCascadeCount(Params);
}

// Cascade内の線形セル番号を物理XYZ座標へ変換する。
uint3 VspUtilLocalCellIndexToCoord(FInstantRdvVspGridParams Params, uint LocalCellIndex)
{
    const uint Slice = Params.GridResolutionX * Params.GridResolutionY;
    const uint Z = LocalCellIndex / Slice;
    const uint Rem = LocalCellIndex - Z * Slice;
    const uint Y = Rem / Params.GridResolutionX;
    const uint X = Rem - Y * Params.GridResolutionX;
    return uint3(X, Y, Z);
}

// 物理XYZ座標をCascade内の線形セル番号へ変換する。
uint VspUtilPhysicalCellCoordToLocalIndex(FInstantRdvVspGridParams Params, uint3 PhysicalCoord)
{
    return PhysicalCoord.x
        + PhysicalCoord.y * Params.GridResolutionX
        + PhysicalCoord.z * Params.GridResolutionX * Params.GridResolutionY;
}

// Cascade番号に対応するワールドセルサイズをcm単位で返す。
float VspUtilCascadeCellSizeCm(FInstantRdvVspGridParams Params, uint CascadeIndex)
{
    return Params.CellSizeCm * exp2(float(CascadeIndex));
}

// Probe relocationで許容する最大オフセット距離をcm単位で返す。
float VspUtilProbeMaxOffsetDistanceCm(FInstantRdvVspGridParams Params, uint CascadeIndex)
{
    return VspUtilCascadeCellSizeCm(Params, CascadeIndex) * 0.9;
}

// ワールド中心位置をCascadeの量子化セルIDへ変換する。
int3 VspUtilCenterCellIdFromPosition(FInstantRdvVspGridParams Params, uint CascadeIndex, float3 CenterPositionWs)
{
    return int3(floor(CenterPositionWs / max(VspUtilCascadeCellSizeCm(Params, CascadeIndex), 0.001)));
}

// Cascade中心から、物理格納グリッドのtoroidal offsetを求める。
int3 VspUtilToroidalOffset(FInstantRdvVspGridParams Params, uint CascadeIndex, float3 CenterPositionWs)
{
    const int3 Resolution = int3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ);
    const int3 CenterCellId = VspUtilCenterCellIdFromPosition(Params, CascadeIndex, CenterPositionWs);
    return ((CenterCellId % Resolution) + Resolution) % Resolution;
}

// Cascadeグリッドのワールド空間最小座標を返す。
float3 VspUtilCascadeGridMinPositionWs(FInstantRdvVspGridParams Params, uint CascadeIndex)
{
    const float CellSize = VspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const float3 Extent = float3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ) * CellSize;
    return float3(VspUtilCenterCellIdFromPosition(Params, CascadeIndex, Params.GridCenterPositionWs)) * CellSize - Extent * 0.5.xxx;
}

// 論理セル座標をtoroidal物理格納座標へ変換する。
uint3 VspUtilLinearToPhysicalCoord(FInstantRdvVspGridParams Params, int3 LinearCoord, uint CascadeIndex)
{
    return LogicalToPhysicalGridCoord(
        LinearCoord,
        VspUtilToroidalOffset(Params, CascadeIndex, Params.GridCenterPositionWs),
        uint3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ));
}

// toroidal物理格納座標を論理セル座標へ逆変換する。
int3 VspUtilPhysicalToLinearCoord(FInstantRdvVspGridParams Params, uint3 PhysicalCoord, uint CascadeIndex)
{
    return PhysicalToLogicalGridCoord(
        int3(PhysicalCoord),
        VspUtilToroidalOffset(Params, CascadeIndex, Params.GridCenterPositionWs),
        uint3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ));
}

// 物理セル番号に対応するワールド空間セル中心を返す。
float3 VspUtilCalcCellCenterWs(FInstantRdvVspGridParams Params, uint CascadeIndex, uint LocalCellIndex)
{
    const float CellSize = VspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const int3 LinearCoord = VspUtilPhysicalToLinearCoord(
        Params,
        VspUtilLocalCellIndexToCoord(Params, LocalCellIndex),
        CascadeIndex);
    return VspUtilCascadeGridMinPositionWs(Params, CascadeIndex) + (float3(LinearCoord) + 0.5.xxx) * CellSize;
}

// ワールド位置を指定Cascadeのglobalセル番号へ変換する。
bool VspUtilTryGetGlobalCellIndexFromWorldPos(
    FInstantRdvVspGridParams Params,
    float3 WorldPosWs,
    uint CascadeIndex,
    out uint OutGlobalCellIndex)
{
    OutGlobalCellIndex = k_irdv_vsp_invalid_probe_index;
    const float CellSize = VspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const int3 LinearCoord = int3(floor(
        (WorldPosWs - VspUtilCascadeGridMinPositionWs(Params, CascadeIndex)) / max(CellSize, 0.001)));
    if (any(LinearCoord < 0) ||
        LinearCoord.x >= int(Params.GridResolutionX) ||
        LinearCoord.y >= int(Params.GridResolutionY) ||
        LinearCoord.z >= int(Params.GridResolutionZ))
    {
        return false;
    }

    OutGlobalCellIndex = VspUtilEncodeGlobalCellIndex(
        Params,
        CascadeIndex,
        VspUtilPhysicalCellCoordToLocalIndex(Params, VspUtilLinearToPhysicalCoord(Params, LinearCoord, CascadeIndex)));
    return true;
}

// ワールド位置を含む最も細かいCascadeのセルを検索する。
bool VspUtilTryGetFinestCascadeCellFromWorldPos(
    FInstantRdvVspGridParams Params,
    float3 WorldPositionWs,
    out uint OutCascadeIndex,
    out uint OutGlobalCellIndex)
{
    OutCascadeIndex = 0u;
    OutGlobalCellIndex = k_irdv_vsp_invalid_probe_index;

    [unroll]
    for (uint CascadeIndex = 0u;
         CascadeIndex < k_irdv_vsp_max_cascade_count;
         ++CascadeIndex)
    {
        if (CascadeIndex >= VspUtilEffectiveCascadeCount(Params))
        {
            break;
        }
        uint CellIndex = k_irdv_vsp_invalid_probe_index;
        if (VspUtilTryGetGlobalCellIndexFromWorldPos(
            Params,
            WorldPositionWs,
            CascadeIndex,
            CellIndex))
        {
            OutCascadeIndex = CascadeIndex;
            OutGlobalCellIndex = CellIndex;
            return true;
        }
    }

    return false;
}

// ワールド位置をトリリニア補間用の基底セルと補間率へ変換する。
bool VspUtilTryGetTrilinearCellCoordinates(
    FInstantRdvVspGridParams Params,
    float3 WorldPositionWs,
    uint CascadeIndex,
    out int3 OutBaseCellCoord,
    out float3 OutCellFraction)
{
    OutBaseCellCoord = int3(0, 0, 0);
    OutCellFraction = 0.0.xxx;
    if (Params.GridResolutionX == 0u ||
        Params.GridResolutionY == 0u ||
        Params.GridResolutionZ == 0u ||
        CascadeIndex >= VspUtilEffectiveCascadeCount(Params))
    {
        return false;
    }

    const float CellSize = VspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const float3 GridMinPositionWs = VspUtilCascadeGridMinPositionWs(Params, CascadeIndex);
    const float3 GridExtentWs =
        float3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ) * CellSize;
    const float3 PositionInGridWs = WorldPositionWs - GridMinPositionWs;
    if (any(PositionInGridWs < 0.0.xxx) || any(PositionInGridWs > GridExtentWs))
    {
        return false;
    }

    // セル中心を整数座標へ対応させ、端では隣接セルを複製して範囲外アクセスを防ぐ。
    const float3 ContinuousCellCoord = PositionInGridWs / max(CellSize, 0.001) - 0.5.xxx;
    const int3 CellResolution = int3(
        Params.GridResolutionX,
        Params.GridResolutionY,
        Params.GridResolutionZ);
    const int3 MaxBaseCellCoord = max(CellResolution - 2, int3(0, 0, 0));
    const int3 UnclampedBaseCellCoord = int3(floor(ContinuousCellCoord));

    OutBaseCellCoord = clamp(UnclampedBaseCellCoord, 0.xxx, MaxBaseCellCoord);
    OutCellFraction = saturate(ContinuousCellCoord - float3(OutBaseCellCoord));
    return true;
}

// カメラ位置に対して連続な、細かいCascadeから親Cascadeへのディザ遷移率を返す。
// グリッド中心はマイナス無限方向へ量子化されるため、実グリッド外縁はカメラの
// セル内位相で最大1セル動く。親CascadeのActiveProbeが常に存在する範囲だけを
// 遷移帯として用い、未更新の親IVをサンプリングしない。
float VspUtilCalcIrradianceVolumeCascadeDitherRate(
    FInstantRdvVspGridParams Params,
    float3 WorldPositionWs,
    uint CascadeIndex)
{
    const float3 CameraToSampleCell =
        (WorldPositionWs - Params.GridCenterPositionWs) /
        max(VspUtilCascadeCellSizeCm(Params, CascadeIndex), 0.001);
    const float3 HalfExtentCell =
        float3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ) * 0.5;

    // 正方向は [H-2, H-1)、負方向は [H-1, H) を使う。
    // これらは各位相で実外縁から2セル以内にあり、辺と角でも同じ規則で安全である。
    const float3 SafeRangeEndCell = select(
        CameraToSampleCell >= 0.0.xxx,
        HalfExtentCell - 1.0.xxx,
        HalfExtentCell);
    const float3 BorderGradient = max(
        abs(CameraToSampleCell) - (SafeRangeEndCell - 1.0.xxx),
        0.0.xxx);
    return saturate(max(
        BorderGradient.x,
        max(BorderGradient.y, BorderGradient.z)));
}

// カメラ距離に連続な安全帯から最細Cascadeとトリリニア座標を求める。
bool VspUtilTryGetFinestCascadeTrilinearCoordinates(
    FInstantRdvVspGridParams Params,
    float3 WorldPositionWs,
    out uint OutCascadeIndex,
    out int3 OutBaseCellCoord,
    out float3 OutCellFraction)
{
    OutCascadeIndex = 0u;
    OutBaseCellCoord = int3(0, 0, 0);
    OutCellFraction = 0.0.xxx;

    const uint CascadeCount = VspUtilEffectiveCascadeCount(Params);
    [unroll]
    for (uint CascadeIndex = 0u;
         CascadeIndex < k_irdv_vsp_max_cascade_count;
         ++CascadeIndex)
    {
        if (CascadeIndex >= CascadeCount)
        {
            break;
        }

        const bool bIsLastCascade = CascadeIndex + 1u >= CascadeCount;
        const float CoarseBlendWeight = bIsLastCascade
            ? 0.0
            : VspUtilCalcIrradianceVolumeCascadeDitherRate(
                Params,
                WorldPositionWs,
                CascadeIndex);
        if (!bIsLastCascade && CoarseBlendWeight >= 1.0)
        {
            continue;
        }

        if (VspUtilTryGetTrilinearCellCoordinates(
            Params,
            WorldPositionWs,
            CascadeIndex,
            OutBaseCellCoord,
            OutCellFraction))
        {
            OutCascadeIndex = CascadeIndex;
            return true;
        }
    }

    return false;
}

// Global Cell Indexと信号番号から、全CascadeをZ方向へ連結した3D Texture座標を求める。
uint3 VspUtilIrradianceVolumeTextureCoord(
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    uint TextureIndex)
{
    const uint CellCountPerCascade = VspUtilCellCountPerCascade(Params);
    const uint CascadeIndex = CellIndex / CellCountPerCascade;
    const uint LocalCellIndex = CellIndex - CascadeIndex * CellCountPerCascade;
    const uint3 PhysicalCoord = VspUtilLocalCellIndexToCoord(Params, LocalCellIndex);
    const uint TextureSliceDepth =
        Params.GridResolutionZ + k_irdv_vsp_irradiance_volume_guard_texel_count;
    return uint3(
        PhysicalCoord.xy,
        CascadeIndex * TextureSliceDepth * k_irdv_vsp_irradiance_volume_sh_texture_count +
            TextureIndex * TextureSliceDepth + PhysicalCoord.z);
}

// IVセルの4個のfloat4係数を、格納形式のままロードする。
void VspUtilLoadIrradianceVolumeL1SHCoefficients(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    out float4 OutC0,
    out float4 OutC1,
    out float4 OutC2,
    out float4 OutC3)
{
    const float4 SkyVisibility = IrradianceVolumeSH.Load(int4(
        VspUtilIrradianceVolumeTextureCoord(Params, CellIndex, 0u), 0));
    const float4 IrradianceR = IrradianceVolumeSH.Load(int4(
        VspUtilIrradianceVolumeTextureCoord(Params, CellIndex, 1u), 0));
    const float4 IrradianceG = IrradianceVolumeSH.Load(int4(
        VspUtilIrradianceVolumeTextureCoord(Params, CellIndex, 2u), 0));
    const float4 IrradianceB = IrradianceVolumeSH.Load(int4(
        VspUtilIrradianceVolumeTextureCoord(Params, CellIndex, 3u), 0));
    OutC0 = float4(SkyVisibility.x, IrradianceR.x, IrradianceG.x, IrradianceB.x);
    OutC1 = float4(SkyVisibility.y, IrradianceR.y, IrradianceG.y, IrradianceB.y);
    OutC2 = float4(SkyVisibility.z, IrradianceR.z, IrradianceG.z, IrradianceB.z);
    OutC3 = float4(SkyVisibility.w, IrradianceR.w, IrradianceG.w, IrradianceB.w);
}

// 格納済みDiffuse Irradiance SHを入射Radiance SHへ戻す。
// 既存のRadiance取得APIとの互換用で、通常のGI評価では格納値を直接使用する。
float4 VspUtilDeconvolveL1SHByClampedCosine(float4 IrradianceSH)
{
    const float Pi = 3.14159265358979323846;
    return IrradianceSH * float4(1.0 / Pi, 3.0 / (2.0 * Pi), 3.0 / (2.0 * Pi), 3.0 / (2.0 * Pi));
}

// IVセルの係数をSkyVisibilityとRadiance RGBのSHへ展開する。
// Texture内のRGBはDiffuse Irradiance SHなので、Radiance取得APIでは逆畳み込みする。
void VspUtilLoadIrradianceVolumeL1SH(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    float4 C0;
    float4 C1;
    float4 C2;
    float4 C3;
    VspUtilLoadIrradianceVolumeL1SHCoefficients(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        C0,
        C1,
        C2,
        C3);

    OutSkyVisibility = float4(
        C0.r,
        C1.r,
        C2.r,
        C3.r);
    OutRadianceR = VspUtilDeconvolveL1SHByClampedCosine(float4(
        C0.g,
        C1.g,
        C2.g,
        C3.g));
    OutRadianceG = VspUtilDeconvolveL1SHByClampedCosine(float4(
        C0.b,
        C1.b,
        C2.b,
        C3.b));
    OutRadianceB = VspUtilDeconvolveL1SHByClampedCosine(float4(
        C0.a,
        C1.a,
        C2.a,
        C3.a));
}

// IVセルのSHをロードし、全係数ゼロでない場合だけ有効を返す。
bool VspUtilTryLoadIrradianceVolumeL1SH(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    float4 C0;
    float4 C1;
    float4 C2;
    float4 C3;
    VspUtilLoadIrradianceVolumeL1SHCoefficients(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        C0,
        C1,
        C2,
        C3);

    OutSkyVisibility = float4(C0.r, C1.r, C2.r, C3.r);
    OutRadianceR = VspUtilDeconvolveL1SHByClampedCosine(float4(C0.g, C1.g, C2.g, C3.g));
    OutRadianceG = VspUtilDeconvolveL1SHByClampedCosine(float4(C0.b, C1.b, C2.b, C3.b));
    OutRadianceB = VspUtilDeconvolveL1SHByClampedCosine(float4(C0.a, C1.a, C2.a, C3.a));
    return any(abs(C0) > 0.0.xxxx) ||
        any(abs(C1) > 0.0.xxxx) ||
        any(abs(C2) > 0.0.xxxx) ||
        any(abs(C3) > 0.0.xxxx);
}

// 同一Cascade内のSHをハードウェアTrilinear補間する。
// Materialのデバッグシェーダに定義される汎用マクロとの衝突を避けるため、
// この関数内の非公開識別子にはIrdvVsp接頭辞を付ける。
// 正側Guardへ物理座標0を複製しているため、Toroidal境界でも隣の信号やCascadeと混ざらない。
void VspUtilLoadIrradianceVolumeL1SHTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams IrdvVspGridParams,
    uint IrdvVspCascadeIndex,
    int3 IrdvVspBaseCellCoord,
    float3 IrdvVspCellFraction,
    bool bIrdvVspNeedSkyVisibility,
    bool bIrdvVspNeedRadiance,
    out float4 OutIrdvVspSkyVisibility,
    out float4 OutIrdvVspRadianceR,
    out float4 OutIrdvVspRadianceG,
    out float4 OutIrdvVspRadianceB)
{
    OutIrdvVspSkyVisibility = 0.0.xxxx;
    OutIrdvVspRadianceR = 0.0.xxxx;
    OutIrdvVspRadianceG = 0.0.xxxx;
    OutIrdvVspRadianceB = 0.0.xxxx;

    bool bIrdvVspUseTrilinearInterpolation = true;
#if IS_MATERIAL_SHADER
    bIrdvVspUseTrilinearInterpolation = Scene.InstantRdvParam.VspTrilinearInterpolation != 0u;
#endif
    if (!bIrdvVspUseTrilinearInterpolation)
    {
        const int3 IrdvVspNearestLinearCellCoord = IrdvVspBaseCellCoord + int3(
            IrdvVspCellFraction.x >= 0.5 ? 1 : 0,
            IrdvVspCellFraction.y >= 0.5 ? 1 : 0,
            IrdvVspCellFraction.z >= 0.5 ? 1 : 0);
        const uint IrdvVspNearestCellIndex = VspUtilEncodeGlobalCellIndex(
            IrdvVspGridParams,
            IrdvVspCascadeIndex,
            VspUtilPhysicalCellCoordToLocalIndex(
                IrdvVspGridParams,
                VspUtilLinearToPhysicalCoord(
                    IrdvVspGridParams,
                    IrdvVspNearestLinearCellCoord,
                    IrdvVspCascadeIndex)));
        float4 IrdvVspC0;
        float4 IrdvVspC1;
        float4 IrdvVspC2;
        float4 IrdvVspC3;
        VspUtilLoadIrradianceVolumeL1SHCoefficients(
            IrradianceVolumeSH,
            IrdvVspGridParams,
            IrdvVspNearestCellIndex,
            IrdvVspC0,
            IrdvVspC1,
            IrdvVspC2,
            IrdvVspC3);
        if (bIrdvVspNeedSkyVisibility)
        {
            OutIrdvVspSkyVisibility = float4(IrdvVspC0.r, IrdvVspC1.r, IrdvVspC2.r, IrdvVspC3.r);
        }
        if (bIrdvVspNeedRadiance)
        {
            OutIrdvVspRadianceR = float4(IrdvVspC0.g, IrdvVspC1.g, IrdvVspC2.g, IrdvVspC3.g);
            OutIrdvVspRadianceG = float4(IrdvVspC0.b, IrdvVspC1.b, IrdvVspC2.b, IrdvVspC3.b);
            OutIrdvVspRadianceB = float4(IrdvVspC0.a, IrdvVspC1.a, IrdvVspC2.a, IrdvVspC3.a);
        }
        return;
    }

    const uint3 IrdvVspGridResolution = uint3(
        IrdvVspGridParams.GridResolutionX,
        IrdvVspGridParams.GridResolutionY,
        IrdvVspGridParams.GridResolutionZ);
    const uint3 IrdvVspPaddedResolution =
        IrdvVspGridResolution + k_irdv_vsp_irradiance_volume_guard_texel_count;
    const int3 IrdvVspToroidalOffset = VspUtilToroidalOffset(
        IrdvVspGridParams,
        IrdvVspCascadeIndex,
        IrdvVspGridParams.GridCenterPositionWs);
    const int3 IrdvVspPhysicalBaseCellCoord = LogicalToPhysicalGridCoord(
        IrdvVspBaseCellCoord,
        IrdvVspToroidalOffset,
        IrdvVspGridResolution);
    const uint IrdvVspCascadeTextureZ =
        IrdvVspCascadeIndex * IrdvVspPaddedResolution.z * k_irdv_vsp_irradiance_volume_sh_texture_count;
    const float IrdvVspTextureDepth =
        float(IrdvVspPaddedResolution.z * max(VspUtilEffectiveCascadeCount(IrdvVspGridParams), 1u) *
            k_irdv_vsp_irradiance_volume_sh_texture_count);
    const float3 IrdvVspTextureResolution =
        float3(float2(IrdvVspPaddedResolution.xy), IrdvVspTextureDepth);

    if (bIrdvVspNeedSkyVisibility)
    {
        const float3 IrdvVspSampleTexel = float3(
            float2(IrdvVspPhysicalBaseCellCoord.xy) + 0.5.xx + IrdvVspCellFraction.xy,
            float(IrdvVspCascadeTextureZ + IrdvVspPhysicalBaseCellCoord.z) + 0.5 + IrdvVspCellFraction.z);
        OutIrdvVspSkyVisibility = IrradianceVolumeSH.SampleLevel(
            IRDV_VSP_IRRADIANCE_VOLUME_SAMPLER,
            IrdvVspSampleTexel / IrdvVspTextureResolution,
            0.0);
    }
    if (bIrdvVspNeedRadiance)
    {
        const float2 IrdvVspSampleTexelXY =
            float2(IrdvVspPhysicalBaseCellCoord.xy) + 0.5.xx + IrdvVspCellFraction.xy;
        const float IrdvVspSampleTexelZ =
            float(IrdvVspCascadeTextureZ + IrdvVspPhysicalBaseCellCoord.z) + 0.5 + IrdvVspCellFraction.z;
        OutIrdvVspRadianceR = IrradianceVolumeSH.SampleLevel(
            IRDV_VSP_IRRADIANCE_VOLUME_SAMPLER,
            float3(IrdvVspSampleTexelXY, IrdvVspSampleTexelZ + IrdvVspPaddedResolution.z) / IrdvVspTextureResolution,
            0.0);
        OutIrdvVspRadianceG = IrradianceVolumeSH.SampleLevel(
            IRDV_VSP_IRRADIANCE_VOLUME_SAMPLER,
            float3(IrdvVspSampleTexelXY, IrdvVspSampleTexelZ + IrdvVspPaddedResolution.z * 2u) / IrdvVspTextureResolution,
            0.0);
        OutIrdvVspRadianceB = IrradianceVolumeSH.SampleLevel(
            IRDV_VSP_IRRADIANCE_VOLUME_SAMPLER,
            float3(IrdvVspSampleTexelXY, IrdvVspSampleTexelZ + IrdvVspPaddedResolution.z * 3u) / IrdvVspTextureResolution,
            0.0);
    }
}

float VspUtilCascadeDitherNoise(float3 WorldPositionWs)
{
    return frac(sin(dot(WorldPositionWs, float3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// 最細Cascadeの境界付近で、最細Cascadeまたは一つ上のCascadeを確率的に選択する。
// 選択と同じ連続位置の境界を使い、グリッドのスナップによるディザ率の跳躍を防ぐ。
// ディザ帯は最細Cascadeの境界から1セルの固定安全帯であり、呼び出し側から変更しない。
// 両Cascadeを同時にロードせず、選択された方だけをサンプリングする。
bool VspUtilLoadIrradianceVolumeL1SHCascadeBlended(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    uint FineCascadeIndex,
    int3 FineBaseCellCoord,
    float3 FineCellFraction,
    bool bNeedSkyVisibility,
    bool bNeedRadiance,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    const uint CoarseCascadeIndex = FineCascadeIndex + 1u;
    const float CoarseBlendWeight = VspUtilCalcIrradianceVolumeCascadeDitherRate(
        GridParams,
        WorldPositionWs,
        FineCascadeIndex);

    // MaterialではデバッグCVarでのみ切り替える。内部VSPシェーダは固定で有効化する。
    const bool bCascadeDitherEnabled =
#if IS_MATERIAL_SHADER
        Scene.InstantRdvParam.VspCascadeDitherInterpolation != 0u;
#else
        true;
#endif
    const bool bUseCoarseCascade =
        bCascadeDitherEnabled &&
        CoarseCascadeIndex < VspUtilEffectiveCascadeCount(GridParams) &&
        VspUtilCascadeDitherNoise(WorldPositionWs) < CoarseBlendWeight;

    if (bUseCoarseCascade)
    {
        int3 CoarseBaseCellCoord;
        float3 CoarseCellFraction;
        if (VspUtilTryGetTrilinearCellCoordinates(
            GridParams,
            WorldPositionWs,
            CoarseCascadeIndex,
            CoarseBaseCellCoord,
            CoarseCellFraction))
        {
            VspUtilLoadIrradianceVolumeL1SHTrilinear(
                IrradianceVolumeSH,
                GridParams,
                CoarseCascadeIndex,
                CoarseBaseCellCoord,
                CoarseCellFraction,
                bNeedSkyVisibility,
                bNeedRadiance,
                OutSkyVisibility,
                OutRadianceR,
                OutRadianceG,
                OutRadianceB);
            return true;
        }
    }

    VspUtilLoadIrradianceVolumeL1SHTrilinear(
        IrradianceVolumeSH,
        GridParams,
        FineCascadeIndex,
        FineBaseCellCoord,
        FineCellFraction,
        bNeedSkyVisibility,
        bNeedRadiance,
        OutSkyVisibility,
        OutRadianceR,
        OutRadianceG,
        OutRadianceB);
    return true;
}

// 方向ベクトルに対するL1 SH基底(Y00,Y1-1,Y10,Y1+1)を評価する。
float4 VspUtilEvaluateL1ShBasis(float3 DirectionWs)
{
    return float4(
        0.2820947918,
        0.4886025119 * DirectionWs.y,
        0.4886025119 * DirectionWs.z,
        0.4886025119 * DirectionWs.x);
}

// L1 SHへ軸対称カーネルを畳み込む。
// 係数を変更するだけで、RadianceのCos畳み込みとSkyVisibilityの正規化Cos畳み込みを共有する。
// L1 SH係数へ軸対称カーネルのL0/L1スケールを適用する。
float4 VspUtilConvolveL1SH(float4 SHCoefficients, float L0Scale, float L1Scale)
{
    return SHCoefficients * float4(L0Scale, L1Scale, L1Scale, L1Scale);
}

// 入射Radiance SHをLambert積分用のDiffuse Irradiance SHへ変換する。
// 戻り値は E(N) = integral(L(omega) * max(dot(N, omega), 0) domega) の近似値。
// これはLambert BRDFの1/PIを含まない入射Diffuse Irradianceである。
// Lambert BRDFへ渡す場合はBRDF側でPI除算し、最終Diffuse反射値として使う場合は利用側でPI除算する。
// Radiance SHをCos畳み込み済みDiffuse Irradiance SHへ変換する。
float4 VspUtilConvolveL1SHByClampedCosine(float4 RadianceSH)
{
    const float Pi = 3.14159265358979323846;
    return VspUtilConvolveL1SH(RadianceSH, Pi, 2.0 * Pi / 3.0);
}

// SkyVisibility SHを半球平均の可視性係数へ変換する。
// 戻り値は0から1を基本範囲とする無次元のDiffuse/IBL可視性係数で、PI除算は不要。
// SkyVisibility SHを正規化Cos畳み込み済み可視性SHへ変換する。
float4 VspUtilConvolveL1SHByNormalizedClampedCosine(float4 SkyVisibilitySH)
{
    return VspUtilConvolveL1SH(SkyVisibilitySH, 1.0, 2.0 / 3.0);
}


// SH係数ではなく評価基底側へCos畳み込みを移す。
// dot(SH * Kernel, Basis) == dot(SH, Basis * Kernel) なので、
// RGB各チャンネルの係数を個別に畳み込むより、基底を一度だけ計算する方が軽い。
// Cos畳み込みを基底側へ移して、PI除算前のDiffuse Irradiance評価用基底を返す。
float4 VspUtilEvaluateL1ShBasisWithClampedCosine(float3 DirectionWs)
{
    const float4 ShBasis = VspUtilEvaluateL1ShBasis(DirectionWs);
    const float Pi = 3.14159265358979323846;
    return VspUtilConvolveL1SH(ShBasis, Pi, 2.0 * Pi / 3.0);
}



// IVセルのSH係数が未初期化状態ではないかを判定する。
bool VspUtilIrradianceVolumeHasValidSH(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex)
{
    float4 C0;
    float4 C1;
    float4 C2;
    float4 C3;
    VspUtilLoadIrradianceVolumeL1SHCoefficients(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        C0,
        C1,
        C2,
        C3);
    return any(abs(C0) > 0.0.xxxx) ||
        any(abs(C1) > 0.0.xxxx) ||
        any(abs(C2) > 0.0.xxxx) ||
        any(abs(C3) > 0.0.xxxx);
}

// ロード済みRadiance SHを指定方向のRGB Radianceへ評価する。
float3 VspUtilEvaluateIrradianceVolumeRadianceFromL1SH(
    float4 RadianceR,
    float4 RadianceG,
    float4 RadianceB,
    float3 NormalWs)
{
    const float4 ShBasis = VspUtilEvaluateL1ShBasis(normalize(NormalWs));
    return max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
}

// ロード済みRadiance SHをCos畳み込み済みDiffuse Irradianceへ評価する。
float3 VspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
    float4 RadianceR,
    float4 RadianceG,
    float4 RadianceB,
    float3 NormalWs)
{
    const float4 ShBasis = VspUtilEvaluateL1ShBasisWithClampedCosine(normalize(NormalWs));
    return max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
}

// SkyVisibilityの正規化Cos畳み込みを評価基底へ移したもの。
// 正規化Cos畳み込みを基底側へ移して、IBL可視性評価用基底を返す。
float4 VspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(float3 DirectionWs)
{
    return VspUtilConvolveL1SH(
        VspUtilEvaluateL1ShBasis(DirectionWs),
        1.0,
        2.0 / 3.0);
}

// ロード済みSkyVisibility SHを指定方向の可視性へ評価する。
float VspUtilEvaluateIrradianceVolumeSkyVisibilityFromL1SH(
    float4 SkyVisibility,
    float3 NormalWs)
{
    return saturate(
        dot(SkyVisibility, VspUtilEvaluateL1ShBasis(normalize(NormalWs))));
}

// ロード済みSkyVisibility SHをDiffuse/IBL用可視性へ評価する。
float VspUtilEvaluateIrradianceVolumeSkyVisibilityIblFromL1SH(
    float4 SkyVisibility,
    float3 NormalWs)
{
    return saturate(
        dot(
            SkyVisibility,
            VspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(normalize(NormalWs))));
}

// 指定セルのRadiance SHを直接評価する。
float3 VspUtilEvaluateIrradianceVolumeRadianceAtCell(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    VspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    // 生SHの方向評価。Diffuse IrradianceやLambert BRDFの入力ではなく、
    // デバッグ表示または指定方向の入射Radianceを取得したい場合に使用する。
    return VspUtilEvaluateIrradianceVolumeRadianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
}

// 指定セルの入射Radiance SHをCos畳み込みし、Diffuse Irradianceを評価する。
// 戻り値はPI除算前のE(N) = integral(L * max(N・omega, 0) domega)である。
// Lambert BRDFへの入力ではBRDF側の1/PIを使い、最終Diffuse反射値では利用側でPI除算する。
// 指定セルのRadiance SHからDiffuse Irradianceを評価する。
float3 VspUtilEvaluateIrradianceVolumeDiffuseIrradianceAtCell(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    VspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    return VspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
}

// 指定セルのSkyVisibility SHを指定方向へ評価する。
float VspUtilEvaluateIrradianceVolumeSkyVisibilityAtCell(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    VspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    // 生SHの方向評価。反射方向など、単一方向の可視性を取得する場合に使用する。
    return VspUtilEvaluateIrradianceVolumeSkyVisibilityFromL1SH(
        SkyVisibility,
        NormalWs);
}

// 指定セルのSkyVisibility SHを正規化Cos畳み込みし、Diffuse/IBL可視性を評価する。
// 戻り値は無次元の可視性係数であり、PI除算やRadianceの色補正は行わない。
// 指定セルのSkyVisibility SHからIBL可視性を評価する。
float VspUtilEvaluateIrradianceVolumeSkyVisibilityIblAtCell(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams Params,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    VspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        Params,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    return VspUtilEvaluateIrradianceVolumeSkyVisibilityIblFromL1SH(
        SkyVisibility,
        NormalWs);
}

// ワールド位置からセルを検索し、最近傍セルのRadianceを評価する。
bool VspUtilTryEvaluateIrradianceVolumeRadiance(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutRadiance)
{
    OutRadiance = 0.0.xxx;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_vsp_invalid_probe_index;
    if (!VspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!VspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        GridParams,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutRadiance = VspUtilEvaluateIrradianceVolumeRadianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
    return true;
}

// ワールド位置からセルを検索し、最近傍セルのSkyVisibilityを評価する。
bool VspUtilTryEvaluateIrradianceVolumeSkyVisibility(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_vsp_invalid_probe_index;
    if (!VspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!VspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        GridParams,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutSkyVisibility = VspUtilEvaluateIrradianceVolumeSkyVisibilityFromL1SH(
        SkyVisibility,
        NormalWs);
    return true;
}

// Finest Cascadeの単一セルを参照し、Diffuse Irradianceを評価する。
// 戻り値はCos畳み込み済みのDiffuse Irradianceで、Lambert BRDF側の入力に使用する。
// ワールド位置からセルを検索し、最近傍セルのDiffuse Irradianceを評価する。
bool VspUtilTryEvaluateIrradianceVolumeDiffuseIrradiance(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutDiffuseIrradiance)
{
    OutDiffuseIrradiance = 0.0.xxx;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_vsp_invalid_probe_index;
    if (!VspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!VspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        GridParams,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutDiffuseIrradiance = VspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
    return true;
}

// Finest Cascadeの単一セルを参照し、Diffuse/IBL用のSkyVisibilityを評価する。
// 戻り値は正規化Cos畳み込み済みの無次元可視性係数で、PI除算は不要。
// ワールド位置からセルを検索し、最近傍セルのIBL可視性を評価する。
bool VspUtilTryEvaluateIrradianceVolumeSkyVisibilityIbl(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_vsp_invalid_probe_index;
    if (!VspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!VspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        GridParams,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutSkyVisibility = VspUtilEvaluateIrradianceVolumeSkyVisibilityIblFromL1SH(
        SkyVisibility,
        NormalWs);
    return true;
}

// ワールド位置周辺8セルを補間し、Radianceを評価する。
bool VspUtilTryEvaluateIrradianceVolumeRadianceTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutRadiance)
{
    OutRadiance = 0.0.xxx;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!VspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    VspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        false,
        true,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    const float4 ShBasis = VspUtilEvaluateL1ShBasis(normalize(NormalWs));
    RadianceR = VspUtilDeconvolveL1SHByClampedCosine(RadianceR);
    RadianceG = VspUtilDeconvolveL1SHByClampedCosine(RadianceG);
    RadianceB = VspUtilDeconvolveL1SHByClampedCosine(RadianceB);
    OutRadiance = max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
    return true;
}

// Material用: Finest Cascade内でSH係数をトリリニア補間し、Diffuse IrradianceとIBL SkyVisibilityを同時に評価する。
// 位置からのCascade探索、境界ディザ、法線正規化、4 signalの3D Texture sampleを一度だけ実行する。
// Irradiance RGBは書き込み時にclamped-cosine畳み込み済みであり、SkyVisibilityは生のSHをIBL評価時に正規化clamped-cosine基底で評価する。
bool VspUtilTryEvaluateIrradianceVolumeIndirectLightingTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutDiffuseIrradiance,
    out float OutSkyVisibilityIbl)
{
    OutDiffuseIrradiance = 0.0.xxx;
    OutSkyVisibilityIbl = 0.0;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!VspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 IrradianceR;
    float4 IrradianceG;
    float4 IrradianceB;
    VspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        true,
        true,
        SkyVisibility,
        IrradianceR,
        IrradianceG,
        IrradianceB);

    const float3 NormalizedNormalWs = normalize(NormalWs);
    const float4 ShBasis = VspUtilEvaluateL1ShBasis(NormalizedNormalWs);
    OutDiffuseIrradiance = max(
        0.0.xxx,
        float3(
            dot(IrradianceR, ShBasis),
            dot(IrradianceG, ShBasis),
            dot(IrradianceB, ShBasis)));
    OutSkyVisibilityIbl = saturate(
        dot(SkyVisibility, VspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(NormalizedNormalWs)));
    return true;
}
// ワールド位置周辺8セルを補間し、指定方向のSkyVisibilityを評価する。Cos畳み込み無し.
bool VspUtilTryEvaluateIrradianceVolumeSkyVisibilityTrilinear(
    Texture3D<float4> IrradianceVolumeSH,
    FInstantRdvVspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!VspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    VspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        true,
        false,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    OutSkyVisibility = saturate(
        dot(SkyVisibility, VspUtilEvaluateL1ShBasis(normalize(NormalWs))));
    return true;
}


#endif // INSTANT_RDV_VSP_UTIL_USH
