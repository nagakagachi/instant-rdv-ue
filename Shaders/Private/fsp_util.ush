    if (!FspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutDiffuseIrradiance = FspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
    return true;
}

// Finest Cascadeの単一セルを参照し、Diffuse/IBL用のSkyVisibilityを評価する。
// 戻り値は正規化Cos畳み込み済みの無次元可視性係数で、PI除算は不要。
// ワールド位置からセルを検索し、最近傍セルのIBL可視性を評価する。
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibilityIbl(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_fsp_invalid_probe_index;
    if (!FspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!FspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutSkyVisibility = FspUtilEvaluateIrradianceVolumeSkyVisibilityIblFromL1SH(
        SkyVisibility,
        NormalWs);
    return true;
}

// ワールド位置周辺8セルを補間し、Radianceを評価する。
bool FspUtilTryEvaluateIrradianceVolumeRadianceTrilinear(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    float DitherRangeCells,
    out float3 OutRadiance)
{
    OutRadiance = 0.0.xxx;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        DitherRangeCells,
        false,
        true,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    const float4 ShBasis = FspUtilEvaluateL1ShBasis(normalize(NormalWs));
    OutRadiance = max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
    return true;
}

// Finest Cascade内でSH係数をトリリニア補間し、Diffuse Irradianceを評価する。
// 8セルのRadiance SHを先に補間してからCos畳み込みと法線評価を1回だけ行う。
// ワールド位置周辺8セルを補間し、Diffuse Irradianceを評価する。
bool FspUtilTryEvaluateIrradianceVolumeDiffuseIrradianceTrilinear(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    float DitherRangeCells,
    out float3 OutDiffuseIrradiance)
{
    OutDiffuseIrradiance = 0.0.xxx;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        DitherRangeCells,
        false,
        true,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    const float4 ShBasis =
        FspUtilEvaluateL1ShBasisWithClampedCosine(normalize(NormalWs));
    OutDiffuseIrradiance = max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
    return true;
}

// ワールド位置周辺8セルを補間し、指定方向のSkyVisibilityを評価する。
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibilityTrilinear(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    float DitherRangeCells,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        DitherRangeCells,
        true,
        false,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    OutSkyVisibility = max(
        0.0,
        dot(SkyVisibility, FspUtilEvaluateL1ShBasis(normalize(NormalWs))));
    return true;
}

// Finest Cascade内でSkyVisibility SHをトリリニア補間し、Diffuse/IBL可視性を評価する。
// 8セルのSH係数を先に補間してから正規化Cos畳み込みと法線評価を1回だけ行う。
// ワールド位置周辺8セルを補間し、IBL用SkyVisibilityを評価する。
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibilityIblTrilinear(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    float DitherRangeCells,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    int3 BaseCellCoord;
    float3 CellFraction;
    uint CascadeIndex = 0u;
    if (!FspUtilTryGetFinestCascadeTrilinearCoordinates(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
        IrradianceVolumeSH,
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        BaseCellCoord,
        CellFraction,
        DitherRangeCells,
        true,
        false,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    OutSkyVisibility = max(
        0.0,
        dot(
            SkyVisibility,
            FspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(normalize(NormalWs)))); // Cos畳み込み
    return true;
}

#endif // INSTANT_RDV_FSP_UTIL_USH
