// ファイル名: fsp_util.ush
#ifndef INSTANT_RDV_FSP_UTIL_USH
#define INSTANT_RDV_FSP_UTIL_USH

#include "/InstantRdvShaders/Private/instant_rdv_util.ush"

// 再利用可能なユーティリティへ明示的に渡すFSPグリッド状態。
// シェーダのエントリポイントはUniformParamsから値を設定し、Material CustomNodeは
// FSPシェーダのグローバル変数に依存せず同等の値を渡せる。
struct FInstantRdvFspGridParams
{
    uint GridResolutionX;
    uint GridResolutionY;
    uint GridResolutionZ;
    uint CascadeCount;
    float CellSizeCm;
    float IrradianceCascadeDitherRangeCells;
    float3 GridCenterPositionWs;
    float3 PrevGridCenterPositionWs;
};

// CascadeごとのIVセル数を返す。
uint FspUtilCellCountPerCascade(FInstantRdvFspGridParams Params)
{
    return Params.GridResolutionX * Params.GridResolutionY * Params.GridResolutionZ;
}

// 実際に参照可能なCascade数を上限値内へ正規化する。
uint FspUtilEffectiveCascadeCount(FInstantRdvFspGridParams Params)
{
    return min(Params.CascadeCount, k_irdv_fsp_max_cascade_count);
}

// 全Cascadeを含むIVの総セル数を返す。
uint FspUtilTotalCellCount(FInstantRdvFspGridParams Params)
{
    return FspUtilCellCountPerCascade(Params) *
        max(FspUtilEffectiveCascadeCount(Params), 1u);
}

// Cascade番号と物理セル番号を連続バッファのglobal indexへ変換する。
uint FspUtilEncodeGlobalCellIndex(FInstantRdvFspGridParams Params, uint CascadeIndex, uint LocalCellIndex)
{
    return CascadeIndex * FspUtilCellCountPerCascade(Params) + LocalCellIndex;
}

// global indexをCascade番号とCascade内セル番号へ分解する。
bool FspUtilDecodeGlobalCellIndex(
    FInstantRdvFspGridParams Params,
    uint GlobalCellIndex,
    out uint OutCascadeIndex,
    out uint OutLocalCellIndex)
{
    const uint CellCountPerCascade = FspUtilCellCountPerCascade(Params);
    OutCascadeIndex = 0u;
    OutLocalCellIndex = 0u;
    if (CellCountPerCascade == 0u || GlobalCellIndex >= FspUtilTotalCellCount(Params))
    {
        return false;
    }

    OutCascadeIndex = GlobalCellIndex / CellCountPerCascade;
    OutLocalCellIndex = GlobalCellIndex - OutCascadeIndex * CellCountPerCascade;
    return OutCascadeIndex < FspUtilEffectiveCascadeCount(Params);
}

// Cascade内の線形セル番号を物理XYZ座標へ変換する。
uint3 FspUtilLocalCellIndexToCoord(FInstantRdvFspGridParams Params, uint LocalCellIndex)
{
    const uint Slice = Params.GridResolutionX * Params.GridResolutionY;
    const uint Z = LocalCellIndex / Slice;
    const uint Rem = LocalCellIndex - Z * Slice;
    const uint Y = Rem / Params.GridResolutionX;
    const uint X = Rem - Y * Params.GridResolutionX;
    return uint3(X, Y, Z);
}

// 物理XYZ座標をCascade内の線形セル番号へ変換する。
uint FspUtilPhysicalCellCoordToLocalIndex(FInstantRdvFspGridParams Params, uint3 PhysicalCoord)
{
    return PhysicalCoord.x
        + PhysicalCoord.y * Params.GridResolutionX
        + PhysicalCoord.z * Params.GridResolutionX * Params.GridResolutionY;
}

// Cascade番号に対応するワールドセルサイズをcm単位で返す。
float FspUtilCascadeCellSizeCm(FInstantRdvFspGridParams Params, uint CascadeIndex)
{
    return Params.CellSizeCm * exp2(float(CascadeIndex));
}

// Probe relocationで許容する最大オフセット距離をcm単位で返す。
float FspUtilProbeMaxOffsetDistanceCm(FInstantRdvFspGridParams Params, uint CascadeIndex)
{
    return FspUtilCascadeCellSizeCm(Params, CascadeIndex) * 0.9;
}

// ワールド中心位置をCascadeの量子化セルIDへ変換する。
int3 FspUtilCenterCellIdFromPosition(FInstantRdvFspGridParams Params, uint CascadeIndex, float3 CenterPositionWs)
{
    return int3(floor(CenterPositionWs / max(FspUtilCascadeCellSizeCm(Params, CascadeIndex), 0.001)));
}

// Cascade中心から、物理格納グリッドのtoroidal offsetを求める。
int3 FspUtilToroidalOffset(FInstantRdvFspGridParams Params, uint CascadeIndex, float3 CenterPositionWs)
{
    const int3 Resolution = int3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ);
    const int3 CenterCellId = FspUtilCenterCellIdFromPosition(Params, CascadeIndex, CenterPositionWs);
    return ((CenterCellId % Resolution) + Resolution) % Resolution;
}

// Cascadeグリッドのワールド空間最小座標を返す。
float3 FspUtilCascadeGridMinPositionWs(FInstantRdvFspGridParams Params, uint CascadeIndex)
{
    const float CellSize = FspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const float3 Extent = float3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ) * CellSize;
    return float3(FspUtilCenterCellIdFromPosition(Params, CascadeIndex, Params.GridCenterPositionWs)) * CellSize - Extent * 0.5.xxx;
}

// 論理セル座標をtoroidal物理格納座標へ変換する。
uint3 FspUtilLinearToPhysicalCoord(FInstantRdvFspGridParams Params, int3 LinearCoord, uint CascadeIndex)
{
    return LogicalToPhysicalGridCoord(
        LinearCoord,
        FspUtilToroidalOffset(Params, CascadeIndex, Params.GridCenterPositionWs),
        uint3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ));
}

// toroidal物理格納座標を論理セル座標へ逆変換する。
int3 FspUtilPhysicalToLinearCoord(FInstantRdvFspGridParams Params, uint3 PhysicalCoord, uint CascadeIndex)
{
    return PhysicalToLogicalGridCoord(
        int3(PhysicalCoord),
        FspUtilToroidalOffset(Params, CascadeIndex, Params.GridCenterPositionWs),
        uint3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ));
}

// 物理セル番号に対応するワールド空間セル中心を返す。
float3 FspUtilCalcCellCenterWs(FInstantRdvFspGridParams Params, uint CascadeIndex, uint LocalCellIndex)
{
    const float CellSize = FspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const int3 LinearCoord = FspUtilPhysicalToLinearCoord(
        Params,
        FspUtilLocalCellIndexToCoord(Params, LocalCellIndex),
        CascadeIndex);
    return FspUtilCascadeGridMinPositionWs(Params, CascadeIndex) + (float3(LinearCoord) + 0.5.xxx) * CellSize;
}

// ワールド位置を指定Cascadeのglobalセル番号へ変換する。
bool FspUtilTryGetGlobalCellIndexFromWorldPos(
    FInstantRdvFspGridParams Params,
    float3 WorldPosWs,
    uint CascadeIndex,
    out uint OutGlobalCellIndex)
{
    OutGlobalCellIndex = k_irdv_fsp_invalid_probe_index;
    const float CellSize = FspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const int3 LinearCoord = int3(floor(
        (WorldPosWs - FspUtilCascadeGridMinPositionWs(Params, CascadeIndex)) / max(CellSize, 0.001)));
    if (any(LinearCoord < 0) ||
        LinearCoord.x >= int(Params.GridResolutionX) ||
        LinearCoord.y >= int(Params.GridResolutionY) ||
        LinearCoord.z >= int(Params.GridResolutionZ))
    {
        return false;
    }

    OutGlobalCellIndex = FspUtilEncodeGlobalCellIndex(
        Params,
        CascadeIndex,
        FspUtilPhysicalCellCoordToLocalIndex(Params, FspUtilLinearToPhysicalCoord(Params, LinearCoord, CascadeIndex)));
    return true;
}

// ワールド位置を含む最も細かいCascadeのセルを検索する。
bool FspUtilTryGetFinestCascadeCellFromWorldPos(
    FInstantRdvFspGridParams Params,
    float3 WorldPositionWs,
    out uint OutCascadeIndex,
    out uint OutGlobalCellIndex)
{
    OutCascadeIndex = 0u;
    OutGlobalCellIndex = k_irdv_fsp_invalid_probe_index;

    [unroll]
    for (uint CascadeIndex = 0u;
         CascadeIndex < k_irdv_fsp_max_cascade_count;
         ++CascadeIndex)
    {
        if (CascadeIndex >= FspUtilEffectiveCascadeCount(Params))
        {
            break;
        }
        uint CellIndex = k_irdv_fsp_invalid_probe_index;
        if (FspUtilTryGetGlobalCellIndexFromWorldPos(
            Params,
            WorldPositionWs,
            CascadeIndex,
            CellIndex))
        {
            OutCascadeIndex = CascadeIndex;
            OutGlobalCellIndex = CellIndex;
            return true;
        }
    }

    return false;
}

// ワールド位置をトリリニア補間用の基底セルと補間率へ変換する。
bool FspUtilTryGetTrilinearCellCoordinates(
    FInstantRdvFspGridParams Params,
    float3 WorldPositionWs,
    uint CascadeIndex,
    out int3 OutBaseCellCoord,
    out float3 OutCellFraction)
{
    OutBaseCellCoord = int3(0, 0, 0);
    OutCellFraction = 0.0.xxx;
    if (Params.GridResolutionX == 0u ||
        Params.GridResolutionY == 0u ||
        Params.GridResolutionZ == 0u ||
        CascadeIndex >= FspUtilEffectiveCascadeCount(Params))
    {
        return false;
    }

    const float CellSize = FspUtilCascadeCellSizeCm(Params, CascadeIndex);
    const float3 GridMinPositionWs = FspUtilCascadeGridMinPositionWs(Params, CascadeIndex);
    const float3 GridExtentWs =
        float3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ) * CellSize;
    const float3 PositionInGridWs = WorldPositionWs - GridMinPositionWs;
    if (any(PositionInGridWs < 0.0.xxx) || any(PositionInGridWs > GridExtentWs))
    {
        return false;
    }

    // セル中心を整数座標へ対応させ、端では隣接セルを複製して範囲外アクセスを防ぐ。
    const float3 ContinuousCellCoord = PositionInGridWs / max(CellSize, 0.001) - 0.5.xxx;
    const int3 CellResolution = int3(
        Params.GridResolutionX,
        Params.GridResolutionY,
        Params.GridResolutionZ);
    const int3 MaxBaseCellCoord = max(CellResolution - 2, int3(0, 0, 0));
    const int3 UnclampedBaseCellCoord = int3(floor(ContinuousCellCoord));

    OutBaseCellCoord = clamp(UnclampedBaseCellCoord, 0.xxx, MaxBaseCellCoord);
    OutCellFraction = saturate(ContinuousCellCoord - float3(OutBaseCellCoord));
    return true;
}

// 連続したカメラ位置を中心に、量子化のずれを吸収する1セルの余白を確保する。
// 軸ごとの解像度を保持し、立方体以外のグリッドにも対応する。
float3 FspUtilCascadeSelectionHalfExtentWs(FInstantRdvFspGridParams Params, uint CascadeIndex)
{
    return max(
        float3(Params.GridResolutionX, Params.GridResolutionY, Params.GridResolutionZ) * 0.5 - 1.0,
        0.0.xxx) * FspUtilCascadeCellSizeCm(Params, CascadeIndex);
}

float FspUtilCascadeSelectionBoundaryDistanceWs(
    FInstantRdvFspGridParams Params, float3 WorldPositionWs, uint CascadeIndex)
{
    const float3 DistanceToBoundary = FspUtilCascadeSelectionHalfExtentWs(Params, CascadeIndex)
        - abs(WorldPositionWs - Params.GridCenterPositionWs);
    return min(DistanceToBoundary.x, min(DistanceToBoundary.y, DistanceToBoundary.z));
}

// 連続位置の選択境界から最細Cascadeとトリリニア座標を求める。
bool FspUtilTryGetFinestCascadeTrilinearCoordinates(
    FInstantRdvFspGridParams Params,
    float3 WorldPositionWs,
    out uint OutCascadeIndex,
    out int3 OutBaseCellCoord,
    out float3 OutCellFraction)
{
    OutCascadeIndex = 0u;
    OutBaseCellCoord = int3(0, 0, 0);
    OutCellFraction = 0.0.xxx;

    const uint CascadeCount = FspUtilEffectiveCascadeCount(Params);
    [unroll]
    for (uint CascadeIndex = 0u;
         CascadeIndex < k_irdv_fsp_max_cascade_count;
         ++CascadeIndex)
    {
        if (CascadeIndex >= CascadeCount)
        {
            break;
        }

        // 親のない最終Cascadeは、余白で縮めず実グリッド全域を利用する。
        if (CascadeIndex + 1u < CascadeCount &&
            FspUtilCascadeSelectionBoundaryDistanceWs(Params, WorldPositionWs, CascadeIndex) < 0.0)
        {
            continue;
        }

        if (FspUtilTryGetTrilinearCellCoordinates(
            Params,
            WorldPositionWs,
            CascadeIndex,
            OutBaseCellCoord,
            OutCellFraction))
        {
            OutCascadeIndex = CascadeIndex;
            return true;
        }
    }

    return false;
}

// IVセルとSH係数番号からStructuredBufferの要素アドレスを求める。
uint FspUtilIrradianceVolumeSHAddress(uint CellIndex, uint CoeffIndex)
{
    return CellIndex * k_irdv_fsp_irradiance_volume_sh_float4_count + CoeffIndex;
}

uint2 FspUtilPackHalf4(float4 Value)
{
    return uint2(
        f32tof16(Value.x) | (f32tof16(Value.y) << 16u),
        f32tof16(Value.z) | (f32tof16(Value.w) << 16u));
}

float4 FspUtilUnpackHalf4(uint2 Value)
{
    return float4(
        f16tof32(Value.x & 0xffffu),
        f16tof32(Value.x >> 16u),
        f16tof32(Value.y & 0xffffu),
        f16tof32(Value.y >> 16u));
}

// IVセルの4個のpacked half4係数をFP32へ展開してロードする。
void FspUtilLoadIrradianceVolumeL1SHCoefficients(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    out float4 OutC0,
    out float4 OutC1,
    out float4 OutC2,
    out float4 OutC3)
{
    const uint BaseAddress = FspUtilIrradianceVolumeSHAddress(CellIndex, 0u);
    OutC0 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 0u]);
    OutC1 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 1u]);
    OutC2 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 2u]);
    OutC3 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 3u]);
}

// IVセルの係数をSkyVisibilityとRadiance RGBのSHへ展開する。
void FspUtilLoadIrradianceVolumeL1SH(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    float4 C0;
    float4 C1;
    float4 C2;
    float4 C3;
    FspUtilLoadIrradianceVolumeL1SHCoefficients(
        IrradianceVolumeSH,
        CellIndex,
        C0,
        C1,
        C2,
        C3);

    OutSkyVisibility = float4(
        C0.r,
        C1.r,
        C2.r,
        C3.r);
    OutRadianceR = float4(
        C0.g,
        C1.g,
        C2.g,
        C3.g);
    OutRadianceG = float4(
        C0.b,
        C1.b,
        C2.b,
        C3.b);
    OutRadianceB = float4(
        C0.a,
        C1.a,
        C2.a,
        C3.a);
}

// IVセルのSHをロードし、全係数ゼロでない場合だけ有効を返す。
bool FspUtilTryLoadIrradianceVolumeL1SH(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    float4 C0;
    float4 C1;
    float4 C2;
    float4 C3;
    FspUtilLoadIrradianceVolumeL1SHCoefficients(
        IrradianceVolumeSH,
        CellIndex,
        C0,
        C1,
        C2,
        C3);

    OutSkyVisibility = float4(C0.r, C1.r, C2.r, C3.r);
    OutRadianceR = float4(C0.g, C1.g, C2.g, C3.g);
    OutRadianceG = float4(C0.b, C1.b, C2.b, C3.b);
    OutRadianceB = float4(C0.a, C1.a, C2.a, C3.a);
    return any(abs(C0) > 0.0.xxxx) ||
        any(abs(C1) > 0.0.xxxx) ||
        any(abs(C2) > 0.0.xxxx) ||
        any(abs(C3) > 0.0.xxxx);
}

// 同一Cascade内の8セルからSH係数をトリリニア補間する。
// 不要な成分の加算を避けるため、SkyVisibilityとRadianceのどちらを出力するかを
// 呼び出し側が定数フラグで指定する。
void FspUtilLoadIrradianceVolumeL1SHTrilinear(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    uint CascadeIndex,
    int3 BaseCellCoord,
    float3 CellFraction,
    bool bNeedSkyVisibility,
    bool bNeedRadiance,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    OutSkyVisibility = 0.0.xxxx;
    OutRadianceR = 0.0.xxxx;
    OutRadianceG = 0.0.xxxx;
    OutRadianceB = 0.0.xxxx;

    const uint3 GridResolution = uint3(
        GridParams.GridResolutionX,
        GridParams.GridResolutionY,
        GridParams.GridResolutionZ);
    const int3 ToroidalOffset = FspUtilToroidalOffset(
        GridParams,
        CascadeIndex,
        GridParams.GridCenterPositionWs);
    const uint CascadeCellBase =
        CascadeIndex * FspUtilCellCountPerCascade(GridParams);
    const float3 Weight0 = 1.0.xxx - CellFraction;
    const float3 Weight1 = CellFraction;

    // SHは線形なので、8セルの係数を補間してから1回だけ法線方向へ評価する。
    [unroll]
    for (uint Z = 0u; Z < 2u; ++Z)
    {
        [unroll]
        for (uint Y = 0u; Y < 2u; ++Y)
        {
            [unroll]
            for (uint X = 0u; X < 2u; ++X)
            {
                const float WeightX = (X == 0u) ? Weight0.x : Weight1.x;
                const float WeightY = (Y == 0u) ? Weight0.y : Weight1.y;
                const float WeightZ = (Z == 0u) ? Weight0.z : Weight1.z;
                const float Weight = WeightX * WeightY * WeightZ;

                // Toroidal offset、cascade内のベースアドレス、解像度はループ外で
                // 計算済み。各近傍では座標の折り返しと4回の係数ロードだけを行い、
                // 近傍ごとに同じグリッド状態を再計算しない。
                const uint3 LogicalCellCoord = min(
                    uint3(BaseCellCoord) + uint3(X, Y, Z),
                    GridResolution - 1u);
                const uint3 PhysicalCellCoord = LogicalToPhysicalGridCoord(
                    int3(LogicalCellCoord),
                    ToroidalOffset,
                    GridResolution);
                const uint LocalCellIndex = FlattenGridCoord(
                    PhysicalCellCoord,
                    GridResolution);
                const uint BaseAddress = FspUtilIrradianceVolumeSHAddress(
                    CascadeCellBase + LocalCellIndex,
                    0u);
                const float4 C0 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 0u]);
                const float4 C1 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 1u]);
                const float4 C2 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 2u]);
                const float4 C3 = FspUtilUnpackHalf4(IrradianceVolumeSH[BaseAddress + 3u]);

                if (bNeedSkyVisibility)
                {
                    OutSkyVisibility += float4(C0.r, C1.r, C2.r, C3.r) * Weight;
                }
                if (bNeedRadiance)
                {
                    OutRadianceR += float4(C0.g, C1.g, C2.g, C3.g) * Weight;
                    OutRadianceG += float4(C0.b, C1.b, C2.b, C3.b) * Weight;
                    OutRadianceB += float4(C0.a, C1.a, C2.a, C3.a) * Weight;
                }
            }

        }
    }
}

float FspUtilCascadeDitherNoise(float3 WorldPositionWs)
{
    return frac(sin(dot(WorldPositionWs, float3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// 最細Cascadeの境界付近で、最細Cascadeまたは一つ上のCascadeを確率的に選択する。
// 選択と同じ連続位置の境界を使い、グリッドのスナップによるディザ率の跳躍を防ぐ。
// Dither範囲は最細Cascadeのセル数で指定し、小さいグリッドでは補間帯の重なりを防ぐ。
// 両Cascadeを同時にロードせず、選択された方だけをサンプリングする。
bool FspUtilLoadIrradianceVolumeL1SHCascadeBlended(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    uint FineCascadeIndex,
    int3 FineBaseCellCoord,
    float3 FineCellFraction,
    float DitherRangeCells,
    bool bNeedSkyVisibility,
    bool bNeedRadiance,
    out float4 OutSkyVisibility,
    out float4 OutRadianceR,
    out float4 OutRadianceG,
    out float4 OutRadianceB)
{
    const uint CoarseCascadeIndex = FineCascadeIndex + 1u;
    const float FineCellSize = FspUtilCascadeCellSizeCm(GridParams, FineCascadeIndex);
    const float3 HalfExtent = FspUtilCascadeSelectionHalfExtentWs(GridParams, FineCascadeIndex);
    const float MinHalfExtent = min(HalfExtent.x, min(HalfExtent.y, HalfExtent.z));
    const float DitherWidthWs = min(max(DitherRangeCells, 0.0) * FineCellSize, MinHalfExtent * 0.5);
    const float DistanceToNearestBoundary = FspUtilCascadeSelectionBoundaryDistanceWs(
        GridParams, WorldPositionWs, FineCascadeIndex);
    const float CoarseBlendWeight = 1.0 - saturate(
        DistanceToNearestBoundary / max(DitherWidthWs, 0.001));

    const bool bUseCoarseCascade =
#if IS_MATERIAL_SHADER
        // Scene UB経由で切り替え、既存CustomNodeの引数や補間幅を維持する。
        Scene.InstantRdvParam.FspCascadeDitherInterpolation != 0u &&
#endif
        CoarseCascadeIndex < FspUtilEffectiveCascadeCount(GridParams) &&
        DitherRangeCells > 0.0 &&
        FspUtilCascadeDitherNoise(WorldPositionWs) < CoarseBlendWeight;

    if (bUseCoarseCascade)
    {
        int3 CoarseBaseCellCoord;
        float3 CoarseCellFraction;
        if (FspUtilTryGetTrilinearCellCoordinates(
            GridParams,
            WorldPositionWs,
            CoarseCascadeIndex,
            CoarseBaseCellCoord,
            CoarseCellFraction))
        {
            FspUtilLoadIrradianceVolumeL1SHTrilinear(
                IrradianceVolumeSH,
                GridParams,
                CoarseCascadeIndex,
                CoarseBaseCellCoord,
                CoarseCellFraction,
                bNeedSkyVisibility,
                bNeedRadiance,
                OutSkyVisibility,
                OutRadianceR,
                OutRadianceG,
                OutRadianceB);
            return true;
        }
    }

    FspUtilLoadIrradianceVolumeL1SHTrilinear(
        IrradianceVolumeSH,
        GridParams,
        FineCascadeIndex,
        FineBaseCellCoord,
        FineCellFraction,
        bNeedSkyVisibility,
        bNeedRadiance,
        OutSkyVisibility,
        OutRadianceR,
        OutRadianceG,
        OutRadianceB);
    return true;
}

// 方向ベクトルに対するL1 SH基底(Y00,Y1-1,Y10,Y1+1)を評価する。
float4 FspUtilEvaluateL1ShBasis(float3 DirectionWs)
{
    return float4(
        0.2820947918,
        0.4886025119 * DirectionWs.y,
        0.4886025119 * DirectionWs.z,
        0.4886025119 * DirectionWs.x);
}

// L1 SHへ軸対称カーネルを畳み込む。
// 係数を変更するだけで、RadianceのCos畳み込みとSkyVisibilityの正規化Cos畳み込みを共有する。
// L1 SH係数へ軸対称カーネルのL0/L1スケールを適用する。
float4 FspUtilConvolveL1SH(float4 SHCoefficients, float L0Scale, float L1Scale)
{
    return SHCoefficients * float4(L0Scale, L1Scale, L1Scale, L1Scale);
}

// 入射Radiance SHをLambert積分用のDiffuse Irradiance SHへ変換する。
// 戻り値は E(N) = integral(L(omega) * max(dot(N, omega), 0) domega) の近似値。
// これはLambert BRDFの1/PIを含まない入射Diffuse Irradianceである。
// Lambert BRDFへ渡す場合はBRDF側でPI除算し、最終Diffuse反射値として使う場合は利用側でPI除算する。
// Radiance SHをCos畳み込み済みDiffuse Irradiance SHへ変換する。
float4 FspUtilConvolveL1SHByClampedCosine(float4 RadianceSH)
{
    const float Pi = 3.14159265358979323846;
    return FspUtilConvolveL1SH(RadianceSH, Pi, 2.0 * Pi / 3.0);
}

// SkyVisibility SHを半球平均の可視性係数へ変換する。
// 戻り値は0から1を基本範囲とする無次元のDiffuse/IBL可視性係数で、PI除算は不要。
// SkyVisibility SHを正規化Cos畳み込み済み可視性SHへ変換する。
float4 FspUtilConvolveL1SHByNormalizedClampedCosine(float4 SkyVisibilitySH)
{
    return FspUtilConvolveL1SH(SkyVisibilitySH, 1.0, 2.0 / 3.0);
}

// SH係数ではなく評価基底側へCos畳み込みを移す。
// dot(SH * Kernel, Basis) == dot(SH, Basis * Kernel) なので、
// RGB各チャンネルの係数を個別に畳み込むより、基底を一度だけ計算する方が軽い。
// Cos畳み込みを基底側へ移して、PI除算前のDiffuse Irradiance評価用基底を返す。
float4 FspUtilEvaluateL1ShBasisWithClampedCosine(float3 DirectionWs)
{
    const float4 ShBasis = FspUtilEvaluateL1ShBasis(DirectionWs);
    const float Pi = 3.14159265358979323846;
    return FspUtilConvolveL1SH(ShBasis, Pi, 2.0 * Pi / 3.0);
}

// SkyVisibilityの正規化Cos畳み込みを評価基底へ移したもの。
// 正規化Cos畳み込みを基底側へ移して、IBL可視性評価用基底を返す。
float4 FspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(float3 DirectionWs)
{
    return FspUtilConvolveL1SH(
        FspUtilEvaluateL1ShBasis(DirectionWs),
        1.0,
        2.0 / 3.0);
}

// IVセルのSH係数が未初期化状態ではないかを判定する。
bool FspUtilIrradianceVolumeHasValidSH(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex)
{
    float4 C0;
    float4 C1;
    float4 C2;
    float4 C3;
    FspUtilLoadIrradianceVolumeL1SHCoefficients(
        IrradianceVolumeSH,
        CellIndex,
        C0,
        C1,
        C2,
        C3);
    return any(abs(C0) > 0.0.xxxx) ||
        any(abs(C1) > 0.0.xxxx) ||
        any(abs(C2) > 0.0.xxxx) ||
        any(abs(C3) > 0.0.xxxx);
}

// ロード済みRadiance SHを指定方向のRGB Radianceへ評価する。
float3 FspUtilEvaluateIrradianceVolumeRadianceFromL1SH(
    float4 RadianceR,
    float4 RadianceG,
    float4 RadianceB,
    float3 NormalWs)
{
    const float4 ShBasis = FspUtilEvaluateL1ShBasis(normalize(NormalWs));
    return max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
}

// ロード済みRadiance SHをCos畳み込み済みDiffuse Irradianceへ評価する。
float3 FspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
    float4 RadianceR,
    float4 RadianceG,
    float4 RadianceB,
    float3 NormalWs)
{
    const float4 ShBasis =
        FspUtilEvaluateL1ShBasisWithClampedCosine(normalize(NormalWs));
    return max(
        0.0.xxx,
        float3(
            dot(RadianceR, ShBasis),
            dot(RadianceG, ShBasis),
            dot(RadianceB, ShBasis)));
}

// ロード済みSkyVisibility SHを指定方向の可視性へ評価する。
float FspUtilEvaluateIrradianceVolumeSkyVisibilityFromL1SH(
    float4 SkyVisibility,
    float3 NormalWs)
{
    return max(
        0.0,
        dot(SkyVisibility, FspUtilEvaluateL1ShBasis(normalize(NormalWs))));
}

// ロード済みSkyVisibility SHをDiffuse/IBL用可視性へ評価する。
float FspUtilEvaluateIrradianceVolumeSkyVisibilityIblFromL1SH(
    float4 SkyVisibility,
    float3 NormalWs)
{
    return max(
        0.0,
        dot(
            SkyVisibility,
            FspUtilEvaluateL1ShBasisWithNormalizedClampedCosine(normalize(NormalWs))));
}

// 指定セルのRadiance SHを直接評価する。
float3 FspUtilEvaluateIrradianceVolumeRadianceAtCell(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    // 生SHの方向評価。Diffuse IrradianceやLambert BRDFの入力ではなく、
    // デバッグ表示または指定方向の入射Radianceを取得したい場合に使用する。
    return FspUtilEvaluateIrradianceVolumeRadianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
}

// 指定セルの入射Radiance SHをCos畳み込みし、Diffuse Irradianceを評価する。
// 戻り値はPI除算前のE(N) = integral(L * max(N・omega, 0) domega)である。
// Lambert BRDFへの入力ではBRDF側の1/PIを使い、最終Diffuse反射値では利用側でPI除算する。
// 指定セルのRadiance SHからDiffuse Irradianceを評価する。
float3 FspUtilEvaluateIrradianceVolumeDiffuseIrradianceAtCell(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    return FspUtilEvaluateIrradianceVolumeDiffuseIrradianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
}

// 指定セルのSkyVisibility SHを指定方向へ評価する。
float FspUtilEvaluateIrradianceVolumeSkyVisibilityAtCell(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    // 生SHの方向評価。反射方向など、単一方向の可視性を取得する場合に使用する。
    return FspUtilEvaluateIrradianceVolumeSkyVisibilityFromL1SH(
        SkyVisibility,
        NormalWs);
}

// 指定セルのSkyVisibility SHを正規化Cos畳み込みし、Diffuse/IBL可視性を評価する。
// 戻り値は無次元の可視性係数であり、PI除算やRadianceの色補正は行わない。
// 指定セルのSkyVisibility SHからIBL可視性を評価する。
float FspUtilEvaluateIrradianceVolumeSkyVisibilityIblAtCell(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    uint CellIndex,
    float3 NormalWs)
{
    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    FspUtilLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB);

    return FspUtilEvaluateIrradianceVolumeSkyVisibilityIblFromL1SH(
        SkyVisibility,
        NormalWs);
}

// ワールド位置からセルを検索し、最近傍セルのRadianceを評価する。
bool FspUtilTryEvaluateIrradianceVolumeRadiance(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float3 OutRadiance)
{
    OutRadiance = 0.0.xxx;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_fsp_invalid_probe_index;
    if (!FspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!FspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutRadiance = FspUtilEvaluateIrradianceVolumeRadianceFromL1SH(
        RadianceR,
        RadianceG,
        RadianceB,
        NormalWs);
    return true;
}

// ワールド位置からセルを検索し、最近傍セルのSkyVisibilityを評価する。
bool FspUtilTryEvaluateIrradianceVolumeSkyVisibility(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
    out float OutSkyVisibility)
{
    OutSkyVisibility = 0.0;

    uint CascadeIndex = 0u;
    uint CellIndex = k_irdv_fsp_invalid_probe_index;
    if (!FspUtilTryGetFinestCascadeCellFromWorldPos(
        GridParams,
        WorldPositionWs,
        CascadeIndex,
        CellIndex))
    {
        return false;
    }

    float4 SkyVisibility;
    float4 RadianceR;
    float4 RadianceG;
    float4 RadianceB;
    if (!FspUtilTryLoadIrradianceVolumeL1SH(
        IrradianceVolumeSH,
        CellIndex,
        SkyVisibility,
        RadianceR,
        RadianceG,
        RadianceB))
    {
        return false;
    }

    OutSkyVisibility = FspUtilEvaluateIrradianceVolumeSkyVisibilityFromL1SH(
        SkyVisibility,
        NormalWs);
    return true;
}

// Finest Cascadeの単一セルを参照し、Diffuse Irradianceを評価する。
// 戻り値はCos畳み込み済みのDiffuse Irradianceで、Lambert BRDF側の入力に使用する。
// ワールド位置からセルを検索し、最近傍セルのDiffuse Irradianceを評価する。
bool FspUtilTryEvaluateIrradianceVolumeDiffuseIrradiance(
    StructuredBuffer<uint2> IrradianceVolumeSH,
    FInstantRdvFspGridParams GridParams,
    float3 WorldPositionWs,
    float3 NormalWs,
