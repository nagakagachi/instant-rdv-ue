/*
    instant_rdv_util.ush
*/
#if !defined(INSTANT_RDV_UTIL_USH)
#define INSTANT_RDV_UTIL_USH

#include "instant_rdv_common.ush"

uint FlattenGridCoord(uint3 BrickCoord, uint3 Resolution)
{
    return BrickCoord.x + BrickCoord.y * Resolution.x + BrickCoord.z * Resolution.x * Resolution.y;
}
// ToroidalMapping.
uint3 LogicalToPhysicalGridCoord(int3 LogicalCoord, int3 ToroidalOffset, uint3 Resolution)
{
    int3 Wrapped = LogicalCoord + ToroidalOffset;
    Wrapped.x = ((Wrapped.x % int(Resolution.x)) + int(Resolution.x)) % int(Resolution.x);
    Wrapped.y = ((Wrapped.y % int(Resolution.y)) + int(Resolution.y)) % int(Resolution.y);
    Wrapped.z = ((Wrapped.z % int(Resolution.z)) + int(Resolution.z)) % int(Resolution.z);
    return uint3(Wrapped);
}
// ToroidalMapping.
int3 PhysicalToLogicalGridCoord(int3 PhysicalCoord, int3 ToroidalOffset, uint3 Resolution)
{
    int3 Logical = PhysicalCoord - ToroidalOffset;
    Logical.x = ((Logical.x % int(Resolution.x)) + int(Resolution.x)) % int(Resolution.x);
    Logical.y = ((Logical.y % int(Resolution.y)) + int(Resolution.y)) % int(Resolution.y);
    Logical.z = ((Logical.z % int(Resolution.z)) + int(Resolution.z)) % int(Resolution.z);
    return Logical;
}


uint CalcSubbrickMortonBitIndex(uint3 P)
{
    return ((P.x >> 0u) & 1u) << 0u
         | ((P.y >> 0u) & 1u) << 1u
         | ((P.z >> 0u) & 1u) << 2u
         | ((P.x >> 1u) & 1u) << 3u
         | ((P.y >> 1u) & 1u) << 4u
         | ((P.z >> 1u) & 1u) << 5u;
}

uint CalcFineBitIndex(uint3 FineCoord)
{
    const uint3 SubbrickCoord = FineCoord / 4u;
    const uint3 SubbrickLocal = FineCoord % 4u;
    const uint SubbrickIndex = SubbrickCoord.x + SubbrickCoord.y * 2u + SubbrickCoord.z * 4u;
    return SubbrickIndex * 64u + CalcSubbrickMortonBitIndex(SubbrickLocal);
}

uint3 CalcSubbrickLocalCoordFromMorton(uint MortonBitIndex)
{
    return uint3(
        ((MortonBitIndex >> 0u) & 1u) | (((MortonBitIndex >> 3u) & 1u) << 1u),
        ((MortonBitIndex >> 1u) & 1u) | (((MortonBitIndex >> 4u) & 1u) << 1u),
        ((MortonBitIndex >> 2u) & 1u) | (((MortonBitIndex >> 5u) & 1u) << 1u));
}

uint3 CalcFineCoordFromBitIndex(uint BitIndex)
{
    const uint SubbrickIndex = BitIndex / 64u;
    const uint MortonBitIndex = BitIndex % 64u;
    const uint3 SubbrickCoord = uint3(
        SubbrickIndex & 1u,
        (SubbrickIndex >> 1u) & 1u,
        (SubbrickIndex >> 2u) & 1u);
    return SubbrickCoord * 4u + CalcSubbrickLocalCoordFromMorton(MortonBitIndex);
}

uint BbvBrickDataAddress(uint BrickDataBaseOffset, uint BrickIndex, uint Component)
{
    return BrickDataBaseOffset + BrickIndex * k_irdv_bbv_brick_data_u32_count + Component;
}

uint BbvPackBrickLocalAabbCoord(uint3 LocalCoord)
{
    return (LocalCoord.x & 0x7u)
         | ((LocalCoord.y & 0x7u) << 3u)
         | ((LocalCoord.z & 0x7u) << 6u);
}

uint3 BbvUnpackBrickLocalAabbCoord(uint PackedCoord)
{
    return uint3(
        PackedCoord & 0x7u,
        (PackedCoord >> 3u) & 0x7u,
        (PackedCoord >> 6u) & 0x7u);
}

#endif // INSTANT_RDV_UTIL_USH
