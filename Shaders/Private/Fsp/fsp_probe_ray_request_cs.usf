// ファイル名: fsp_probe_ray_request_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Fsp/fsp_state.ush"

// ActiveProbeごとにOctMap 6x6方向のray requestを生成する。
// Requestは probe index と oct cell index を1wordへpackし、後続のtrace/resolveをcounter-drivenにする。

StructuredBuffer<uint> FspActiveProbeListCurr;
RWStructuredBuffer<uint> RWFspProbeRayRequestBuffer;

uint FspProbePoolElementCount;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ActiveIndex = DispatchThreadId.x;
    const uint ActiveProbeCount = min(FspActiveProbeListCurr[0], FspProbePoolElementCount);
    if (ActiveIndex >= ActiveProbeCount)
    {
        return;
    }

    const uint ProbeIndex = FspActiveProbeListCurr[ActiveIndex + 1u];
    if (ProbeIndex >= FspProbePoolElementCount)
    {
        return;
    }

    [unroll]
    for (uint OctCellIndex = 0u; OctCellIndex < kFspRayCountPerProbe; ++OctCellIndex)
    {
        // Wave内の出力対象をprefix sumで詰め、共有appendカウンタへのAtomicを
        // laneごとの実行から1 Waveあたり1回へ集約する。将来、probe単位または
        // oct cell単位で方向を間引く場合も、ここではemit条件だけを変更すればよい。
        const bool bEmitRequest = ProbeIndex < FspProbePoolElementCount;
        const uint WaveEmitCount = WaveActiveCountBits(bEmitRequest);
        if (WaveEmitCount == 0u)
        {
            continue;
        }

        const uint WaveEmitPrefix = WavePrefixCountBits(bEmitRequest);
        uint WaveBaseIndex = 0u;
        if (WaveIsFirstLane())
        {
            InterlockedAdd(RWFspProbeRayRequestBuffer[0], WaveEmitCount, WaveBaseIndex);
        }
        WaveBaseIndex = WaveReadLaneFirst(WaveBaseIndex);

        if (bEmitRequest)
        {
            const uint RequestIndex = WaveBaseIndex + WaveEmitPrefix;
            RWFspProbeRayRequestBuffer[RequestIndex + 1u] =
                FspPackRayRequestKey(ProbeIndex, OctCellIndex);
        }
    }
}
