// ファイル名: fsp_probe_ray_trace_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Fsp/fsp_state.ush"

// FSPプローブレイのトレースパス。
// RayRequestBufferに積まれたActiveProbeのOctMap方向だけをBBVへtraceする。
// 全cell x 全方向ではなく、ActiveProbe由来のrequest数でdispatchする点がFSPのレイ数削減の要。

StructuredBuffer<uint> FspProbeRayRequestBuffer;
RWStructuredBuffer<uint> RWFspProbeRayResultBuffer;
StructuredBuffer<uint> FspProbePool;
StructuredBuffer<uint> BitmaskBrickVoxel;
StructuredBuffer<uint> BrickData;

uint FspProbePoolElementCount;
uint BbvGridResolutionX;
uint BbvGridResolutionY;
uint BbvGridResolutionZ;
float3 BbvGridMinPositionWs;
float BbvCellSizeCm;
float3 BbvToroidalOffsetCells;
float FspTraceDistanceCm;
uint FrameCount;
uint bUseProbeTraceOffset;

#include "/InstantRdvShaders/Private/bbv_trace_util.ush"

float FspHash01(uint Seed)
{
    // 参照実装はOctMap cell内ジッタで、低解像度OctMapの中心rayが軸/折り返し線へ固定されるのを避けている。
    // UE側も1 cell = 1 rayの構造は維持し、cell内だけを小さく揺らしてDDAの境界固定missを防ぐ。
    Seed ^= Seed >> 16u;
    Seed *= 0x7feb352du;
    Seed ^= Seed >> 15u;
    Seed *= 0x846ca68bu;
    Seed ^= Seed >> 16u;
    return float(Seed & 0x00ffffffu) / 16777216.0;
}

[numthreads(k_irdv_fsp_ray_linear_thread_group_size, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint RequestIndex = DispatchThreadId.x;
    const uint RequestCount = min(FspProbeRayRequestBuffer[0], FspProbePoolElementCount * kFspRayCountPerProbe);
    if (RequestIndex >= RequestCount)
    {
        return;
    }

    const uint PackedKey = FspProbeRayRequestBuffer[RequestIndex + 1u];
    const uint ProbeIndex = FspUnpackRayRequestProbeIndex(PackedKey);
    const uint OctCellIndex = FspUnpackRayRequestOctCellIndex(PackedKey);

    uint HitInfo = 0u;
    bool bEmitResult = false;
    if (ProbeIndex < FspProbePoolElementCount && OctCellIndex < kFspRayCountPerProbe)
    {
        const FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(FspProbePool, ProbeIndex);
        uint CascadeIndex = 0u;
        uint LocalCellIndex = 0u;
        if (Data.OwnerCellIndex != k_irdv_fsp_invalid_probe_index && FspDecodeGlobalCellIndex(Data.OwnerCellIndex, CascadeIndex, LocalCellIndex))
        {
            // PreUpdateで決めた relocation offset が、そのまま実ray trace originになる。
            // offset 計算と trace 側の decode 規約がずれると、debug では非埋まりでも
            // 実際のtraceだけ埋まる/逆になるため、両者は必ず同一距離規約を共有する。
            const float3 ProbeOffset = FspDecodeProbeOffset(Data.ProbeOffsetV3) * FspProbeMaxOffsetDistanceCm(CascadeIndex);
            const float3 ProbeBasePositionWs = FspCalcCellCenterWs(CascadeIndex, LocalCellIndex);
            const float3 ProbePositionWs = ProbeBasePositionWs + ((bUseProbeTraceOffset != 0u) ? ProbeOffset : 0.0.xxx);
            const uint2 OctCellId = uint2(OctCellIndex % k_irdv_fsp_probe_octmap_width, OctCellIndex / k_irdv_fsp_probe_octmap_width);
            const float2 Jitter01 = float2(
                FspHash01(ProbeIndex * 1664525u + OctCellIndex * 1013904223u + FrameCount * 131u),
                FspHash01(ProbeIndex * 22695477u + OctCellIndex * 1103515245u + FrameCount * 73u));
            const float2 OctUv = clamp(
                (float2(OctCellId) + 0.5.xx + (Jitter01 - 0.5.xx)) / float(k_irdv_fsp_probe_octmap_width),
                1.0e-4.xx,
                (1.0 - 1.0e-4).xx);
            const float3 RayDirWs = FspOctDecode(OctUv);

            // BBV側のbitmask/brick dataを参照して、最初に当たったbrickだけをresolveへ渡す。
            // 参照実装の詳細なhit payloadに比べ、現段階ではradiance取得に必要なbrick indexを保持する。
            float HitDistanceCm = -1.0;
            int3 LogicalBrickCoord = int3(-1, -1, -1);
            int3 LogicalFineCoord = int3(-1, -1, -1);
            uint BrickIndex = 0u;
            uint BitIndex = 0u;
            const bool bHit = TraceBbvRayReference(
                BitmaskBrickVoxel,
                BrickData,
                ProbePositionWs,
                RayDirWs,
                FspTraceDistanceCm,
                false,
                uint3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ),
                BbvCellSizeCm,
                BbvGridMinPositionWs,
                int3(BbvToroidalOffsetCells),
                HitDistanceCm,
                LogicalBrickCoord,
                LogicalFineCoord,
                BrickIndex,
                BitIndex);
            HitInfo = bHit ? (BrickIndex + 1u) : 0u;
            bEmitResult = true;
        }
    }

    // 無効なrequestは結果へ追加せず、有効結果だけをWave内でprefix sum圧縮する。
    // そのWaveの出力領域を予約するAtomicは代表laneの1回だけで済ませる。
    const uint WaveEmitCount = WaveActiveCountBits(bEmitResult);
    if (WaveEmitCount == 0u)
    {
        return;
    }

    const uint WaveEmitPrefix = WavePrefixCountBits(bEmitResult);
    uint WaveBaseIndex = 0u;
    if (WaveIsFirstLane())
    {
        InterlockedAdd(RWFspProbeRayResultBuffer[0], WaveEmitCount, WaveBaseIndex);
    }
    WaveBaseIndex = WaveReadLaneFirst(WaveBaseIndex);

    if (bEmitResult)
    {
        // ResultBufferも [0]=count、[1..]=stride付きpayload。
        const uint ResultIndex = WaveBaseIndex + WaveEmitPrefix;
        const uint ResultWordOffset = 1u + ResultIndex * k_irdv_fsp_ray_result_data_stride;
        RWFspProbeRayResultBuffer[ResultWordOffset + 0u] = PackedKey;
        RWFspProbeRayResultBuffer[ResultWordOffset + 1u] = HitInfo;
    }
}
