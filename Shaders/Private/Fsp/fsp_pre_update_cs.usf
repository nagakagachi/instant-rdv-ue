// ファイル名: fsp_pre_update_cs.usf
#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/Fsp/fsp_state.ush"
#include "/InstantRdvShaders/Private/bbv_trace_util.ush"

// 参照InstantRDVのfsp_pre_update_cs相当。
// ScreenSpaceCollectで得たvisible surface cellを処理し、未所有cellにはprobe poolからActiveProbeを割り当てる。
// 既存probeがあるcellはLastSeenFrameだけ更新し、BeginUpdateのstale判定で消えないようにする。

StructuredBuffer<uint> FspVisibleSurfaceList;
RWStructuredBuffer<uint> RWFspActiveProbeListCurr;
RWStructuredBuffer<uint> RWFspProbeFreeStack;
RWStructuredBuffer<uint> RWFspCellProbeIndex;
RWStructuredBuffer<uint> RWFspProbePool;
RWStructuredBuffer<uint4> RWFspProbeAtlas;
StructuredBuffer<uint> BitmaskBrickVoxel;
StructuredBuffer<uint> BrickData;

uint FspProbePoolElementCount;
uint FrameCount;
float3 CameraPositionWs;
uint BbvGridResolutionX;
uint BbvGridResolutionY;
uint BbvGridResolutionZ;
float3 BbvGridMinPositionWs;
float BbvCellSizeCm;
float3 BbvToroidalOffsetCells;

uint FspPopFreeProbeIndex()
{
    [loop]
    for (;;)
    {
        const uint ObservedCount = RWFspProbeFreeStack[0];
        if (ObservedCount == 0u)
        {
            return k_irdv_fsp_invalid_probe_index;
        }

        uint OldValue = 0u;
        InterlockedCompareExchange(RWFspProbeFreeStack[0], ObservedCount, ObservedCount - 1u, OldValue);
        if (OldValue == ObservedCount)
        {
            // CompareExchangeでcount更新に勝ったthreadだけが、このstack slotのprobeを取得できる。
            return RWFspProbeFreeStack[ObservedCount];
        }
    }
}

void FspPushCurrActiveProbeIndex(uint ProbeIndex)
{
    uint ActiveListIndex = 0u;
    InterlockedAdd(RWFspActiveProbeListCurr[0], 1u, ActiveListIndex);
    if (ActiveListIndex < FspProbePoolElementCount)
    {
        RWFspActiveProbeListCurr[ActiveListIndex + 1u] = ProbeIndex;
    }
}

void FspCopyProbeAtlas(uint DstProbeIndex, uint SrcProbeIndex)
{
    [unroll]
    for (uint OctIndex = 0u; OctIndex < kFspRayCountPerProbe; ++OctIndex)
    {
        RWFspProbeAtlas[DstProbeIndex * kFspRayCountPerProbe + OctIndex] =
            RWFspProbeAtlas[SrcProbeIndex * kFspRayCountPerProbe + OctIndex];
    }
}

bool FspTrySeedProbeFromUpperCascade(
    float3 SamplePositionWs,
    uint DstCascadeIndex,
    uint DstProbeIndex)
{
    const uint CascadeCount = FspEffectiveCascadeCount();
    [loop]
    for (uint SrcCascadeIndex = DstCascadeIndex + 1u;
         SrcCascadeIndex < CascadeCount;
         ++SrcCascadeIndex)
    {
        uint SrcGlobalCellIndex = k_irdv_fsp_invalid_probe_index;
        if (!FspTryGetGlobalCellIndexFromWorldPos(
            SamplePositionWs,
            SrcCascadeIndex,
            SrcGlobalCellIndex))
        {
            continue;
        }

        const uint SrcProbeIndex = RWFspCellProbeIndex[SrcGlobalCellIndex];
        if (SrcProbeIndex == k_irdv_fsp_invalid_probe_index ||
            SrcProbeIndex >= FspProbePoolElementCount)
        {
            continue;
        }

        const FInstantRdvFspProbePoolData SrcData =
            FspLoadProbePoolData(RWFspProbePool, SrcProbeIndex);
        if (SrcData.OwnerCellIndex != SrcGlobalCellIndex ||
            SrcData.LastUpdateFrame == 0u)
        {
            continue;
        }

        FspCopyProbeAtlas(DstProbeIndex, SrcProbeIndex);
        return true;
    }

    return false;
}

void FspClearProbeAtlas(uint ProbeIndex)
{
    [unroll]
    for (uint OctIndex = 0u; OctIndex < kFspRayCountPerProbe; ++OctIndex)
    {
        RWFspProbeAtlas[ProbeIndex * kFspRayCountPerProbe + OctIndex] = asuint(0.0.xxxx);
    }
}

float FspHash01(uint Seed)
{
    Seed ^= Seed >> 16u;
    Seed *= 0x7feb352du;
    Seed ^= Seed >> 15u;
    Seed *= 0x846ca68bu;
    Seed ^= Seed >> 16u;
    return float(Seed & 0x00ffffffu) / 16777216.0;
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ListIndex = DispatchThreadId.x;
    const uint VisibleCellCount = min(FspVisibleSurfaceList[0], FspProbePoolElementCount);
    if (ListIndex >= VisibleCellCount)
    {
        return;
    }

    const uint GlobalCellIndex = FspVisibleSurfaceList[ListIndex + 1u];
    if (GlobalCellIndex >= FspTotalCellCount())
    {
        return;
    }

    uint ProbeIndex = RWFspCellProbeIndex[GlobalCellIndex];
    bool bNewProbe = false;
    if (ProbeIndex == k_irdv_fsp_invalid_probe_index)
    {
        ProbeIndex = FspPopFreeProbeIndex();
        if (ProbeIndex == k_irdv_fsp_invalid_probe_index || ProbeIndex >= FspProbePoolElementCount)
        {
            return;
        }

        // ScreenSpaceCollectがセル単位でdedup済みのため、参照実装と同じく直接所有権を確定する。
        RWFspCellProbeIndex[GlobalCellIndex] = ProbeIndex;
        FspPushCurrActiveProbeIndex(ProbeIndex);
        bNewProbe = true;
    }
    else if (ProbeIndex >= FspProbePoolElementCount)
    {
        return;
    }

    uint CascadeIndex = 0u;
    uint LocalCellIndex = 0u;
    if (!FspDecodeGlobalCellIndex(GlobalCellIndex, CascadeIndex, LocalCellIndex))
    {
        return;
    }

    FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(RWFspProbePool, ProbeIndex);
    if (bNewProbe)
    {
        // 新規probeはoffsetと更新時刻を初期化する。
        Data.ProbeOffsetV3 = 0u;
        Data.LastUpdateFrame = 0u;
    }

    const float3 CellCenterWs = FspCalcCellCenterWs(CascadeIndex, LocalCellIndex);
    const float MaxProbeOffsetDistanceCm = FspProbeMaxOffsetDistanceCm(CascadeIndex);
    const uint3 BbvGridResolution = uint3(
        BbvGridResolutionX,
        BbvGridResolutionY,
        BbvGridResolutionZ);
    const int3 BbvToroidalOffset = int3(BbvToroidalOffsetCells);
    const float3 PrevProbeOffset = FspDecodeProbeOffset(Data.ProbeOffsetV3) * MaxProbeOffsetDistanceCm;
    const float3 ToCamera = CameraPositionWs - CellCenterWs;
    const float ToCameraLenSq = dot(ToCamera, ToCamera);
    const bool bHasSurfaceAnchor = (ToCameraLenSq > 1.0e-6);
    float3 ProbeSamplePosWs = CellCenterWs + PrevProbeOffset;
    bool bAcceptedVisibleFirst = false;

    if (bHasSurfaceAnchor)
    {
        // ここがFSP offsetの中核。
        // ActiveProbe は「Depth surfaceを代表するcell」だけでなく、
        // そのcell内のどこをレイトレ始点にするかで結果が大きく変わる。
        // 参照実装はまず surface/view 側へ向かう候補を優先し、
        // BBV non-solid を満たす位置を探してから encode する。
        // これを省くと、斜め床や特定距離の平面で probe が埋まり、
        // self-hit によって周囲入射輝度が壊れる。
        const float3 DirToCamera = ToCamera * rsqrt(ToCameraLenSq);
        const float FrontSamples[6] = {0.95, 0.80, 0.65, 0.50, 0.35, 0.20};
        [unroll]
        for (int SampleIndex = 0; SampleIndex < 6; ++SampleIndex)
        {
            const float3 CandidateWs = CellCenterWs + DirToCamera * (MaxProbeOffsetDistanceCm * FrontSamples[SampleIndex]);
            bool bOccupied = false;
            BbvTryGetProbeOccupancyAtWorldPos(
                BitmaskBrickVoxel,
                BrickData,
                CandidateWs,
                BbvGridMinPositionWs,
                BbvCellSizeCm,
                BbvGridResolution,
                BbvToroidalOffset,
                bOccupied);
            if (!bOccupied)
            {
                ProbeSamplePosWs = CandidateWs;
                bAcceptedVisibleFirst = true;
                break;
            }

        }

        if (!bAcceptedVisibleFirst)
        {
            const float3 SeedCandidateWs = CellCenterWs + clamp(PrevProbeOffset, -MaxProbeOffsetDistanceCm.xxx, MaxProbeOffsetDistanceCm.xxx);
            bool bOccupied = false;
            BbvTryGetProbeOccupancyAtWorldPos(
                BitmaskBrickVoxel,
                BrickData,
                SeedCandidateWs,
                BbvGridMinPositionWs,
                BbvCellSizeCm,
                BbvGridResolution,
                BbvToroidalOffset,
                bOccupied);
            if (!bOccupied)
            {
                ProbeSamplePosWs = SeedCandidateWs;
                bAcceptedVisibleFirst = true;
            }
        }
    }

    if ((!bHasSurfaceAnchor) || (!bAcceptedVisibleFirst))
    {
        // 可視優先候補が失敗した場合も、前回offset方向を活かした再探索と
        // 最後のランダムfallbackで「cell内の non-solid 位置」を確保する。
        // ここまでやることで、静止時の継続性を保ちつつ埋まり probe を減らす。
        bool bFoundNonSolid = false;
        bool bOccupied = false;
        BbvTryGetProbeOccupancyAtWorldPos(
            BitmaskBrickVoxel,
            BrickData,
            ProbeSamplePosWs,
            BbvGridMinPositionWs,
            BbvCellSizeCm,
            BbvGridResolution,
            BbvToroidalOffset,
            bOccupied);
        if (bOccupied)
        {
            const float SeedLenSq = dot(PrevProbeOffset, PrevProbeOffset);
            const float3 PreferredDir = (SeedLenSq > 1.0e-6) ? (PrevProbeOffset * rsqrt(SeedLenSq)) : 0.0.xxx;
            if (any(PreferredDir != 0.0.xxx))
            {
                const float FrontBiasSamples[4] = {0.95, 0.75, 0.55, 0.35};
                [unroll]
                for (int SampleIndex = 0; SampleIndex < 4; ++SampleIndex)
                {
                    ProbeSamplePosWs = CellCenterWs + PreferredDir * (MaxProbeOffsetDistanceCm * FrontBiasSamples[SampleIndex]);
                    bool bCandidateOccupied = false;
                    BbvTryGetProbeOccupancyAtWorldPos(
                        BitmaskBrickVoxel,
                        BrickData,
                        ProbeSamplePosWs,
                        BbvGridMinPositionWs,
                        BbvCellSizeCm,
                        BbvGridResolution,
                        BbvToroidalOffset,
                        bCandidateOccupied);
                    if (!bCandidateOccupied)
                    {
                        bFoundNonSolid = true;
                        break;
                    }
                }
            }

            if (!bFoundNonSolid)
            {
                [unroll]
                for (int RandomIndex = 0; RandomIndex < 4; ++RandomIndex)
                {
                    const uint Seed0 = GlobalCellIndex * 1664525u + uint(RandomIndex + 1) * 1013904223u;
                    const uint Seed1 = Seed0 ^ (GlobalCellIndex * 2246822519u + 3266489917u);
                    const uint Seed2 = Seed0 ^ ((GlobalCellIndex + 1u) * 668265263u + 374761393u);
                    const float3 RandomOffset = float3(
                        FspHash01(Seed0),
                        FspHash01(Seed1),
                        FspHash01(Seed2)) - 0.5.xxx;
                    ProbeSamplePosWs = CellCenterWs + RandomOffset * (FspCascadeCellSizeCm(CascadeIndex) * 0.4);
                    bool bCandidateOccupied = false;
                    BbvTryGetProbeOccupancyAtWorldPos(
                        BitmaskBrickVoxel,
                        BrickData,
                        ProbeSamplePosWs,
                        BbvGridMinPositionWs,
                        BbvCellSizeCm,
                        BbvGridResolution,
                        BbvToroidalOffset,
                        bCandidateOccupied);
                    if (!bCandidateOccupied)
                    {
                        break;
                    }
                }
            }
        }
    }

    if (bNewProbe)
    {
        // 上位Cascadeに安定したAtlasがあれば初期値として利用し、黒い初期フレームを短縮する。
        if (!FspTrySeedProbeFromUpperCascade(
            ProbeSamplePosWs,
            CascadeIndex,
            ProbeIndex))
        {
            FspClearProbeAtlas(ProbeIndex);
        }
    }

    // 保存するのは world 距離そのものではなく、最大移動距離で正規化した offset。
    // これにより cascade cell size が変わっても同じ意味で decode できる。
    const float3 NormalizedProbeOffset = clamp((ProbeSamplePosWs - CellCenterWs) / MaxProbeOffsetDistanceCm, -1.0.xxx, 1.0.xxx);
    Data.ProbeOffsetV3 = FspEncodeProbeOffset(NormalizedProbeOffset);
    Data.OwnerCellIndex = GlobalCellIndex;
    Data.LastSeenFrame = FrameCount;
    Data.Reserved0 = 0u;
    Data.Reserved1 = 0u;
    Data.Reserved2 = 0u;
    Data.Reserved3 = 0u;
    FspStoreProbePoolData(RWFspProbePool, ProbeIndex, Data);
}
