// ファイル名: bbv_depthtest_carving_cs.usf
// ファイル説明: Frustum候補Brickに対してFineVoxel(bitmask bit)単位でDepthTest Carvingを実行する。
// 1thread=1u32 jobに分解し、WaveReadLaneAtで同一Brick座標計算を共有して処理を軽量化する。
// 移植ミス再発防止:
// - Removalは Injection のような固定押し込みオフセットを持たない。
//   ここで独自オフセットを足すと、手前側だけ削る参照判定と一致しなくなる。
// - 判定は bitcell 最近点(外接球)と depth 復元面の前後比較で行い、中心点判定へ戻さない。

#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/instant_rdv_util.ush"

Texture2D<float> SceneDepthTexture;
SamplerState SceneDepthSampler;
StructuredBuffer<uint> FrustumBrickCounter;
StructuredBuffer<uint> FrustumBrickList;
RWStructuredBuffer<uint> RWBbvBuffer;

uint DepthSizeX;
uint DepthSizeY;
uint ViewRectMinX;
uint ViewRectMinY;
uint ViewRectSizeX;
uint ViewRectSizeY;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
float3 BbvToroidalOffsetCells;
float3 BbvGridMinPositionWs;
float CellSizeCm;
float4x4 ViewMatrix;
float4x4 ViewProjectionMatrix;
float4x4 InvViewProjectionMatrix;

bool IsValidDepth(float DeviceDepth)
{
    return (0.0 < DeviceDepth) && (DeviceDepth < 1.0);
}

uint3 DecodeSubbrickMortonBitIndex(uint MortonBitIndex)
{
    uint3 Local;
    Local.x = ((MortonBitIndex >> 0u) & 1u) | (((MortonBitIndex >> 3u) & 1u) << 1u);
    Local.y = ((MortonBitIndex >> 1u) & 1u) | (((MortonBitIndex >> 4u) & 1u) << 1u);
    Local.z = ((MortonBitIndex >> 2u) & 1u) | (((MortonBitIndex >> 5u) & 1u) << 1u);
    return Local;
}

uint3 DecodeFineBitIndex(uint BitIndex)
{
    const uint SubbrickIndex = BitIndex / 64u;
    const uint MortonBitIndex = BitIndex % 64u;
    const uint3 SubbrickCoord = uint3(
        SubbrickIndex & 1u,
        (SubbrickIndex >> 1u) & 1u,
        (SubbrickIndex >> 2u) & 1u);
    const uint3 SubbrickLocal = DecodeSubbrickMortonBitIndex(MortonBitIndex);
    return SubbrickCoord * 4u + SubbrickLocal;
}

float3 ReconstructWorldPos(float2 Uv, float DeviceDepth)
{
    const float2 Ndc = float2(Uv.x * 2.0 - 1.0, (1.0 - Uv.y) * 2.0 - 1.0);
    float4 World = mul(float4(Ndc, DeviceDepth, 1.0), InvViewProjectionMatrix);
    World.xyz /= max(abs(World.w), 1e-6);
    return World.xyz;
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    // 1. Active Brick List を (Brick, U32Offset) ジョブへ展開する。
    const uint ActiveBrickCount = FrustumBrickCounter[0];
	const uint U32PerBrick = k_irdv_bbv_bitmask_u32_count_per_brick;
    const uint TotalU32Jobs = ActiveBrickCount * U32PerBrick;
    if (DispatchThreadId.x >= TotalU32Jobs)
    {
        return;
    }

    const uint BrickListIndex = DispatchThreadId.x / U32PerBrick;
    const uint U32Offset = DispatchThreadId.x - BrickListIndex * U32PerBrick;
    const uint LaneBrickIndex = FrustumBrickList[BrickListIndex];

    // 2. 同一Brick担当laneで座標計算を共有する（Wave最適化）。
    const uint LaneIndex = WaveGetLaneIndex();
    const uint SlotFirstLane = (LaneIndex / U32PerBrick) * U32PerBrick;
    const uint BrickIndex = WaveReadLaneAt(LaneBrickIndex, SlotFirstLane);

    int3 LogicalCoord = int3(0, 0, 0);
    if (LaneIndex == SlotFirstLane)
    {
        const uint SliceStride = GridResolutionX * GridResolutionY;
        const uint PhysicalZ = BrickIndex / SliceStride;
        const uint Rem = BrickIndex - PhysicalZ * SliceStride;
        const uint PhysicalY = Rem / GridResolutionX;
        const uint PhysicalX = Rem - PhysicalY * GridResolutionX;
        LogicalCoord = PhysicalToLogicalGridCoord(uint3(PhysicalX, PhysicalY, PhysicalZ), int3(BbvToroidalOffsetCells + 0.5), uint3(GridResolutionX, GridResolutionY, GridResolutionZ));
    }
    LogicalCoord.x = WaveReadLaneAt(LogicalCoord.x, SlotFirstLane);
    LogicalCoord.y = WaveReadLaneAt(LogicalCoord.y, SlotFirstLane);
    LogicalCoord.z = WaveReadLaneAt(LogicalCoord.z, SlotFirstLane);

    // 3. このlane担当u32ブロックを取り出し、立っているbitのみ走査する。
	const float3 BrickOriginWs = BbvGridMinPositionWs + float3(LogicalCoord) * CellSizeCm;
    const float3 BitCellStepWs = CellSizeCm / max(float(k_irdv_bbv_brick_reso), 1.0);
	const uint WordAddress = BrickIndex * k_irdv_bbv_bitmask_u32_count_per_brick + U32Offset;

    uint BitBlock = RWBbvBuffer[WordAddress];
    if (WaveActiveCountBits(BitBlock != 0u) == 0u)
    {
        return;
    }

    uint RemainMask = BitBlock;
    uint ScanMask = BitBlock;
    [loop]
    while (ScanMask != 0u)
    {
        const uint BitInU32 = firstbitlow(ScanMask);
        const uint BitValue = (1u << BitInU32);
        ScanMask &= (ScanMask - 1u);

        const uint BitIndex = U32Offset * 32u + BitInU32;
        const uint3 BitCellPos = DecodeFineBitIndex(BitIndex);
        const float3 BitCellCenterWs = BrickOriginWs + (float3(BitCellPos) + 0.5) * BitCellStepWs;
        const float3 BitCellCenterVs = mul(float4(BitCellCenterWs, 1.0), ViewMatrix).xyz;
        const float4 BitCellCenterCs = mul(float4(BitCellCenterWs, 1.0), ViewProjectionMatrix);
        if (abs(BitCellCenterCs.w) <= 1e-6)
        {
            continue;
        }

        const float3 Ndc = BitCellCenterCs.xyz / BitCellCenterCs.w;
        if (Ndc.z < 0.0 || Ndc.z > 1.0)
        {
            continue;
        }
        const float2 Uv = float2(Ndc.x * 0.5 + 0.5, -Ndc.y * 0.5 + 0.5);
        if (any(Uv < 0.0) || any(Uv > 1.0))
        {
            continue;
        }

        const uint2 ViewDepthCoord = uint2(
            min(uint(Uv.x * ViewRectSizeX), ViewRectSizeX - 1u),
            min(uint(Uv.y * ViewRectSizeY), ViewRectSizeY - 1u));
        const uint2 DepthCoord = uint2(
            min(ViewRectMinX + ViewDepthCoord.x, DepthSizeX - 1u),
            min(ViewRectMinY + ViewDepthCoord.y, DepthSizeY - 1u));
        const float SurfaceDepth = SceneDepthTexture.Load(int3(DepthCoord, 0));
        if (!IsValidDepth(SurfaceDepth))
        {
            // MainView no-depth は空間側なので除去する。
            RemainMask &= ~BitValue;
            continue;
        }

        const float3 SurfacePosWs = ReconstructWorldPos(Uv, SurfaceDepth);
        const float3 SurfacePosVs = mul(float4(SurfacePosWs, 1.0), ViewMatrix).xyz;
        const float SurfaceViewZ = SurfacePosVs.z;

        // セル中心ではなく外接球のカメラ側最近点で前後判定する。
        const float CenterLenSq = dot(BitCellCenterVs, BitCellCenterVs);
        const float3 CenterDir = (CenterLenSq > 1e-10) ? (BitCellCenterVs * rsqrt(CenterLenSq)) : float3(0.0, 0.0, 1.0);
        const float BitCellSphereRadius = 0.5 * length(BitCellStepWs);
        const float3 BitCellNearestVs = BitCellCenterVs - CenterDir * BitCellSphereRadius;
        const float BitCellNearestViewZ = BitCellNearestVs.z;
        if (BitCellNearestViewZ < SurfaceViewZ)
        {
            RemainMask &= ~BitValue;
        }
    }

    // 4. lane担当u32を書き戻す。
    RWBbvBuffer[WordAddress] = RemainMask;
}
