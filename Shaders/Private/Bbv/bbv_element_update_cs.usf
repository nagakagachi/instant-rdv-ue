#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/instant_rdv_util.ush"

StructuredBuffer<uint> BbvBuffer;
RWStructuredBuffer<uint> RWBitmaskBrickVoxelOptionData;

uint BrickCount;
uint FrameCount;
uint UpdateSkipCount;
uint BrickDataBaseOffset;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint PerFrameCount = max((BrickCount + UpdateSkipCount) / (UpdateSkipCount + 1u), 1u);
    const uint LocalIndex = DispatchThreadId.x;
    if (LocalIndex >= PerFrameCount)
    {
        return;
    }

    const uint StartBrick = FrameCount % (UpdateSkipCount + 1u);
    const uint BrickIndex = StartBrick + LocalIndex * (UpdateSkipCount + 1u);
    if (BrickIndex >= BrickCount)
    {
        return;
    }

	const uint OptionalStart = BrickIndex * k_irdv_bbv_brick_optional_data_u32_count;
    const uint OccupiedVoxelCount = BbvBuffer[BrickDataBaseOffset + BrickIndex * 4u + 0u];
    const uint Denominator = max(k_irdv_bbv_brick_reso * k_irdv_bbv_brick_reso * k_irdv_bbv_brick_reso, 1u);
    const uint OccupancyByte = min((OccupiedVoxelCount * 255u) / Denominator, 255u);
    const uint EncodedOptionalWord = OccupancyByte | (OccupiedVoxelCount << 8u);

    // OptionalData word0 は占有情報、word1-2 はpacked FP16 Material Radianceに使う。
    // ここで全wordを塗るとRadiance Resolve結果を毎フレーム破壊するため、占有情報だけ更新する。
    RWBitmaskBrickVoxelOptionData[OptionalStart + 0u] = EncodedOptionalWord;
}
