// ファイル名: bbv_debug_visualize_ps.usf
#include "/Engine/Private/Common.ush"



Texture2D<float> SceneDepthTexture;
Texture2D SceneColorTexture;
SamplerState PointClampSampler;

StructuredBuffer<uint> BbvBuffer;
uint BrickDataBaseOffset;
StructuredBuffer<uint> BitmaskBrickVoxelOptionData;

float4x4 InvViewProjectionMatrix;
float3 CameraPositionWs;
float SceneColorPreExposure;
float SceneColorBlendRate;
uint bDepthTest;
uint DepthSizeX;
uint DepthSizeY;
uint ViewRectMinX;
uint ViewRectMinY;
uint ViewRectSizeX;
uint ViewRectSizeY;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
float3 BbvToroidalOffsetCells;
float CellSizeCm;
float3 BbvGridMinPositionWs;
float MaxTraceDistanceCm;
float DepthRelationRangeFineCells;
int DebugMode;

#include "/InstantRdvShaders/Private/bbv_trace_util.ush"

float3 HashColor(uint Value)
{
    const uint n = Value * 1664525u + 1013904223u;
    const float r = frac(float((n >>  0) & 255u) / 255.0 + 0.13);
    const float g = frac(float((n >>  8) & 255u) / 255.0 + 0.37);
    const float b = frac(float((n >> 16) & 255u) / 255.0 + 0.73);
    return float3(r, g, b);
}

float3 LoadResolvedRadiance(uint BrickIndex)
{
    const uint OptionalStart = BrickIndex * k_irdv_bbv_brick_optional_data_u32_count;
    return max(InstantRdvUnpackHalf3(uint2(
        BitmaskBrickVoxelOptionData[OptionalStart + 1u],
        BitmaskBrickVoxelOptionData[OptionalStart + 2u])), 0.0.xxx);
}

float3 DisplayRadiance(float3 AbsoluteRadiance)
{
    // 格納値は露出前の絶対輝度。デバッグ表示では白飛びを避けるため簡易圧縮して見せる。
    // 輝度を圧縮表示する場合は、次の式を使用する。
    // return AbsoluteRadiance / (1.0.xxx + AbsoluteRadiance);
    
    // 表示用にPreExposure適用.
	return AbsoluteRadiance * SceneColorPreExposure;
}

uint HashInt3(int3 V)
{
    const uint x = asuint(V.x * 73856093);
    const uint y = asuint(V.y * 19349663);
    const uint z = asuint(V.z * 83492791);
    return x ^ y ^ z;
}

bool IsFineVoxelOccupied(int3 LogicalFineCoord)
{
    const int FineRes = int(k_irdv_bbv_brick_reso);
    const int3 LogicalBrickCoord = LogicalFineCoord / FineRes;
    const int3 LocalFineCoord = LogicalFineCoord - LogicalBrickCoord * FineRes;

    const uint3 PhysicalBrickCoord = LogicalToPhysicalGridCoord(LogicalBrickCoord, int3(BbvToroidalOffsetCells), uint3(GridResolutionX, GridResolutionY, GridResolutionZ));
    const uint BrickIndex = FlattenGridCoord(PhysicalBrickCoord, uint3(GridResolutionX, GridResolutionY, GridResolutionZ));

    const uint3 FineCoord = uint3(LocalFineCoord);
    const uint BitIndex = CalcFineBitIndex(FineCoord);
	const uint WordIndex = BrickIndex * k_irdv_bbv_bitmask_u32_count_per_brick + (BitIndex / 32u);
    const uint WordMask = 1u << (BitIndex & 31u);
    return (BbvBuffer[WordIndex] & WordMask) != 0u;
}

float3 ReconstructRayDirection(float2 Uv)
{
    const float2 ndc = float2(Uv.x * 2.0 - 1.0, (1.0 - Uv.y) * 2.0 - 1.0);
    float4 world0 = mul(float4(ndc, 0.0, 1.0), InvViewProjectionMatrix);
    float4 world1 = mul(float4(ndc, 1.0, 1.0), InvViewProjectionMatrix);
    world0.xyz /= max(abs(world0.w), 1e-6);
    world1.xyz /= max(abs(world1.w), 1e-6);

    // Reverse-Z / non-Reverse-Z の両方で常に前方レイになるよう、
    // カメラから遠い側を far として選ぶ。
    const float d0 = dot(world0.xyz - CameraPositionWs, world0.xyz - CameraPositionWs);
    const float d1 = dot(world1.xyz - CameraPositionWs, world1.xyz - CameraPositionWs);
    const float3 rayNear = (d0 < d1) ? world0.xyz : world1.xyz;
    const float3 rayFar = (d0 < d1) ? world1.xyz : world0.xyz;
    return normalize(rayFar - rayNear);
}

float3 ReconstructWorldPosFromUv(float2 Uv, float DeviceDepth)
{
    const float2 Ndc = float2(Uv.x * 2.0 - 1.0, (1.0 - Uv.y) * 2.0 - 1.0);
    float4 World = mul(float4(Ndc, DeviceDepth, 1.0), InvViewProjectionMatrix);
    World.xyz /= max(abs(World.w), 1e-6);
    return World.xyz;
}

float3 ComposeDebugColor(float3 DebugColor, float3 SceneColor)
{
    return lerp(DebugColor, SceneColor, saturate(SceneColorBlendRate));
}

bool PassSceneDepthTest(float HitDistanceCm, float2 ViewUv, uint2 ScenePixelCoord, float3 RayDirWs)
{
    if (bDepthTest == 0u)
    {
        return true;
    }

    const float SurfaceDepth = SceneDepthTexture.Load(int3(ScenePixelCoord, 0)).r;
    if (!((0.0 < SurfaceDepth) && (SurfaceDepth < 1.0)))
    {
        return true;
    }

    const float3 SurfacePositionWs = ReconstructWorldPosFromUv(ViewUv, SurfaceDepth);
    const float SurfaceDistanceCm = dot(SurfacePositionWs - CameraPositionWs, RayDirWs);
    return HitDistanceCm <= SurfaceDistanceCm;
}

// デバッグ表示用の薄いアダプタ。
// 本体ロジックは bbv_trace_util.ush の TraceBbvRayReference に集約し、
// ここでは可視化モードに合わせて引数を固定するだけにする。
bool TraceBbvVoxelRayReference(
    float3 RayOriginWs,
    float3 RayDirWs,
    float MaxDistanceCm,
    uint3 GridResolution,
    float GridCellSize,
    int3 ToroidalOffset,
    out float OutHitDistanceCm,
    out int3 OutLogicalBrickCoord,
    out int3 OutLogicalFineCoord,
    out uint OutBrickIndex,
    out uint OutBitIndex)
{
    return TraceBbvRayReference(
        BbvBuffer,
        BrickDataBaseOffset,
        RayOriginWs,
        RayDirWs,
        MaxDistanceCm,
        false,
        GridResolution,
        GridCellSize,
        BbvGridMinPositionWs,
        ToroidalOffset,
        OutHitDistanceCm,
        OutLogicalBrickCoord,
        OutLogicalFineCoord,
        OutBrickIndex,
        OutBitIndex);
}

// デバッグ表示用の薄いアダプタ（Brick ヒット専用）。
bool TraceBbvBrickRayReference(
    float3 RayOriginWs,
    float3 RayDirWs,
    float MaxDistanceCm,
    uint3 GridResolution,
    float GridCellSize,
    int3 ToroidalOffset,
    out float OutHitDistanceCm,
    out int3 OutLogicalBrickCoord,
    out uint OutBrickIndex)
{
    int3 DummyFineCoord = int3(-1, -1, -1);
    uint DummyBitIndex = 0u;
	return TraceBbvRayReference(
        BbvBuffer,
        BrickDataBaseOffset,
        RayOriginWs,
        RayDirWs,
        MaxDistanceCm,
        true,
        GridResolution,
        GridCellSize,
        BbvGridMinPositionWs,
        ToroidalOffset,
        OutHitDistanceCm,
        OutLogicalBrickCoord,
        DummyFineCoord,
        OutBrickIndex,
        DummyBitIndex);
}

struct VsOutput
{
    float4 UVAndScreenPos : TEXCOORD0;
    float4 OutPosition : SV_POSITION;
};

struct PsOut
{
    float4 Color : SV_TARGET0;
};

PsOut MainPS(VsOutput Input)
{
    PsOut Output = (PsOut)0;

    // Input.UVAndScreenPos.xy は現在ViewRect内の正規化UV。
    // これを基準に View座標/Scene絶対座標 を両方再構成して使い分ける。
    const float2 ViewUvInput = saturate(Input.UVAndScreenPos.xy);
    const uint2 ViewPixelCoord = uint2(
        min(uint(ViewUvInput.x * ViewRectSizeX), ViewRectSizeX - 1u),
        min(uint(ViewUvInput.y * ViewRectSizeY), ViewRectSizeY - 1u));
    const uint2 ScenePixelCoord = uint2(
        min(ViewRectMinX + ViewPixelCoord.x, DepthSizeX - 1u),
        min(ViewRectMinY + ViewPixelCoord.y, DepthSizeY - 1u));
    const float2 ViewUv = (float2(ViewPixelCoord) + 0.5) / float2(max(ViewRectSizeX, 1u), max(ViewRectSizeY, 1u));
    const float2 RayUv = ViewUv;

    const float4 BaseColor = SceneColorTexture.Load(int3(ScenePixelCoord, 0));

    if (DebugMode == 1)
    {
        const uint FineDimX = GridResolutionX * k_irdv_bbv_brick_reso;
        const uint FineDimY = GridResolutionY * k_irdv_bbv_brick_reso;
        const uint FineDimZ = GridResolutionZ * k_irdv_bbv_brick_reso;

        const uint FineX = min((uint)(ViewUv.x * FineDimX), FineDimX - 1u);
        const uint FineY = min((uint)((1.0 - ViewUv.y) * FineDimY), FineDimY - 1u);

        uint OccupiedZCount = 0u;
        [loop]
        for (uint FineZ = 0u; FineZ < FineDimZ; ++FineZ)
        {
            if (IsFineVoxelOccupied(int3(FineX, FineY, FineZ)))
            {
                OccupiedZCount += 1u;
            }
        }

        const float Occupancy = (FineDimZ > 0u) ? (float(OccupiedZCount) / float(FineDimZ)) : 0.0;
        const float3 Heat = lerp(float3(0.0, 0.02, 0.08), float3(1.0, 0.92, 0.2), saturate(Occupancy));
        Output.Color = float4(ComposeDebugColor(Heat, BaseColor.rgb), BaseColor.a);
        return Output;
    }

    if (DebugMode != 2 && DebugMode != 3 && DebugMode != 4 && DebugMode != 5)
    {
        Output.Color = BaseColor;
        return Output;
    }

    const float3 RayDirWs = ReconstructRayDirection(RayUv);
    const float maxTraceDistanceCm = MaxTraceDistanceCm;
    if (DebugMode == 5)
    {
        const float SurfaceDepth = SceneDepthTexture.Load(int3(ScenePixelCoord, 0)).r;
        if (!((0.0 < SurfaceDepth) && (SurfaceDepth < 1.0)))
        {
            Output.Color = BaseColor;
            return Output;
        }

        const float3 SurfacePositionWs = ReconstructWorldPosFromUv(ViewUv, SurfaceDepth);
        const float SurfaceDistanceCm = dot(SurfacePositionWs - CameraPositionWs, RayDirWs);
        float BbvHitDistanceCm = -1.0;
        int3 DummyLogicalBrickCoord = int3(-1, -1, -1);
        int3 DummyLogicalFineCoord = int3(-1, -1, -1);
        uint DummyBrickIndex = 0u;
        uint DummyBitIndex = 0u;
        const bool bBbvHit = TraceBbvVoxelRayReference(
            CameraPositionWs,
            RayDirWs,
            maxTraceDistanceCm,
            uint3(GridResolutionX, GridResolutionY, GridResolutionZ),
            CellSizeCm,
            int3(BbvToroidalOffsetCells),
            BbvHitDistanceCm,
            DummyLogicalBrickCoord,
            DummyLogicalFineCoord,
            DummyBrickIndex,
            DummyBitIndex);
        if (!bBbvHit || BbvHitDistanceCm < 0.0)
        {
            Output.Color = float4(ComposeDebugColor(float3(0.05, 0.05, 0.05), BaseColor.rgb), BaseColor.a);
            return Output;
        }

        const float FineCellSizeCm = CellSizeCm / max(float(k_irdv_bbv_brick_reso), 1.0);
        const float DeltaFineCells = (BbvHitDistanceCm - SurfaceDistanceCm) / max(FineCellSizeCm, 1e-3);
        const float SignedAmount = saturate(abs(DeltaFineCells) / max(DepthRelationRangeFineCells, 1e-3));
        const float3 NeutralColor = float3(0.01, 0.01, 0.01);
        const float3 FrontColor = float3(1.0, 0.0, 0.0);
        const float3 BehindColor = float3(0.0, 0.18, 1.0);
        // 手前側は差が小さくても検出しやすいよう最低輝度を持たせる。
        const float FrontAmount = 0.35 + 0.65 * SignedAmount;
        const float3 RelationColor = (DeltaFineCells < 0.0)
            ? lerp(NeutralColor, FrontColor, FrontAmount)
            : lerp(NeutralColor, BehindColor, SignedAmount);
        Output.Color = float4(ComposeDebugColor(RelationColor, BaseColor.rgb), BaseColor.a);
        return Output;
    }

    float HitDistanceCm = -1.0;
    int3 HitLogicalBrickCoord = int3(-1, -1, -1);
    int3 HitLogicalFineCoord = int3(-1, -1, -1);
    uint HitBrickIndex = 0u;
    uint HitBitIndex = 0u;
    bool bHit = false;
    // DebugMode 2/3 は同一のコアトレースを共有し、差分は IsBrickMode のみ。
    if (DebugMode == 2)
    {
        bHit = TraceBbvBrickRayReference(
            CameraPositionWs,
            RayDirWs,
            maxTraceDistanceCm,
            uint3(GridResolutionX, GridResolutionY, GridResolutionZ),
            CellSizeCm,
            int3(BbvToroidalOffsetCells),
            HitDistanceCm,
            HitLogicalBrickCoord,
            HitBrickIndex);
    }
    else
    {
        bHit = TraceBbvVoxelRayReference(
            CameraPositionWs,
            RayDirWs,
            maxTraceDistanceCm,
            uint3(GridResolutionX, GridResolutionY, GridResolutionZ),
            CellSizeCm,
            int3(BbvToroidalOffsetCells),
            HitDistanceCm,
            HitLogicalBrickCoord,
            HitLogicalFineCoord,
            HitBrickIndex,
            HitBitIndex);
    }

    if (!bHit)
    {
        Output.Color = BaseColor;
        return Output;
    }

    if (!PassSceneDepthTest(HitDistanceCm, ViewUv, ScenePixelCoord, RayDirWs))
    {
        Output.Color = BaseColor;
        return Output;
    }

    float3 HitColor = float3(0.0, 0.0, 0.0);
    if (DebugMode == 4)
    {
        const float3 Radiance = LoadResolvedRadiance(HitBrickIndex);
        HitColor = DisplayRadiance(Radiance);
		const float DebugRadianceBlendRate = 1.0;
        Output.Color = float4(ComposeDebugColor(HitColor, BaseColor.rgb), BaseColor.a);
        return Output;
    }

    // ハッシュ色は浮動小数ヒット位置ではなく安定した論理座標から生成し、
    // カメラ微小移動時の色点滅を抑制する。
    if (DebugMode == 2)
    {
		const int3 GridOriginBrickCoord = int3(floor(BbvGridMinPositionWs / max(CellSizeCm, 0.001)));
        const int3 WorldBrickCoord = GridOriginBrickCoord + HitLogicalBrickCoord;
        HitColor = HashColor(HashInt3(WorldBrickCoord));
    }
    else
    {
        const float FineCellSizeCm = CellSizeCm / max(float(k_irdv_bbv_brick_reso), 1.0);
		const int3 GridOriginFineCoord = int3(floor(BbvGridMinPositionWs / max(FineCellSizeCm, 0.001)));
        const int3 WorldFineCoord = GridOriginFineCoord + HitLogicalFineCoord;
        HitColor = HashColor(HashInt3(WorldFineCoord));
    }
    Output.Color = float4(ComposeDebugColor(HitColor, BaseColor.rgb), BaseColor.a);
    return Output;
}
