#include "/Engine/Public/Platform.ush"

RWStructuredBuffer<uint> RWBitmaskBrickVoxel;
RWStructuredBuffer<uint> RWBitmaskBrickVoxelOptionData;

uint BrickCount;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
uint BitmaskWordsPerBrick;
int4 GridMoveDeltaCells;
float3 ToroidalOffsetCells;
uint OptionalDataU32Count;

#include "/InstantRdvShaders/Private/InstantRdv/bbv_coord_util.ush"

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint LogicalBrickIndex = DispatchThreadId.x;
    if (LogicalBrickIndex >= BrickCount)
    {
        return;
    }

    const uint SliceStride = GridResolutionX * GridResolutionY;
    const uint LogicalZ = LogicalBrickIndex / SliceStride;
    const uint Rem = LogicalBrickIndex - LogicalZ * SliceStride;
    const uint LogicalY = Rem / GridResolutionX;
    const uint LogicalX = Rem - LogicalY * GridResolutionX;
    const int3 LogicalCoord = int3(LogicalX, LogicalY, LogicalZ);

    // new論理座標が前フレーム内に存在したかを判定するため、
    // old_coord = new_coord + delta で逆写像する（符号を誤ると一方向へ流れ続ける）。
    const int3 PrevLogicalCoord = LogicalCoord + GridMoveDeltaCells.xyz;
    const bool bWasInside =
        (PrevLogicalCoord.x >= 0 && PrevLogicalCoord.x < int(GridResolutionX)) &&
        (PrevLogicalCoord.y >= 0 && PrevLogicalCoord.y < int(GridResolutionY)) &&
        (PrevLogicalCoord.z >= 0 && PrevLogicalCoord.z < int(GridResolutionZ));

    if (bWasInside)
    {
        return;
    }

    const uint3 PhysicalCoord = WrapBrickCoord(LogicalCoord);
    const uint PhysicalBrickIndex = FlattenBrickCoord(PhysicalCoord);
    const uint WordStart = PhysicalBrickIndex * BitmaskWordsPerBrick;
    const uint OptionalStart = PhysicalBrickIndex * OptionalDataU32Count;
    [loop]
    for (uint WordOffset = 0; WordOffset < BitmaskWordsPerBrick; ++WordOffset)
    {
        const uint ElementIndex = WordStart + WordOffset;
        RWBitmaskBrickVoxel[ElementIndex] = 0u;
        if (WordOffset < OptionalDataU32Count)
        {
            RWBitmaskBrickVoxelOptionData[OptionalStart + WordOffset] = 0u;
        }
    }
}
