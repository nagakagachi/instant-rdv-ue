#include "/Engine/Public/Platform.ush"

// フレーム末尾でCurr ActiveProbe listをPrevへコピーする。
// 次フレームのBeginUpdateはPrevを入力にして、stale/toroidal invalidationを行いながら新しいCurrを作る。

StructuredBuffer<uint> FspActiveProbeListCurr;
RWStructuredBuffer<uint> RWFspActiveProbeListPrev;
uint FspProbePoolElementCount;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint Index = DispatchThreadId.x;
    const uint ActiveCount = min(FspActiveProbeListCurr[0], FspProbePoolElementCount);
    if (Index == 0u)
    {
        RWFspActiveProbeListPrev[0] = ActiveCount;
    }

    if (Index >= ActiveCount)
    {
        return;
    }

    RWFspActiveProbeListPrev[Index + 1u] = FspActiveProbeListCurr[Index + 1u];
}
