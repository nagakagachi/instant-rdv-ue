// ファイル名: bbv_depthtest_frustum_cull_cs.usf
// ファイル説明: Removal対象のBrick候補をFrustum内かつ占有あり条件で収集する。
// WavePrefixCountBits で候補を圧縮し、global counterへのatomicを1 wave 1回へ集約する。

#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/InstantRdv/instant_rdv_util.ush"

StructuredBuffer<uint> BitmaskBrickVoxel;
RWStructuredBuffer<uint> RWFrustumBrickCounter;
RWStructuredBuffer<uint> RWFrustumBrickList;

uint BrickCount;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
float3 BbvToroidalOffsetCells;
float3 BbvGridMinPositionWs;
float CellSizeCm;
float4x4 ViewProjectionMatrix;

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    // 1. このlaneが有効候補Brickを持つか判定する。
    bool bHasCandidate = false;
    uint CandidateBrickIndex = 0u;

    if (DispatchThreadId.x < BrickCount)
    {
        const uint BrickIndex = DispatchThreadId.x;
        const uint SliceStride = GridResolutionX * GridResolutionY;
        const uint PhysicalZ = BrickIndex / SliceStride;
        const uint Rem = BrickIndex - PhysicalZ * SliceStride;
        const uint PhysicalY = Rem / GridResolutionX;
        const uint PhysicalX = Rem - PhysicalY * GridResolutionX;
        const uint3 PhysicalCoord = uint3(PhysicalX, PhysicalY, PhysicalZ);
        const int3 LogicalCoord = PhysicalToLogicalGridCoord(PhysicalCoord, int3(BbvToroidalOffsetCells + 0.5), uint3(GridResolutionX, GridResolutionY, GridResolutionZ));

        const float3 BrickCenterWs = BbvGridMinPositionWs + (float3(LogicalCoord) + 0.5) * CellSizeCm;
        const float4 BrickCenterCs = mul(float4(BrickCenterWs, 1.0), ViewProjectionMatrix);
        if (abs(BrickCenterCs.w) > 1e-6)
        {
            const float3 Ndc = BrickCenterCs.xyz / BrickCenterCs.w;
            const bool bInsideFrustum = (abs(Ndc.x) <= 1.0) && (abs(Ndc.y) <= 1.0);
            if (bInsideFrustum)
            {
				const uint WordStart = BrickIndex * k_irdv_bbv_bitmask_u32_count_per_brick;
                uint OccupiedBits = 0u;
                [loop]
				for (uint WordOffset = 0u; WordOffset < k_irdv_bbv_bitmask_u32_count_per_brick; ++WordOffset)
                {
                    OccupiedBits |= BitmaskBrickVoxel[WordStart + WordOffset];
                }
                bHasCandidate = (OccupiedBits != 0u);
                CandidateBrickIndex = BrickIndex;
            }
        }
    }

    // 2. wave内候補をコンパクションし、1 wave 1回のatomicでlist予約する。
    const uint LaneLocalOffset = WavePrefixCountBits(bHasCandidate);
    const uint WaveCandidateCount = WaveActiveCountBits(bHasCandidate);

    uint WaveReservedBegin = 0u;
    if (WaveIsFirstLane() && (WaveCandidateCount != 0u))
    {
        InterlockedAdd(RWFrustumBrickCounter[0], WaveCandidateCount, WaveReservedBegin);
    }
    const uint WaveBaseIndex = WaveReadLaneFirst(WaveReservedBegin);

    if (bHasCandidate)
    {
        const uint WriteIndex = WaveBaseIndex + LaneLocalOffset;
        if (WriteIndex < BrickCount)
        {
            RWFrustumBrickList[WriteIndex] = CandidateBrickIndex;
        }
    }
}
