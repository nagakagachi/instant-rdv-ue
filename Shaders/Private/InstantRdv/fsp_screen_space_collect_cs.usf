// ファイル説明: Frustum Space Probe(FSP) の可視Surface Cell収集パス。
// 参照InstantRDVのsurface mask ownership inject/compact相当をUEのSceneDepth入力に合わせてまとめたもの。
// Depthからworld位置を復元し、そのsurfaceを代表するFSP cellだけをvisible listへ追加する。

#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/InstantRdv/fsp_common.ush"

Texture2D<float> SceneDepthTexture;
RWStructuredBuffer<uint> RWFspCellVisibleMarkTemporalBuffer;
RWStructuredBuffer<uint> RWFspVisibleSurfaceList;

uint DepthSizeX;
uint DepthSizeY;
uint ViewRectMinX;
uint ViewRectMinY;
uint ViewRectSizeX;
uint ViewRectSizeY;
uint FspVisibleSurfaceListCapacity;
float4x4 InvViewProjectionMatrix;

bool IsValidDepth(float DeviceDepth)
{
    return (0.0 < DeviceDepth) && (DeviceDepth < 1.0);
}

float3 ReconstructWorldPos(float2 ViewUv, float DeviceDepth)
{
    const float2 Ndc = float2(ViewUv.x * 2.0 - 1.0, (1.0 - ViewUv.y) * 2.0 - 1.0);
    float4 World = mul(float4(Ndc, DeviceDepth, 1.0), InvViewProjectionMatrix);
    World.xyz /= max(abs(World.w), 1e-6);
    return World.xyz;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= ViewRectSizeX || DispatchThreadId.y >= ViewRectSizeY)
    {
        return;
    }

    const uint2 ScenePixelCoord = uint2(ViewRectMinX + DispatchThreadId.x, ViewRectMinY + DispatchThreadId.y);
    if (ScenePixelCoord.x >= DepthSizeX || ScenePixelCoord.y >= DepthSizeY)
    {
        return;
    }

    const float DeviceDepth = SceneDepthTexture.Load(int3(ScenePixelCoord, 0));
    if (!IsValidDepth(DeviceDepth))
    {
        return;
    }

    const float2 ViewUv = (float2(DispatchThreadId.xy) + 0.5) / float2(max(ViewRectSizeX, 1u), max(ViewRectSizeY, 1u));
    const float3 WorldPos = ReconstructWorldPos(ViewUv, DeviceDepth);

    // FSPは全cellではなく、depth surfaceが属するowner cellだけをActiveProbe候補にする。
    // ここが0になるとLastSeenFrameが更新されず、ActiveProbeはstale threshold後に消える。
    uint2 OwnerCellIndices = k_irdv_fsp_invalid_probe_index.xx;
    const uint OwnerCellCount = FspGetSurfaceOwnerCells(WorldPos, OwnerCellIndices);

    [unroll]
    for (uint OwnerIndex = 0u; OwnerIndex < 2u; ++OwnerIndex)
    {
        if (OwnerIndex >= OwnerCellCount)
        {
            continue;
        }

        const uint CellIndex = OwnerCellIndices[OwnerIndex];
		const uint CellDataStart = CellIndex * k_irdv_fsp_cell_visible_mark_temporal_data_u32_count;
        uint OriginalVisibleFlag = 0u;
        // CellData[0]はこのフレーム内のdedupe flag。C++側で毎フレームclearすることが必須。
		InterlockedCompareExchange(RWFspCellVisibleMarkTemporalBuffer[CellDataStart + 0u], 0u, 1u, OriginalVisibleFlag);
        if (OriginalVisibleFlag == 0u)
        {
            uint WriteIndex = 0u;
            InterlockedAdd(RWFspVisibleSurfaceList[0], 1u, WriteIndex);
            if (WriteIndex < FspVisibleSurfaceListCapacity)
            {
                RWFspVisibleSurfaceList[1u + WriteIndex] = CellIndex;
            }
        }
    }
}
