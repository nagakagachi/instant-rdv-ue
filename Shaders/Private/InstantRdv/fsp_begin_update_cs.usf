#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/InstantRdv/fsp_common.ush"

// 参照InstantRDVのfsp_begin_update_cs相当。
// 前フレームのActiveProbeを走査し、まだ有効なprobeだけをCurrリストへ引き継ぐ。
// 無効化条件は「owner cell不整合」「toroidal移動で物理slotが別world領域になった」「一定期間未観測」。

StructuredBuffer<uint> FspActiveProbeListPrev;
RWStructuredBuffer<uint> RWFspActiveProbeListCurr;
RWStructuredBuffer<uint> RWFspProbeFreeStack;
RWStructuredBuffer<uint> RWFspCellProbeIndex;
RWStructuredBuffer<uint> RWFspProbePool;
RWStructuredBuffer<uint> RWFspVisibleSurfaceList;
RWStructuredBuffer<uint> RWFspProbeRayRequestBuffer;
RWStructuredBuffer<uint> RWFspProbeRayResultBuffer;
RWStructuredBuffer<float4> RWFspIrradianceVolumeSH;

uint FspProbePoolElementCount;
uint FrameCount;

static const uint kFspStaleFrameThreshold = 120u;

// FreeStackは [0]=count, [1..count]=probe index のLIFO。
// GPU上で複数threadがprobeを返却するためatomic addで末尾へ積む。
void FspPushFreeProbeIndex(uint ProbeIndex)
{
    uint OldCount = 0u;
    InterlockedAdd(RWFspProbeFreeStack[0], 1u, OldCount);
    const uint WriteIndex = OldCount + 1u;
    if (WriteIndex <= FspProbePoolElementCount)
    {
        RWFspProbeFreeStack[WriteIndex] = ProbeIndex;
    }
}

void FspPushCurrActiveProbeIndex(uint ProbeIndex)
{
    uint ActiveListIndex = 0u;
    InterlockedAdd(RWFspActiveProbeListCurr[0], 1u, ActiveListIndex);
    if (ActiveListIndex < FspProbePoolElementCount)
    {
        RWFspActiveProbeListCurr[ActiveListIndex + 1u] = ProbeIndex;
    }
}

void FspClearIrradianceVolumeCell(uint CellIndex)
{
    [unroll]
    for (uint CoeffIndex = 0u; CoeffIndex < k_irdv_fsp_irradiance_volume_sh_float4_count; ++CoeffIndex)
    {
        RWFspIrradianceVolumeSH[FspIrradianceVolumeSHAddress(CellIndex, CoeffIndex)] = 0.0.xxxx;
    }
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint Index = DispatchThreadId.x;
    const uint PrevActiveProbeCount = min(FspActiveProbeListPrev[0], FspProbePoolElementCount);
    if (Index >= PrevActiveProbeCount)
    {
        return;
    }

    const uint ProbeIndex = FspActiveProbeListPrev[Index + 1u];
    if (ProbeIndex >= FspProbePoolElementCount)
    {
        return;
    }

    FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(RWFspProbePool, ProbeIndex);
    const uint OwnerCellIndex = Data.OwnerCellIndex;
    bool bInvalidate = OwnerCellIndex == k_irdv_fsp_invalid_probe_index || OwnerCellIndex >= FspTotalCellCount();
    if (!bInvalidate && RWFspCellProbeIndex[OwnerCellIndex] != ProbeIndex)
    {
        bInvalidate = true;
    }
    if (!bInvalidate)
    {
        uint CascadeIndex = 0u;
        uint LocalCellIndex = 0u;
        if (!FspDecodeGlobalCellIndex(OwnerCellIndex, CascadeIndex, LocalCellIndex))
        {
            bInvalidate = true;
        }
        else
        {
            // Toroidal gridが動いた場合、同じ物理local indexが表すworld領域が変わる。
            // 参照実装と同様に「前フレームslotが現在grid範囲外へ押し出されたか」でprobeを破棄する。
            const int3 Resolution = int3(FspGridResolutionX, FspGridResolutionY, FspGridResolutionZ);
            const int3 PhysicalCoord = int3(FspLocalCellIndexToCoord(LocalCellIndex));
            const int3 PrevLinearCoord = ((PhysicalCoord - FspCascadePrevToroidalOffset(CascadeIndex)) % Resolution + Resolution) % Resolution;
            const int3 CurrLinearCoordInPrevSlot = PrevLinearCoord - FspCascadeMoveCellDelta(CascadeIndex);
            bInvalidate = any(CurrLinearCoordInPrevSlot < 0) || any(CurrLinearCoordInPrevSlot >= Resolution);
        }
    }

    const uint FrameAge = FrameCount - Data.LastSeenFrame;
    const bool bStale = (!bInvalidate) && (FrameAge > kFspStaleFrameThreshold);
    if (!bInvalidate && !bStale)
    {
        // 生存probeはCurrリストへコピーされ、後続のray request/SH更新の入力になる。
        FspPushCurrActiveProbeIndex(ProbeIndex);
        return;
    }

    // 破棄時はcell ownershipとIrradianceVolumeを同時に消す。
    // 古いSHを残すとActiveProbeが無いcellに過去のGIが残るため、owner cellだけ明示クリアする。
    if (OwnerCellIndex != k_irdv_fsp_invalid_probe_index && OwnerCellIndex < FspTotalCellCount() && RWFspCellProbeIndex[OwnerCellIndex] == ProbeIndex)
    {
        RWFspCellProbeIndex[OwnerCellIndex] = k_irdv_fsp_invalid_probe_index;
        FspClearIrradianceVolumeCell(OwnerCellIndex);
    }

    Data.OwnerCellIndex = k_irdv_fsp_invalid_probe_index;
    Data.ProbeOffsetV3 = 0u;
    Data.LastUpdateFrame = 0u;
    Data.Reserved0 = 0u;
    Data.Reserved1 = 0u;
    Data.Reserved2 = 0u;
    Data.Reserved3 = 0u;
    FspStoreProbePoolData(RWFspProbePool, ProbeIndex, Data);
    FspPushFreeProbeIndex(ProbeIndex);
}
