#include "/Engine/Public/Platform.ush"

Texture2D<float> SceneDepthTexture;
SamplerState SceneDepthSampler;
RWStructuredBuffer<uint> RWBitmaskBrickVoxel;

uint DepthSizeX;
uint DepthSizeY;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
uint BitmaskWordsPerBrick;
uint BbvPerVoxelResolution;
float3 ToroidalOffsetCells;
float3 GridMinPositionWs;
float CellSizeCm;
float4x4 InvViewProjectionMatrix;

#include "/InstantRdvShaders/Private/InstantRdv/bbv_coord_util.ush"

float3 ReconstructWorldPos(uint2 PixelCoord, float DeviceDepth)
{
    const float2 uv = (float2(PixelCoord) + 0.5) / float2(max(DepthSizeX, 1u), max(DepthSizeY, 1u));
    const float2 ndc = float2(uv.x * 2.0 - 1.0, (1.0 - uv.y) * 2.0 - 1.0);
    float4 world = mul(float4(ndc, DeviceDepth, 1.0), InvViewProjectionMatrix);
    world.xyz /= max(abs(world.w), 1e-6);
    return world.xyz;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (DispatchThreadId.x >= DepthSizeX || DispatchThreadId.y >= DepthSizeY)
    {
        return;
    }

    const float DeviceDepth = SceneDepthTexture.Load(int3(DispatchThreadId.xy, 0));
    if (DeviceDepth >= 1.0f)
    {
        return;
    }

    const float3 WorldPos = ReconstructWorldPos(DispatchThreadId.xy, DeviceDepth);
    const float3 GridPos = (WorldPos - GridMinPositionWs) / max(CellSizeCm, 0.001);
    const int3 LogicalBrickCoord = int3(floor(GridPos));
    if (any(LogicalBrickCoord < 0) || LogicalBrickCoord.x >= int(GridResolutionX) || LogicalBrickCoord.y >= int(GridResolutionY) || LogicalBrickCoord.z >= int(GridResolutionZ))
    {
        return;
    }

    const uint3 BrickCoord = WrapBrickCoord(LogicalBrickCoord);
    const uint BrickIndex = FlattenBrickCoord(BrickCoord);

    const float3 BrickLocal = frac(GridPos);
    const uint3 FineCoord = min(uint3(BrickLocal * BbvPerVoxelResolution), uint3(BbvPerVoxelResolution - 1, BbvPerVoxelResolution - 1, BbvPerVoxelResolution - 1));
    const uint BitIndex = CalcFineBitIndex(FineCoord);
    const uint WordIndex = BrickIndex * BitmaskWordsPerBrick + (BitIndex / 32u);
    const uint WordMask = 1u << (BitIndex & 31u);
    InterlockedOr(RWBitmaskBrickVoxel[WordIndex], WordMask);
}
