// FSP ActiveProbe / IrradianceVolume probe sphere debug rendering.
// 各FSP cellを1インスタンス相当のcamera-facing quadとして描き、pixel shaderで球面に見せる。
// ActiveProbe debugではprobe poolのoffset込み位置、IrradianceVolume debugではcell centerを描画する。

#include "/Engine/Public/Platform.ush"
#include "/InstantRdvShaders/Private/InstantRdv/fsp_common.ush"

float4x4 ViewMatrix;
float4x4 ViewProjectionMatrix;
float3 CameraRightWs;
float3 CameraUpWs;
float3 CameraPositionWs;
float DebugProbeRadiusCm;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;
uint FspProbePoolElementCount;
uint FrameCount;
uint DebugMode;
uint BbvGridResolutionX;
uint BbvGridResolutionY;
uint BbvGridResolutionZ;
float3 BbvToroidalOffsetCells;
float BbvCellSizeCm;
float3 BbvGridMinPositionWs;

StructuredBuffer<uint> FspCellProbeIndex;
StructuredBuffer<uint> FspProbePool;
StructuredBuffer<uint4> FspProbeAtlas;
StructuredBuffer<float4> FspPackedSH;
StructuredBuffer<uint> BitmaskBrickVoxel;
StructuredBuffer<uint> BrickData;

struct VS_OUTPUT
{
    float4 Pos : SV_Position;
    float2 UV : TEXCOORD0;
    float3 ProbePosWs : TEXCOORD1;
    nointerpolation uint GlobalCellIndex : TEXCOORD2;
    nointerpolation uint ProbeIndex : TEXCOORD3;
    nointerpolation uint ProbeFlags : TEXCOORD4;
};

bool FspTryGetActiveProbeForCell(out uint OutProbeIndex, out FInstantRdvFspProbePoolData OutData, uint GlobalCellIndex)
{
    OutProbeIndex = k_irdv_fsp_invalid_probe_index;
    OutData = (FInstantRdvFspProbePoolData)0;
    if (GlobalCellIndex >= FspTotalCellCount())
    {
        return false;
    }

    const uint ProbeIndex = FspCellProbeIndex[GlobalCellIndex];
    if (ProbeIndex == k_irdv_fsp_invalid_probe_index || ProbeIndex >= FspProbePoolElementCount)
    {
        return false;
    }

    // CellProbeIndexだけでは古いownershipが残る可能性があるため、ProbePool側のOwnerCellIndexでも検証する。
    const FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(FspProbePool, ProbeIndex);
    if (Data.OwnerCellIndex != GlobalCellIndex)
    {
        return false;
    }

    OutProbeIndex = ProbeIndex;
    OutData = Data;
    return true;
}

bool BbvTryGetProbeOccupancyAtWorldPos(float3 WorldPos, out bool bOutOccupied)
{
    bOutOccupied = false;

    const float CellSizeCm = max(BbvCellSizeCm, 0.001);
    const float FineCellSizeCm = CellSizeCm / float(k_irdv_bbv_brick_reso);
    const float3 FineCoordF = (WorldPos - BbvGridMinPositionWs) / FineCellSizeCm;
    const int3 LogicalFineCoord = int3(floor(FineCoordF));
    const int3 FineGridResolution = int3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ) * int(k_irdv_bbv_brick_reso);
    if (any(LogicalFineCoord < 0) || any(LogicalFineCoord >= FineGridResolution))
    {
        return false;
    }

    const int FineRes = int(k_irdv_bbv_brick_reso);
    const int3 LogicalBrickCoord = LogicalFineCoord / FineRes;
    const int3 LocalFineCoord = LogicalFineCoord - LogicalBrickCoord * FineRes;
    const uint3 PhysicalBrickCoord = LogicalToPhysicalGridCoord(LogicalBrickCoord, int3(BbvToroidalOffsetCells), uint3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ));
    const uint BrickIndex = FlattenGridCoord(PhysicalBrickCoord, uint3(BbvGridResolutionX, BbvGridResolutionY, BbvGridResolutionZ));

    if (BrickData[BrickIndex * 4u + 0u] == 0u)
    {
        bOutOccupied = false;
        return true;
    }

    const uint BitIndex = CalcFineBitIndex(uint3(LocalFineCoord));
    const uint WordIndex = BrickIndex * k_irdv_bbv_bitmask_u32_count_per_brick + (BitIndex / 32u);
    const uint WordMask = 1u << (BitIndex & 31u);
    bOutOccupied = (BitmaskBrickVoxel[WordIndex] & WordMask) != 0u;
    return true;
}

VS_OUTPUT MainVS(uint VertexId : SV_VertexID)
{
    const float2 QuadPos[6] =
    {
        float2(-1.0, -1.0),
        float2(-1.0,  1.0),
        float2( 1.0,  1.0),
        float2(-1.0, -1.0),
        float2( 1.0,  1.0),
        float2( 1.0, -1.0)
    };
    const float2 QuadUv[6] =
    {
        float2(0.0, 1.0),
        float2(0.0, 0.0),
        float2(1.0, 0.0),
        float2(0.0, 1.0),
        float2(1.0, 0.0),
        float2(1.0, 1.0)
    };

    VS_OUTPUT Out = (VS_OUTPUT)0;
    const uint GlobalCellIndex = VertexId / 6u;
    const uint LocalVertexIndex = VertexId % 6u;

    uint CascadeIndex = 0u;
    uint LocalCellIndex = 0u;
    if (!FspDecodeGlobalCellIndex(GlobalCellIndex, CascadeIndex, LocalCellIndex))
    {
        Out.Pos = 0.0.xxxx;
        Out.ProbeIndex = k_irdv_fsp_invalid_probe_index;
        return Out;
    }

    uint ProbeIndex = k_irdv_fsp_invalid_probe_index;
    FInstantRdvFspProbePoolData ProbeData = (FInstantRdvFspProbePoolData)0;
    const bool bActiveProbe = FspTryGetActiveProbeForCell(ProbeIndex, ProbeData, GlobalCellIndex);
    const bool bIrradianceVolumeDebug = DebugMode == 9u || DebugMode == 10u;
    const bool bHasVolumeSH = FspIrradianceVolumeHasValidSH(FspPackedSH, GlobalCellIndex);
    // FspCalcCellCenterWsはtoroidal物理indexから現在のworld-aligned cell centerへ戻す。
    // ここがずれるとprobe球がカメラ追従に見えるため、更新パスと同じhelperを使う。
    const float3 CellCenterWs = FspCalcCellCenterWs(CascadeIndex, LocalCellIndex);
    const float3 ProbeOffset = bActiveProbe ? FspDecodeProbeOffset(ProbeData.ProbeOffsetV3) * FspCascadeCellSizeCm(CascadeIndex) * 0.45 : 0.0.xxx;
    const float3 ProbePosWs = bIrradianceVolumeDebug ? CellCenterWs : CellCenterWs + ProbeOffset;
    const float DrawScale = ((bIrradianceVolumeDebug && bHasVolumeSH) || ((!bIrradianceVolumeDebug) && bActiveProbe)) ? DebugProbeRadiusCm : 0.0;
    const float2 Corner = QuadPos[LocalVertexIndex];
    const float3 VertexPosWs = ProbePosWs + (CameraRightWs * Corner.x + CameraUpWs * Corner.y) * DrawScale;

    Out.Pos = mul(float4(VertexPosWs, 1.0), ViewProjectionMatrix);
    Out.UV = QuadUv[LocalVertexIndex];
    Out.ProbePosWs = ProbePosWs;
    Out.GlobalCellIndex = GlobalCellIndex;
    Out.ProbeIndex = ProbeIndex;
    Out.ProbeFlags = bActiveProbe ? 1u : 0u;
    return Out;
}

float4 MainPS(VS_OUTPUT Input) : SV_Target0
{
    const float2 UnitDist = (Input.UV - 0.5.xx) * float2(2.0, -2.0);
    const float UnitDistLenSq = dot(UnitDist, UnitDist);
    if (UnitDistLenSq > 1.0)
    {
        discard;
    }

    const bool bIrradianceVolumeDebug = DebugMode == 9u || DebugMode == 10u;
    if ((!bIrradianceVolumeDebug) && Input.ProbeIndex == k_irdv_fsp_invalid_probe_index)
    {
        discard;
    }

    const float3 DirToCamera = normalize(CameraPositionWs - Input.ProbePosWs);
    const float3 QuadSide = normalize(cross(CameraUpWs, -DirToCamera));
    const float3 QuadUp = normalize(cross(-DirToCamera, QuadSide));
    float3 NormalWs = float3(UnitDist.x, UnitDist.y, sqrt(saturate(1.0 - UnitDistLenSq)));
    NormalWs = normalize(NormalWs.x * QuadSide + NormalWs.y * QuadUp + NormalWs.z * DirToCamera);

    const float4 ShBasis = FspEvaluateL1ShBasis(NormalWs);
    const uint CellIndex = Input.GlobalCellIndex;
    // SH bufferは各係数をfloat4(sky, r, g, b)で保持しているため、表示時はcomponentごとに係数ベクトルへ戻す。
    const float4 ShSkyVis = float4(
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 0u)].r,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 1u)].r,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 2u)].r,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 3u)].r);
    const float4 ShRadianceR = float4(
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 0u)].g,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 1u)].g,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 2u)].g,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 3u)].g);
    const float4 ShRadianceG = float4(
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 0u)].b,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 1u)].b,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 2u)].b,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 3u)].b);
    const float4 ShRadianceB = float4(
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 0u)].a,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 1u)].a,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 2u)].a,
        FspPackedSH[FspIrradianceVolumeSHAddress(CellIndex, 3u)].a);

    float4 Color = float4(NormalWs * 0.5 + 0.5, 1.0);
    if (DebugMode == 0u)
    {
        const FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(FspProbePool, Input.ProbeIndex);
        Color = (Data.LastSeenFrame == FrameCount) ? float4(0.2, 1.0, 0.3, 1.0) : float4(1.0, 0.85, 0.2, 1.0);
    }
    else if (DebugMode == 1u)
    {
        const float H = frac(float(Input.ProbeIndex) * 0.61803398875);
        Color = float4(H, frac(H * 1.37), frac(H * 2.11), 1.0);
    }
    else if (DebugMode == 2u)
    {
        const FInstantRdvFspProbePoolData Data = FspLoadProbePoolData(FspProbePool, Input.ProbeIndex);
        const float AgeNorm = saturate(float(FrameCount - Data.LastSeenFrame) / 30.0);
        Color = lerp(float4(0.2, 1.0, 0.3, 1.0), float4(1.0, 0.2, 0.1, 1.0), AgeNorm);
    }
    else if (DebugMode == 3u)
    {
        uint CascadeIndex = 0u;
        uint LocalCellIndex = 0u;
        FspDecodeGlobalCellIndex(CellIndex, CascadeIndex, LocalCellIndex);
        const float H = frac(float(CascadeIndex) * 0.38196601125);
        Color = float4(H, frac(H * 1.71), frac(H * 2.37), 1.0);
    }
    else if (DebugMode == 4u || DebugMode == 5u)
    {
        // OctMap表示は球面normalをoct encodeしてatlas texelを参照する。
        // DebugMode 4=Radiance, 5=SkyVisibility。
        const uint2 OctCellId = min(uint2(FspOctEncode(NormalWs) * float(k_irdv_fsp_probe_octmap_width)), uint2(k_irdv_fsp_probe_octmap_width - 1u, k_irdv_fsp_probe_octmap_width - 1u));
        const float4 Atlas = asfloat(FspProbeAtlas[FspProbeAtlasAddress(Input.ProbeIndex, OctCellId)]);
        if (DebugMode == 4u)
        {
            const float3 Mapped = Atlas.rgb / (1.0.xxx + Atlas.rgb);
            Color = float4(pow(max(Mapped, 0.0.xxx), 1.0 / 2.2), 1.0);
        }
        else
        {
            const float SkyVis = Atlas.a;
            Color = float4(max(float3(SkyVis, SkyVis, SkyVis), float3(0.04, 0.04, 0.04)), 1.0);
        }
    }
    else if (DebugMode == 6u || DebugMode == 9u)
    {
        const float3 Radiance = max(0.0.xxx, float3(dot(ShRadianceR, ShBasis), dot(ShRadianceG, ShBasis), dot(ShRadianceB, ShBasis)));
        const float3 Mapped = Radiance / (1.0.xxx + Radiance);
        Color = float4(pow(Mapped, 1.0 / 2.2), 1.0);
    }
    else if (DebugMode == 8u)
    {
        // Probe ray traceの始点そのものがBBV occupied voxelに埋まっているかを可視化する。
        // 自己ヒット調査では「free / embedded / BBV範囲外」を切り分けることが重要なので、3値で色分けする。
        bool bEmbeddedInBbv = false;
        const bool bInsideBbv = BbvTryGetProbeOccupancyAtWorldPos(Input.ProbePosWs, bEmbeddedInBbv);
        Color = !bInsideBbv
            ? float4(0.2, 0.5, 1.0, 1.0)
            : (bEmbeddedInBbv ? float4(1.0, 0.15, 0.1, 1.0) : float4(0.2, 1.0, 0.3, 1.0));
    }
    else if (DebugMode == 7u || DebugMode == 10u)
    {
        Color = max(0.0, dot(ShSkyVis, ShBasis)).xxxx;
    }

    return Color;
}
