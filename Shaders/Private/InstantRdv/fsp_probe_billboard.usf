// Vertex shader: Probe billboard generated from SV_VertexID
// Each probe uses 6 vertices (2 triangles) — VertexID / 6 = probeIndex, VertexID % 6 = corner

#include "/Engine/Public/Platform.ush"

#include "/InstantRdvShaders/Private/InstantRdv/instant_rdv_util.ush"




// https://github.com/GPUOpen-LibrariesAndSDKs/Capsaicin/blob/914b91596cd119eda85fbc1d3c7ee6ac391b1452/src/core/src/components/random_number_generator/random_number_generator.hlsl
class RandomInstance
{
	uint rngState;

	void initSeed(uint seed)
	{
		rngState = seed;
	}
	
	uint randInt()
	{
        // Using PCG hash function
		uint state = rngState;
		rngState = rngState * 747796405u + 2891336453u;
		uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
		word = (word >> 22u) ^ word;
		return word;
	}
	
	uint randInt(uint max)
	{
		uint ret = randInt() % max; // Has some bias depending on value of max
		return ret;
	}
	
	// range [0,1.0)
	float rand()
	{
        // Note: Use the upper 24 bits to avoid a bias due to floating point rounding error.
        float ret = (float)(randInt() >> 8) * 0x1.0p-24f;
		return ret;
	}	
	// range [0,1.0)
	float2 rand2()
	{
		return float2(rand(), rand());
	}

	// range [0,1.0)
	float3 rand3()
	{
		return float3(rand(), rand(), rand());
	}
	// range [0,1.0)
	float4 rand4()
	{
		return float4(rand(), rand(), rand(), rand());
	}
};








float4x4 ViewProjectionMatrix;
float ViewAcpectRatio;
float3 FspGridMinPositionWs;
float CellSizeCm;
uint GridResolutionX;
uint GridResolutionY;
uint GridResolutionZ;


StructuredBuffer<uint4> FspProbeRadiance;


struct VS_OUTPUT
{
    float4 Pos : SV_Position;
    float2 UV : TEXCOORD0;
    //nointerpolation uint ProbeIndex : TEXCOORD1;
};

// entry
VS_OUTPUT MainVS(uint VertexId : SV_VertexID)
{
    // 6頂点でフルスクリーンクアッド（2トライアングル）
	const float2 pos[6] =
	{
		float2(-1.0, -1.0), // 0
        float2(-1.0, 1.0), // 1
        float2(1.0, 1.0), // 2
        float2(-1.0, -1.0), // 3
        float2(1.0, 1.0), // 4
        float2(1.0, -1.0) // 5
	};

	const float2 uv[6] =
	{
		float2(0.0, 1.0), // 0
        float2(0.0, 0.0), // 1
        float2(1.0, 0.0), // 2
        float2(0.0, 1.0), // 3
        float2(1.0, 0.0), // 4
        float2(1.0, 1.0) // 5
	};
	
	
	VS_OUTPUT o;
	
	
	const uint k_per_instance_prim_count = 2;
	const uint k_per_instance_vtx_count = k_per_instance_prim_count * 3;
	
	const uint global_prim_index = VertexId / 3;
	
	const uint instance_index = global_prim_index / k_per_instance_prim_count;
	const uint local_prim_index = global_prim_index - (instance_index * k_per_instance_prim_count);
	const uint local_prim_vtx_index = VertexId - (instance_index * k_per_instance_vtx_count) - (local_prim_index * 3);
	const uint local_vtx_index = local_prim_vtx_index + (local_prim_index * 3);
	
	
	// 乱数初期化.
	RandomInstance rnd;
	rnd.initSeed(instance_index);


	// ProbeGrid上の位置.
	const int grid_pos_z = instance_index / (GridResolutionX * GridResolutionY);
	const int grid_pos_y = (instance_index - (grid_pos_z * (GridResolutionX * GridResolutionY))) / (GridResolutionX);
	const int grid_pos_x = instance_index % GridResolutionX;
	
	float3 instance_pos_ws = float3(grid_pos_x, grid_pos_y, grid_pos_z) * CellSizeCm + FspGridMinPositionWs;
	
	
	const float k_radius_ws = 10.0;
	
	#if 0
		float3 instance_vtx_pos_ws = instance_pos_ws + (float3(pos[local_vtx_index] * k_radius_ws, 0.0)); // 本当はビルボード風にする.
		float4 instance_pos_cs = mul(float4(instance_vtx_pos_ws, 1.0), ViewProjectionMatrix);
	#else
		float3 instance_vtx_pos_ws = instance_pos_ws;
		float4 instance_pos_cs = mul(float4(instance_vtx_pos_ws, 1.0), ViewProjectionMatrix);
		// ClipSpaceでビルボードの頂点座標に補正する.
	instance_pos_cs.xy += pos[local_vtx_index] * float2(1.0 / ViewAcpectRatio, 1.0) * k_radius_ws; // / instance_pos_cs.z;
	#endif
	
	
	o.Pos = instance_pos_cs;
	o.UV = uv[local_vtx_index];
	
	return o;
}

float4 MainPS(VS_OUTPUT vertex_output) : SV_Target0
{	
	if (0.5 <= length(vertex_output.UV.xy - 0.5))
	{
		discard;
	}	
	return float4(vertex_output.UV.xy, 0.0, 1.0);

}




